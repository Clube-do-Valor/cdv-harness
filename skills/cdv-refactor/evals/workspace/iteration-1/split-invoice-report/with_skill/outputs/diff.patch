@@ -0,0 +1,60 @@
+"""Parsing of CSV invoice lines.
+
+Input columns: customer,item,qty,unit_price,country,reverse_charge
+"""
+import logging
+from decimal import Decimal
+
+from invoicing.tax import InvoiceLine, TAX_RATES
+
+# The month-end check filters the log on this logger name; it must stay the one of the old
+# single module, whatever module the code lives in.
+log = logging.getLogger("invoicing.report")
+
+
+def parse_lines(raw_lines):
+    """Return (lines, skipped): the parsed InvoiceLine objects and the count of rejected lines."""
+    lines = []
+    skipped = 0
+    for number, raw in enumerate(raw_lines, start=1):
+        line, rejected = parse_line(number, raw)
+        if line is not None:
+            lines.append(line)
+        if rejected:
+            skipped += 1
+    return lines, skipped
+
+
+def parse_line(number, raw):
+    """Return (line, rejected). A blank, comment or header line gives (None, False)."""
+    raw = raw.strip()
+    if not raw or raw.startswith("#"):
+        return None, False
+    if raw.lower().startswith("customer,"):
+        return None, False
+    parts = [part.strip() for part in raw.split(",")]
+    if len(parts) != 6:
+        log.warning("skipping malformed line %d: expected 6 fields, got %d", number, len(parts))
+        return None, True
+    customer, item, qty, unit_price, country, reverse_charge = parts
+    try:
+        qty = int(qty)
+        unit_price = Decimal(unit_price)
+    except (ValueError, ArithmeticError):
+        log.warning("skipping malformed line %d: bad number", number)
+        return None, True
+    if qty <= 0:
+        log.warning("skipping line %d: quantity must be positive", number)
+        return None, True
+    country = country.upper()
+    if country not in TAX_RATES:
+        log.info("line %d: unknown country %s, default rate applies", number, country)
+    line = InvoiceLine(
+        customer=customer,
+        item=item,
+        qty=qty,
+        unit_price=unit_price,
+        country=country,
+        reverse_charge=reverse_charge.lower() in ("1", "yes", "true", "y"),
+    )
+    return line, False
