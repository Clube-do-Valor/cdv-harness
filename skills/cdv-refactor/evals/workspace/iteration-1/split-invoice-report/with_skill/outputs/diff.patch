@@ -0,0 +1,43 @@
+"""Pins what other code reaches through `invoicing.report`: names, methods and the logger name."""
+import logging
+import unittest
+from decimal import Decimal
+
+from invoicing import report
+from invoicing.report import InvoiceLine, InvoiceReport
+
+CSV = ["a,widget,2,10.00,DE,no", "a,gadget,10,1.00,xx,no", "b,widget,1,5.00,FR,yes", "bad"]
+
+
+class FacadeTest(unittest.TestCase):
+    def test_names_importable_from_report(self):
+        for name in (
+            "InvoiceReport", "InvoiceLine", "TAX_RATES", "DEFAULT_TAX_RATE", "BULK_QTY",
+            "BULK_DISCOUNT", "REPORT_WIDTH", "_round_half_up", "_money", "log",
+        ):
+            self.assertTrue(hasattr(report, name), name)
+
+    def test_logger_name_is_the_one_the_month_end_check_filters_on(self):
+        self.assertEqual(report.log.name, "invoicing.report")
+        with self.assertLogs("invoicing.report", level="WARNING") as captured:
+            InvoiceReport.from_lines(["bad"])
+        self.assertEqual(len(captured.records), 1)
+
+    def test_public_surface_of_the_report(self):
+        built = InvoiceReport.from_lines(CSV, title="T")
+        self.assertEqual((built.title, built.skipped, len(built.lines)), ("T", 1, 3))
+        self.assertIsInstance(built.lines[0], InvoiceLine)
+        self.assertEqual(list(built.customers()), ["a", "b"])
+        self.assertEqual(InvoiceReport.tax_rate("XX"), report.DEFAULT_TAX_RATE)
+        self.assertEqual(built.tax_for(built.lines[2]), Decimal("0"))
+        self.assertEqual(built.tax_for(built.lines[0]), Decimal("3.80"))
+        totals = built.customer_totals(built.customers()["a"])
+        self.assertEqual(sorted(totals), ["discount", "net", "tax", "total"])
+        self.assertEqual(totals["discount"], Decimal("0.50"))
+        self.assertEqual(built.grand_totals()["net"], Decimal("34.50"))
+        self.assertEqual(built.render_customer("b", built.customers()["b"])[0], "b")
+        self.assertIn("(1 line(s) skipped)", built.render())
+
+
+if __name__ == "__main__":
+    unittest.main()
