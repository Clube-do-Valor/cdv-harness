new file mode 100644
index 0000000..0b4fff6
--- /dev/null
+++ b/invoicing/tax.py
@@ -0,0 +1,75 @@
+"""Tax rates, discounts and totals of invoice lines."""
+from collections import OrderedDict
+from decimal import Decimal, ROUND_HALF_UP
+
+TAX_RATES = {
+    "DE": Decimal("0.19"),
+    "FR": Decimal("0.20"),
+    "NL": Decimal("0.21"),
+    "PT": Decimal("0.23"),
+    "ES": Decimal("0.21"),
+}
+DEFAULT_TAX_RATE = Decimal("0.20")
+BULK_QTY = 10
+BULK_DISCOUNT = Decimal("0.05")
+
+
+def _round_half_up(value):
+    """Round a Decimal to cents, halves away from zero."""
+    return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+class InvoiceLine:
+    def __init__(self, customer, item, qty, unit_price, country, reverse_charge):
+        self.customer = customer
+        self.item = item
+        self.qty = qty
+        self.unit_price = unit_price
+        self.country = country
+        self.reverse_charge = reverse_charge
+
+    @property
+    def gross(self):
+        return self.unit_price * self.qty
+
+    @property
+    def discount(self):
+        if self.qty >= BULK_QTY:
+            return self.gross * BULK_DISCOUNT
+        return Decimal("0")
+
+    @property
+    def net(self):
+        return self.gross - self.discount
+
+
+def tax_rate(country):
+    return TAX_RATES.get(country, DEFAULT_TAX_RATE)
+
+
+def tax_for(line):
+    if line.reverse_charge:
+        return Decimal("0")
+    return line.net * tax_rate(line.country)
+
+
+def group_by_customer(lines):
+    grouped = OrderedDict()
+    for line in lines:
+        grouped.setdefault(line.customer, []).append(line)
+    return grouped
+
+
+def customer_totals(lines):
+    net = sum((line.net for line in lines), Decimal("0"))
+    discount = sum((line.discount for line in lines), Decimal("0"))
+    tax = sum((tax_for(line) for line in lines), Decimal("0"))
+    return {"net": net, "discount": discount, "tax": tax, "total": net + tax}
+
+
+def grand_totals(lines):
+    totals = {"net": Decimal("0"), "discount": Decimal("0"), "tax": Decimal("0"), "total": Decimal("0")}
+    for customer_lines in group_by_customer(lines).values():
+        for key, value in customer_totals(customer_lines).items():
+            totals[key] += value
+    return totals
