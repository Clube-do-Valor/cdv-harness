index 0000000..51af98b
--- /dev/null
+++ b/invoicing/rendering.py
@@ -0,0 +1,46 @@
+"""Plain-text rendering of an invoice report."""
+from invoicing.tax import _round_half_up, customer_totals, grand_totals, group_by_customer
+
+REPORT_WIDTH = 48
+
+
+def _money(value):
+    return f"{_round_half_up(value):,.2f}"
+
+
+def _rule(char="-"):
+    return char * REPORT_WIDTH
+
+
+def _row(label, value):
+    gap = REPORT_WIDTH - len(label) - len(value)
+    return label + " " * max(gap, 1) + value
+
+
+def render_customer(customer, lines):
+    out = [customer]
+    for line in lines:
+        label = f"  {line.qty} x {line.item}"
+        if line.reverse_charge:
+            label += " (RC)"
+        out.append(_row(label, _money(line.net)))
+    totals = customer_totals(lines)
+    if totals["discount"]:
+        out.append(_row("  bulk discount", "-" + _money(totals["discount"])))
+    out.append(_row("  tax", _money(totals["tax"])))
+    out.append(_row("  total", _money(totals["total"])))
+    return out
+
+
+def render_report(title, lines, skipped):
+    out = [_rule("="), title.center(REPORT_WIDTH).rstrip(), _rule("=")]
+    for customer, customer_lines in group_by_customer(lines).items():
+        out.extend(render_customer(customer, customer_lines))
+        out.append(_rule())
+    totals = grand_totals(lines)
+    out.append(_row("NET", _money(totals["net"])))
+    out.append(_row("TAX", _money(totals["tax"])))
+    out.append(_row("TOTAL", _money(totals["total"])))
+    if skipped:
+        out.append(f"({skipped} line(s) skipped)")
+    return "\n".join(out) + "\n"
