index 0000000..ae27c37
--- /dev/null
+++ b/tests/test_modules.py
@@ -0,0 +1,65 @@
+"""Each module of the split is usable on its own."""
+import logging
+import unittest
+from decimal import Decimal
+
+from invoicing.parsing import parse_line, parse_lines
+from invoicing.rendering import money, render_report
+from invoicing.report import InvoiceReport
+from invoicing.tax import InvoiceLine, customer_totals, grand_totals, tax_for
+
+
+def make_line(qty=1, price="100", country="DE", reverse_charge=False, customer="A"):
+    return InvoiceLine(customer, "widget", qty, Decimal(price), country, reverse_charge)
+
+
+class ParsingTest(unittest.TestCase):
+    def test_valid_line(self):
+        line, skipped = parse_line(1, "Acme,widget,2,10.50,de,yes")
+        self.assertFalse(skipped)
+        self.assertEqual((line.customer, line.qty, line.country, line.reverse_charge), ("Acme", 2, "DE", True))
+
+    def test_ignored_lines_are_not_skipped(self):
+        for raw in ("", "# note", "customer,item,qty,unit_price,country,reverse_charge"):
+            self.assertEqual(parse_line(1, raw), (None, False))
+
+    def test_malformed_lines_are_skipped_and_logged_under_report_logger(self):
+        for raw in ("a,b", "a,b,x,1,DE,no", "a,b,0,1,DE,no", "a,b,-1,1,DE,no"):
+            with self.assertLogs("invoicing.report", level="WARNING"):
+                self.assertEqual(parse_line(1, raw), (None, True))
+
+    def test_parse_lines_counts_skipped(self):
+        lines, skipped = parse_lines(["A,w,1,5,DE,no", "bad", "B,w,1,5,FR,no"])
+        self.assertEqual((len(lines), skipped), (2, 1))
+
+
+class TaxTest(unittest.TestCase):
+    def test_bulk_discount_threshold(self):
+        self.assertEqual(make_line(qty=9).discount, Decimal("0"))
+        self.assertEqual(make_line(qty=10).discount, Decimal("50.00"))
+
+    def test_reverse_charge_has_no_tax(self):
+        self.assertEqual(tax_for(make_line(reverse_charge=True)), Decimal("0"))
+        self.assertEqual(tax_for(make_line()), Decimal("19.00"))
+
+    def test_unknown_country_uses_default_rate(self):
+        self.assertEqual(tax_for(make_line(country="XX")), Decimal("20.00"))
+
+    def test_totals(self):
+        lines = [make_line(customer="A"), make_line(customer="B", country="FR")]
+        self.assertEqual(customer_totals(lines[:1])["total"], Decimal("119.00"))
+        self.assertEqual(grand_totals(lines)["total"], Decimal("239.00"))
+
+
+class RenderingTest(unittest.TestCase):
+    def test_money_rounds_half_up_with_separator(self):
+        self.assertEqual(money(Decimal("1234.565")), "1,234.57")
+
+    def test_render_matches_facade(self):
+        report = InvoiceReport.from_lines(["A,w,1,5,DE,no", "bad"])
+        self.assertEqual(render_report(report.title, report.lines, report.skipped), report.render())
+        self.assertIn("(1 line(s) skipped)", report.render())
+
+
+if __name__ == "__main__":
+    unittest.main()
