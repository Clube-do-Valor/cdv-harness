+"""Parsing of the CSV input into invoice lines.
+
+Input columns: customer,item,qty,unit_price,country,reverse_charge
+"""
+import logging
+from decimal import Decimal
+
+from invoicing.tax import TAX_RATES, InvoiceLine
+
+# The month-end check filters the log on the logger name "invoicing.report", so
+# the name is pinned here and must not follow this module's __name__.
+log = logging.getLogger("invoicing.report")
+
+
+def parse_line(number, raw):
+    """Parse one raw line into (line, skipped).
+
+    line is None for blank, comment and header lines
+    (skipped False) and for malformed lines (skipped True).
+    """
+    raw = raw.strip()
+    if not raw or raw.startswith("#"):
+        return None, False
+    if raw.lower().startswith("customer,"):
+        return None, False
+    parts = [part.strip() for part in raw.split(",")]
+    if len(parts) != 6:
+        log.warning("skipping malformed line %d: expected 6 fields, got %d", number, len(parts))
+        return None, True
+    customer, item, qty, unit_price, country, reverse_charge = parts
+    try:
+        qty = int(qty)
+        unit_price = Decimal(unit_price)
+    except (ValueError, ArithmeticError):
+        log.warning("skipping malformed line %d: bad number", number)
+        return None, True
+    if qty <= 0:
+        log.warning("skipping line %d: quantity must be positive", number)
+        return None, True
+    country = country.upper()
+    if country not in TAX_RATES:
+        log.info("line %d: unknown country %s, default rate applies", number, country)
+    line = InvoiceLine(
+        customer=customer,
+        item=item,
+        qty=qty,
+        unit_price=unit_price,
+        country=country,
+        reverse_charge=reverse_charge.lower() in ("1", "yes", "true", "y"),
+    )
+    return line, False
+
+
+def parse_lines(raw_lines):
+    """Parse raw CSV lines; return (lines, skipped_count)."""
+    lines = []
+    skipped = 0
+    for number, raw in enumerate(raw_lines, start=1):
+        line, was_skipped = parse_line(number, raw)
+        if line is not None:
+            lines.append(line)
+        if was_skipped:
+            skipped += 1
+    return lines, skipped
diff --git a/invoicing/rendering.py b/invoicing/rendering.py
new file mode 100644
index 0000000..8b013e1
--- /dev/null
+++ b/invoicing/rendering.py
@@ -0,0 +1,46 @@
+"""Plain-text rendering of the report."""
+from invoicing.tax import customer_totals, grand_totals, group_by_customer, round_half_up
+
+REPORT_WIDTH = 48
+
+
+def money(value):
+    return f"{round_half_up(value):,.2f}"
+
+
+def rule(char="-"):
+    return char * REPORT_WIDTH
+
+
+def row(label, value):
+    gap = REPORT_WIDTH - len(label) - len(value)
+    return label + " " * max(gap, 1) + value
+
+
+def render_customer(customer, lines):
+    out = [customer]
+    for line in lines:
+        label = f"  {line.qty} x {line.item}"
+        if line.reverse_charge:
+            label += " (RC)"
+        out.append(row(label, money(line.net)))
+    totals = customer_totals(lines)
+    if totals["discount"]:
+        out.append(row("  bulk discount", "-" + money(totals["discount"])))
+    out.append(row("  tax", money(totals["tax"])))
+    out.append(row("  total", money(totals["total"])))
+    return out
+
+
+def render_report(title, lines, skipped):
+    out = [rule("="), title.center(REPORT_WIDTH).rstrip(), rule("=")]
+    for customer, customer_lines in group_by_customer(lines).items():
+        out.extend(render_customer(customer, customer_lines))
+        out.append(rule())
+    totals = grand_totals(lines)
+    out.append(row("NET", money(totals["net"])))
+    out.append(row("TAX", money(totals["tax"])))
+    out.append(row("TOTAL", money(totals["total"])))
+    if skipped:
+        out.append(f"({skipped} line(s) skipped)")
+    return "\n".join(out) + "\n"
