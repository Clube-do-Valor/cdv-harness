diff --git a/test/slug.test.js b/test/slug.test.js
new file mode 100644
index 0000000..dfa725d
--- /dev/null
+++ b/test/slug.test.js
@@ -0,0 +1,10 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert');
+const { toSlug } = require('../src/text/slug');
+
+test('lower case and dashes', () => assert.strictEqual(toSlug('Hello World'), 'hello-world'));
+test('accents are removed', () => assert.strictEqual(toSlug('Crème Brûlée'), 'creme-brulee'));
+test('ampersand becomes and', () => assert.strictEqual(toSlug('Salt & Pepper'), 'salt-and-pepper'));
+test('edges are trimmed', () => assert.strictEqual(toSlug('  --Hi!--  '), 'hi'));
+test('custom separator', () => assert.strictEqual(toSlug('a b c', '_'), 'a_b_c'));
