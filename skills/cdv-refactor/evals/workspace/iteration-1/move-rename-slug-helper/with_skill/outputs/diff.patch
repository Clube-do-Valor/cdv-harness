diff --git a/test/cli.test.js b/test/cli.test.js
new file mode 100644
index 0000000..a30b845
--- /dev/null
+++ b/test/cli.test.js
@@ -0,0 +1,24 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert');
+const path = require('path');
+const { spawnSync } = require('child_process');
+
+const cli = path.join(__dirname, '..', 'bin', 'cli.js');
+const run = (...args) => spawnSync(process.execPath, [cli, ...args], { encoding: 'utf8' });
+
+test('cli slug prints the slug of the words', () => {
+  const result = run('slug', 'Crème', 'Brûlée', '&', 'Co');
+  assert.strictEqual(result.status, 0);
+  assert.strictEqual(result.stdout, 'creme-brulee-and-co\n');
+});
+test('cli truncate prints the truncated text', () => {
+  const result = run('truncate', 'abcdefghij', '5');
+  assert.strictEqual(result.status, 0);
+  assert.strictEqual(result.stdout, 'abcd…\n');
+});
+test('cli rejects an unknown command', () => {
+  const result = run('nope');
+  assert.strictEqual(result.status, 2);
+  assert.match(result.stderr, /unknown command: nope/);
+});
