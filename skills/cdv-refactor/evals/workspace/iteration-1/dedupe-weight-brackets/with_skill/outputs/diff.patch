@@ -0,0 +1,56 @@
+"""Records what quote() and label_cost() return today at every weight bracket edge.
+
+Recorded before the bracket table was shared; it must pass unchanged afterwards.
+Values are pinned as they are, including the behaviour listed in
+docs/research/2026-11-22-shared-brackets/bugs.md.
+"""
+import unittest
+
+from shipping.label import label_cost
+from shipping.quote import quote
+
+WEIGHTS = [0.01, 0.99, 1, 1.01, 4.99, 5, 5.01, 9.99, 10, 10.01, 50]
+ZONES = ["domestic", "eu", "intl", "INTL", "other"]
+
+LABEL = {
+    0.01: 6.25, 0.99: 6.25, 1: 6.25, 1.01: 10.75, 4.99: 10.75, 5: 10.75,
+    5.01: 15.25, 9.99: 15.25, 10: 15.25, 10.01: 21.25, 50: 21.25,
+}
+
+# quote: bracket price + 7.5 (the surcharge applies to every zone, see bugs.md) + 3.0 for eu.
+BRACKET_QUOTE = {
+    0.01: 5.0, 0.99: 5.0, 1: 5.0, 1.01: 9.5, 4.99: 9.5, 5: 9.5,
+    5.01: 14.0, 9.99: 14.0, 10: 20.0, 10.01: 20.0, 50: 20.0,
+}
+
+
+class BracketCharacterizationTest(unittest.TestCase):
+    def test_label_cost_at_every_edge(self):
+        for weight, expected in LABEL.items():
+            with self.subTest(weight=weight):
+                self.assertEqual(label_cost(weight), expected)
+
+    def test_quote_at_every_edge_and_zone(self):
+        for weight, bracket in BRACKET_QUOTE.items():
+            for zone in ZONES:
+                for express in (False, True):
+                    price = bracket + 7.5 + (3.0 if zone == "eu" else 0.0)
+                    if express:
+                        price *= 1.2
+                    with self.subTest(weight=weight, zone=zone, express=express):
+                        self.assertEqual(quote(weight, zone, express), round(price, 2))
+
+    def test_ten_kilos_is_a_different_bracket_in_quote_and_label(self):
+        self.assertEqual(label_cost(10), 15.25)   # 14.0 + 1.25: label treats 10 as mid
+        self.assertEqual(quote(10, "domestic"), 27.5)  # 20.0 + 7.5: quote treats 10 as heavy
+
+    def test_rejects_non_positive(self):
+        for weight in (0, -1):
+            with self.assertRaises(ValueError):
+                label_cost(weight)
+            with self.assertRaises(ValueError):
+                quote(weight, "eu")
+
+
+if __name__ == "__main__":
+    unittest.main()
