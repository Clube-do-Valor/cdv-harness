+"""The weight-bracket price table shared by the customer quote and the carrier label."""
+
+
+def bracket_price(weight_kg, *, ten_kg_is_mid):
+    """Base price for a weight, before zone, handling or express adjustments.
+
+    The two callers disagree on exactly 10 kg and that is kept as it was:
+    `ten_kg_is_mid=True` prices 10 kg in the 14.0 bracket, `False` in the 20.0 one.
+    """
+    if weight_kg <= 1:
+        return 5.0
+    if weight_kg <= 5:
+        return 9.5
+    if weight_kg < 10 or (ten_kg_is_mid and weight_kg == 10):
+        return 14.0
+    return 20.0
