+++ b/tests/test_brackets.py
@@ -0,0 +1,26 @@
+import unittest
+
+from shipping.brackets import bracket_price
+from shipping.label import label_cost
+from shipping.quote import quote
+
+
+class BracketPriceTest(unittest.TestCase):
+    def test_bracket_edges(self):
+        self.assertEqual(bracket_price(1), 5.0)
+        self.assertEqual(bracket_price(1.01), 9.5)
+        self.assertEqual(bracket_price(5), 9.5)
+        self.assertEqual(bracket_price(5.01), 14.0)
+        self.assertEqual(bracket_price(9.99), 14.0)
+        self.assertEqual(bracket_price(10.01), 20.0)
+
+    def test_exactly_ten_kg_differs_by_caller(self):
+        # Kept as it was before the extraction: label is 5-10 kg, quote is heavy.
+        self.assertEqual(bracket_price(10), 14.0)
+        self.assertEqual(bracket_price(10, ten_kg_in_heavy_bracket=True), 20.0)
+        self.assertEqual(label_cost(10), 15.25)
+        self.assertEqual(quote(10, "domestic"), 27.5)
+
+
+if __name__ == "__main__":
+    unittest.main()
