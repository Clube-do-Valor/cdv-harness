+"""Weight-bracket base price shared by the customer quote and the carrier label."""
+
+
+def bracket_price(weight_kg, *, ten_kg_in_heavy_bracket=False):
+    """Base price for a parcel weight, before any surcharge, fee or factor.
+
+    Brackets: up to 1 kg, up to 5 kg, up to 10 kg, above.
+
+    The two callers disagree on exactly 10 kg and that is kept as it was:
+    the quote prices it in the heaviest bracket (pass True), the label
+    cost prices it in the 5-10 kg bracket (default False).
+    """
+    if weight_kg <= 1:
+        return 5.0
+    if weight_kg <= 5:
+        return 9.5
+    if weight_kg < 10 or (weight_kg == 10 and not ten_kg_in_heavy_bracket):
+        return 14.0
+    return 20.0
