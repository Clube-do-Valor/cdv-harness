#!/usr/bin/env python3
"""notion - read and write Notion pages and data sources through the public REST API.

One API token on the machine, read in this order: $NOTION_API_TOKEN, the keyring
(`secret-tool lookup service notion-api`), then ~/.config/notion/credentials (mode 600). Store it once
with `notion auth login` in a terminal. The token is never printed and is sent only to api.notion.com.

  notion auth login | status | logout
  notion doctor [--write-check <data source>] [--marker PREFIX]
  notion fetch <ref> [--discussions] [--props-only] [--json]
  notion update <ref> [--set 'Prop=value']... [--edit OLD NEW]... [--replace-file F | --append-file F | --prepend-file F]
                [--allow-deleting-content] [--icon X]
  notion create --parent <ref> [--set 'Prop=value']... [--body-file F] [--icon X] [--pages-file F]
  notion query <ref> [--where EXPR] [--order 'Prop desc'] [--select 'a,b'] [--limit N] [--max-rows N]
               [--count] [--group-by Prop] [--json]
  notion search <words> [--in <ref>] [--limit N]
  notion comments list <ref> | add <ref> | reply <discussion> | edit <comment>   (--body TEXT | --body-file F)
  notion upload <file>
  notion download <ref-or-url> [-o DIR]
  notion users find <name-or-email>
  notion whoami
  notion trash <ref> --confirm
  notion api <METHOD> </v1/path> [--data JSON | --data-file F] [--paginate]

<ref> is a Notion url, a 32-hex id, a hyphenated id, the collection form of a data source id, a ticket
key (<PREFIX>-<n>, resolved through the data source whose unique id has that prefix), or the title of
a connected data source.

Properties use the short format: --set 'Status=Done', --set 'date:Due:start=2026-11-22', people as
user://<uuid>, a name, an e-mail or `me`, relations as page references, checkbox __YES__/__NO__, lists
as `a,b` or a JSON array. Bodies are Notion-flavored Markdown (markdown_version v2).

A date with no time in --where (created >= 2026-11-01) is the whole day in UTC; write the instant with its
offset (created >= 2026-11-01T00:00:00-03:00) for a local day.

Exit codes: 0 done; 1 Notion refused or could not be reached; 2 the command is wrong; 3 no usable
token; 4 done in part.

Machine state: cache in ~/.cache/cdv-notion/ (data sources, schemas, people; safe to delete) and
settings in ~/.config/cdv-notion/config.json ({"me": "<your e-mail>", "stamp_comments": "on"|"off",
"test_marker": "<title prefix of write-check cards>"}).
"""
import argparse
import bisect
import collections
import contextlib
import datetime
import difflib
import getpass
import http.client
import json
import mimetypes
import os
import re
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
import uuid
import zoneinfo
from pathlib import Path

try:
    import fcntl
except ImportError:  # no flock here: a cache file is still written whole, and of two writes at once one may be lost
    fcntl = None

API_HOST = 'api.notion.com'
API_ROOT = f'https://{API_HOST}'
NOTION_VERSION = '2026-03-11'
MARKDOWN_VERSION = 'v2'
TOKEN_ENV = 'NOTION_API_TOKEN'
KEYRING = ('service', 'notion-api')
COLLECTION = 'collection://'
PAGE_URL = 'https://app.notion.com/p/'
MAX_RETRIES = 5
DEFAULT_ROWS = 50
MAX_ROWS = 2000
SCHEMA_BUDGET = 6000
UNTITLED = '(untitled)'
UPLOAD_LIMIT = 20 * 1024 * 1024

DONE, REFUSED, USAGE, NO_TOKEN, PARTIAL = 0, 1, 2, 3, 4

# What a write that did not succeed did. write_outcome() decides it, where the HTTP call is made; every
# verb takes its words from OUTCOME_WORDS and every report of several writes from report_writes().
NOT_SENT, REFUSED_WRITE, IN_DOUBT = 'not sent', 'refused', 'in doubt'
OUTCOME_WORDS = {
    NOT_SENT: 'the request never left this machine, so nothing changed',
    REFUSED_WRITE: 'Notion refused it and nothing changed',
    IN_DOUBT: 'the write is in doubt: it may have been applied, so read the object back before sending it again',
}
LOGIN_HINT = 'run `notion auth login` in a terminal'
NO_TOKEN_HELP = (f'no Notion API token on this machine: {LOGIN_HINT} (or export {TOKEN_ENV}); '
                 'the cdv-notion skill, references/setup.md, says where the token comes from')

UUID_RE = re.compile(r'(?<![0-9a-fA-F])([0-9a-fA-F]{8})-?([0-9a-fA-F]{4})-?([0-9a-fA-F]{4})-?([0-9a-fA-F]{4})-?'
                     r'([0-9a-fA-F]{12})(?![0-9a-fA-F])')
KEY_RE = re.compile(r'([A-Za-z][A-Za-z0-9-]{0,9})-(\d+)')
TOKEN_SHAPE = re.compile(r'\b(?:ntn|secret)_[A-Za-z0-9]{12,}')


class Fail(Exception):
    """A command that cannot go on. `outcome` is set on a write that did not succeed (NOT_SENT, REFUSED_WRITE
    or IN_DOUBT, from write_outcome); `cause` is what happened, without the advice the message adds."""

    def __init__(self, code, message='', outcome=None, cause=None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.outcome = outcome
        self.cause = cause or message


def with_words(cause, outcome):
    """A write's failure as the reader sees it: what happened, then which of the three cases it is."""
    return f"{cause.rstrip('.')}: {OUTCOME_WORDS[outcome]}" if outcome else cause


class ApiError(Fail):
    def __init__(self, status, code, message, body, path, outcome=None):
        self.status, self.api_code, self.api_message, self.body, self.path = status, code, message, body, path
        cause = f'Notion answered {status} {code} on {path}: {message}'
        super().__init__(USAGE if status == 400 else REFUSED, with_words(cause, outcome), outcome, cause)


class WriteInDoubt(Fail):
    """A write whose request left and that no answer settles (see write_outcome): Notion may have applied it."""

    def __init__(self, what, path, body=None, status=None):
        self.what, self.status, self.path, self.body = what, status, path, body or {}
        cause = f'{what} on {path}'
        super().__init__(REFUSED, with_words(cause, IN_DOUBT), IN_DOUBT, cause)


class CreateInDoubt(Fail):
    """A create that ended in doubt and whose page was not found afterwards: it was not sent again."""

    def __init__(self, doubt, title, where, lookup=None):
        name = repr(title or '(untitled)')
        if lookup is not None:
            cause = f'{doubt.what}; the page could not be looked for ({lookup.cause}); it was not sent again'
        else:
            cause = (f'{doubt.what}; no page with that title, besides the ones this command already reported, was '
                     'found from this integration since the minute the command started; it was not sent again')
        self.advice = (f'it may have been created and may still appear, so look for a page titled {name} in {where} '
                       'before creating it again')
        code = NO_TOKEN if lookup is not None and lookup.code == NO_TOKEN else REFUSED  # 401 keeps exit 3
        super().__init__(code, f'In doubt: the create of {name} ({cause}): {self.advice}', IN_DOUBT, cause)


class Unbuildable(Fail):
    """A step Notion refused with a 400 that cannot be built from the schema read again: a property or an option it
    names is unknown. It has that failure's message and exit code; Notion did nothing."""

    def __init__(self, failure):
        super().__init__(failure.code, failure.message, REFUSED_WRITE)


UNBUILT = object()  # on_current_schema's `built` when the step is still to be built


class NoSuchKey(Fail):
    """A ticket key that leads to no page: no connected data source has its prefix, or none of them has its number."""


class Unsent(ConnectionError):
    """The connection to the API could not be established: the request never left this machine."""


def write_outcome(status=None, error=None):
    """What a write that did not come back with a success did, decided here and nowhere else.

    NOT_SENT: the connection could not be established (Unsent, a refused connection); nothing reached Notion.
    REFUSED_WRITE: Notion answered 4xx (a 429 once its retries are used up); nothing changed. IN_DOUBT: the
    request left and no answer says what happened - any 5xx, a redirect, a success whose body is not JSON, a
    timeout, a connection lost after it was established (a TLS error while the answer is read included), or
    any error that does not say whether the request left."""
    if error is not None:
        return NOT_SENT if isinstance(error, (Unsent, ConnectionRefusedError)) else IN_DOUBT
    if status is not None and 400 <= status < 500:
        return REFUSED_WRITE
    return IN_DOUBT


def said_by(error):
    """An exception in one line: its name, unless it is one of the transport's own, and what it says."""
    said = ' '.join(str(error).split())
    return said if said and type(error) in (ConnectionError, Unsent) else f'{type(error).__name__}: {said}'.rstrip(': ')


def is_write(method, path):
    return method != 'GET' and not path.endswith('/query') and path != '/v1/search'


# ---------------------------------------------------------------------------------------------
# The machine: transport, token, settings, cache. Tests replace TRANSPORT, SLEEP, secret_tool,
# git_email, STDIN_IS_TTY, GETPASS and NOW.
# ---------------------------------------------------------------------------------------------


def origin(url):
    """(scheme, host, port) of a url, the port filled in from the scheme; None when the port is not a number."""
    parts = urllib.parse.urlsplit(url)
    scheme = parts.scheme.lower()
    try:
        port = parts.port or {'https': 443, 'http': 80}.get(scheme)
    except ValueError:
        return None
    return scheme, (parts.hostname or '').lower(), port


class SameHostRedirects(urllib.request.HTTPRedirectHandler):
    """Follow a redirect of a GET, but carry the token only when the scheme, the host and the port all stay the
    same: never to another host or port, and never from https to http. A relative redirect stays (urllib has
    already joined it to the request's url). Any other method is not followed: urllib would send a POST again
    as a GET, whose answer says nothing about the write."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if req.get_method() not in ('GET', 'HEAD'):
            return None
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and (origin(newurl) is None or origin(newurl) != origin(req.full_url)):
            for name in list(new.headers):
                if name.lower() == 'authorization':
                    del new.headers[name]
        return new


class Dialled:
    """A connection whose connect() says Unsent when it fails - the name, the route, the refusal, the TLS
    handshake, a timeout - because only there is it certain that no byte of the request left."""

    def connect(self):
        try:
            super().connect()
        except OSError as error:
            raise Unsent(said_by(error))


class DialledHTTP(Dialled, http.client.HTTPConnection):
    pass


class DialledHTTPS(Dialled, http.client.HTTPSConnection):
    pass


class DialHTTP(urllib.request.HTTPHandler):
    def do_open(self, http_class, req, **options):
        return super().do_open(DialledHTTP, req, **options)


class DialHTTPS(urllib.request.HTTPSHandler):
    def do_open(self, http_class, req, **options):
        return super().do_open(DialledHTTPS, req, **options)


_OPENER = urllib.request.build_opener(SameHostRedirects(), DialHTTP(), DialHTTPS())


def answer_body(error):
    """The body of an answer that is not a success; its status is the answer, so a body lost on the way is empty."""
    try:
        return error.read()
    except (OSError, http.client.HTTPException):
        return b''


def urllib_transport(method, url, headers, body=None, timeout=60):
    """(status, headers, body), or Unsent when the connection could not be established, TimeoutError when no
    answer came in time, and ConnectionError for any other failure: once connected, the request may have left."""
    request = urllib.request.Request(url, data=body, method=method, headers=headers or {})
    try:
        with _OPENER.open(request, timeout=timeout) as response:
            return response.status, dict(response.headers.items()), response.read()
    except urllib.error.HTTPError as error:
        return error.code, dict((error.headers or {}).items()), answer_body(error)
    except (OSError, http.client.HTTPException) as error:
        # urllib wraps what connecting and sending raise in a URLError, and lets the rest (reading) through raw
        reason = error.reason if isinstance(error, urllib.error.URLError) else error
        if isinstance(reason, Unsent):
            raise reason
        if isinstance(reason, TimeoutError):
            raise TimeoutError(str(reason))
        raise ConnectionError(said_by(reason) if isinstance(reason, Exception) else str(reason))


TRANSPORT = urllib_transport
SLEEP = time.sleep


def STDIN_IS_TTY():
    return sys.stdin.isatty()


GETPASS = getpass.getpass


def NOW():
    return datetime.datetime.now(datetime.timezone.utc)


def secret_tool(*args, stdin=None):
    try:
        return subprocess.run(['secret-tool', *args], input=stdin, capture_output=True, text=True)
    except FileNotFoundError:
        return None


def git_email():
    try:
        return subprocess.run(['git', 'config', 'user.email'], capture_output=True, text=True).stdout.strip()
    except FileNotFoundError:
        return ''


def home():
    return Path(os.path.expanduser('~'))


def credentials_path():
    return home() / '.config' / 'notion' / 'credentials'


def config_path():
    return home() / '.config' / 'cdv-notion' / 'config.json'


def cache_dir():
    return home() / '.cache' / 'cdv-notion'


def well_formed(token, source):
    """The token, or Fail(NO_TOKEN) naming the source (never the value) when it holds anything but printable
    ASCII: such a value would reach the Authorization header, and the error the HTTP layer raises prints it."""
    if not re.fullmatch(r'[\x21-\x7e]+', token):
        raise Fail(NO_TOKEN, f'the token from {source} is malformed (it holds a space, a line break or a character '
                             f'that is not plain ASCII); store it again: {LOGIN_HINT}')
    return token, source


def find_token():
    from_env = os.environ.get(TOKEN_ENV, '').strip()
    if from_env:
        return well_formed(from_env, f'${TOKEN_ENV}')
    found = secret_tool('lookup', *KEYRING)
    if found and found.returncode == 0 and found.stdout.strip():
        return well_formed(found.stdout.strip(), 'the keyring')
    path = credentials_path()
    if path.is_file():
        for line in path.read_text(encoding='utf-8').splitlines():
            line = line.strip()
            if line and not line.startswith('#'):
                return well_formed(line, str(path))
    return '', ''


def settings():
    path = config_path()
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding='utf-8') or '{}')
    except json.JSONDecodeError as error:
        raise Fail(USAGE, f'{path} is not valid JSON ({error}); fix or delete it')
    return data if isinstance(data, dict) else {}


class Cache:
    """Rebuildable facts about the workspace: data source list, schemas, people. Safe to delete."""

    def __init__(self):
        self.dir = cache_dir()

    def get(self, name):
        try:
            return json.loads((self.dir / f'{name}.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            return None

    def put(self, name, value):
        try:
            self.dir.mkdir(parents=True, exist_ok=True, mode=0o700)
            target = self.dir / f'{name}.json'
            scratch = self.dir / f'.{name}.{os.getpid()}.tmp'
            scratch.write_text(json.dumps(value, ensure_ascii=False, sort_keys=True), encoding='utf-8')
            os.replace(scratch, target)
        except OSError:
            pass  # a cache that cannot be written is only slower

    def update(self, name, merge):
        """Write merge(what the file holds, or None), unless that is None. The file is read, merged and written
        under its lock, so what another session writes at the same time is never lost; where there is no lock to
        take, it goes on without one."""
        lock = None
        try:
            if fcntl:
                with contextlib.suppress(OSError):
                    self.dir.mkdir(parents=True, exist_ok=True, mode=0o700)
                    lock = open(self.dir / f'.{name}.lock', 'a')
                    fcntl.flock(lock, fcntl.LOCK_EX)
            value = merge(self.get(name))
            if value is not None:
                self.put(name, value)
        finally:
            if lock:
                lock.close()


# ---------------------------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------------------------


def hyphenate(raw):
    match = UUID_RE.search(raw)
    if not match:
        return None
    return '-'.join(match.groups()).lower()


def compact(identifier):
    return identifier.replace('-', '')


def page_link(identifier):
    return PAGE_URL + compact(identifier)


def plain(rich):
    return ''.join(part.get('plain_text') or (part.get('text') or {}).get('content', '') for part in rich or [])


def rich_text(value, url=None):
    pieces = [{'content': value[i:i + 2000]} for i in range(0, len(value), 2000)]
    return [{'text': dict(piece, link={'url': url}) if url else piece} for piece in pieces]


# [text](address) in a text value is a link. The address is written as it is when it starts with http://, https://,
# mailto: or tel:, and between < and > when it is anything else; a path inside Notion (/…) is written in full.
# Inside a link: in the text, a bracket that is not one balanced pair and every backslash are written \[ \] \\ (a
# backslash before anything else is a backslash); in the address, a parenthesis that is not one balanced pair, a
# backslash and a space are written \( \) \\ and a backslash and the space. Outside a link: a backslash before the [ of
# what would read as a link makes it plain text, backslashes right before that [ or right before a link are doubled,
# and nothing else is escaped.
NOTION_HOST = 'https://app.notion.com'
RAW_ADDRESS = re.compile(r'https?://|mailto:|tel:')
INSIDE_NOTION = re.compile(r'/[0-9a-f]{32}(?:#[0-9a-f]{32})?')
_PLAIN_TEXT = re.compile(r'(?:[^\[\]\\]|\[[^\[\]\\]*\])+')
_TEXT_ESCAPE = re.compile(r'\\([\\\[\]])')
_ADDRESS_ESCAPE = re.compile(r'\\([\\()\s])')


class LinkScan:
    """Finds the links of a value that is fed one character at a time, from its end to its start, so that each
    character is looked at once. What a `[` opens depends only on the text at its right. A position is the number of
    characters at the right of a character; an escaped character is one with an odd number of backslashes before it."""

    def __init__(self):
        self.chars = []
        self.closing, self.parens = [], []  # the ] and the ) that nothing has opened yet, nearest last
        self.space = -1  # the nearest space that is not escaped
        self.ends = {}  # the ( of an address -> its )

    def link(self):
        """The (], ) of the link that a `[` fed now would open, or None."""
        if not self.closing:
            return None
        close = self.closing[-1]
        return (close, self.ends[close - 1]) if close < len(self.chars) - 1 and close - 1 in self.ends else None

    def feed(self, char, escaped=False):
        at = len(self.chars)
        self.chars.append(char)
        if escaped:
            return
        if char == ']':
            self.closing.append(at)
        elif char == '[':
            if self.closing:
                self.closing.pop()
        elif char == ')':
            self.parens.append(at)
        elif char == '(':
            if self.parens:
                end = self.parens.pop()
                if self.space < end and self.is_address(end, at):
                    self.ends[at] = end
        elif char.isspace():
            self.space = at

    def is_address(self, end, at):
        size = at - end - 1
        head = ''.join(reversed(self.chars[max(end + 1, at - 8):at]))
        if head[:1] == '<':
            return size > 2 and self.chars[end + 1] == '>'
        raw = RAW_ADDRESS.match(head)
        return bool(raw) and size > raw.end()


def escaped_flags(value):
    """For each character of the value, whether an odd number of backslashes stands right before it."""
    flags, odd = [], False
    for char in value:
        flags.append(odd and char != '\\')
        odd = not odd if char == '\\' else False
    return flags


def link_text(said):
    """The text of a link as it is written: as it is when it needs nothing, else with \\ \\[ \\] escaped."""
    return said if _PLAIN_TEXT.fullmatch(said) else re.sub(r'[\\\[\]]', lambda m: '\\' + m.group(), said)


def link_address(url):
    """The address of a link as it is written: one level of balanced parentheses as they are, the rest escaped."""
    path = url.startswith('/') and not url.startswith('//')
    if path:
        url = NOTION_HOST + url
    said = re.sub(r'(\([^\s()\\]*\))|([\\()\s])', lambda m: m.group(1) or '\\' + m.group(2), url)
    if path:
        return said
    raw = RAW_ADDRESS.match(url)
    if raw and len(url) > raw.end() and not (url.startswith(NOTION_HOST) and INSIDE_NOTION.fullmatch(url[len(NOTION_HOST):])):
        return said
    return f'<{said}>'


def address_of(written):
    """The reverse of link_address(). The API takes a path back only as /<32 hex>; it also returns longer ones, such
    as /p/<32 hex>?pvs=…, and refuses them, so those stay the full address of the same page."""
    if written.startswith('<'):
        return _ADDRESS_ESCAPE.sub(r'\1', written[1:-1])
    url = _ADDRESS_ESCAPE.sub(r'\1', written)
    inside = url[len(NOTION_HOST):] if url.startswith(NOTION_HOST) else ''
    return inside if INSIDE_NOTION.fullmatch(inside) else url


def linked(rich):
    """The text of a title or text property with each linked run as [text](address) and everything else as it is
    (see LinkScan and the note above it). Runs of one link (a bold word inside it splits it) are one link; a mention
    is its plain text. linked_text() gives the same runs back (a path address_of() keeps in full excepted)."""
    runs = []  # [address or None, text], neighbours of one address together
    for part in rich or []:
        said = part.get('plain_text') or (part.get('text') or {}).get('content', '')
        url = ((part.get('text') or {}).get('link') or {}).get('url') if part.get('type', 'text') == 'text' else None
        if not said:
            continue
        if runs and runs[-1][0] == (url or None):
            runs[-1][1] += said
        else:
            runs.append([url or None, said])
    if len(runs) == 1 and not runs[0][0] and '](' not in runs[0][1]:
        return runs[0][1]
    scan, out, before_link = LinkScan(), [], False
    for url, said in reversed(runs):
        if url:
            written = f'[{link_text(said)}]({link_address(url)})'
            for char, escaped in zip(reversed(written), reversed(escaped_flags(written))):
                scan.feed(char, escaped)
            out.append(written)
            before_link = True
            continue
        flags, at, double = escaped_flags(said), len(said) - 1, before_link
        while at >= 0:
            char = said[at]
            if double and char == '\\':
                char = '\\\\'  # a backslash right before a link, or before a [ that was made plain text
                scan.feed('\\')
                scan.feed('\\')
            elif char == '[' and scan.link():
                scan.feed('[', True)
                scan.feed('\\')
                char, double = '\\[', True
            else:
                scan.feed(char, flags[at])
                double = False
            out.append(char)
            at -= 1
        before_link = False
    return ''.join(reversed(out))


def linked_text(value):
    """The reverse of linked(): a value as rich text, each [text](address) a linked run."""
    if '](' not in value:
        return rich_text(value)
    scan, flags, last, found = LinkScan(), escaped_flags(value), len(value) - 1, []
    for at in range(last, -1, -1):
        link = scan.link() if value[at] == '[' else None
        if link:
            found.append((at, last - link[0], last - link[1]))
        scan.feed(value[at], flags[at])
    runs, said, at = [], [], 0
    for start, close, end in reversed(found):
        if start < at:
            continue  # inside a link already read
        slashes = 0
        while start - slashes > at and value[start - slashes - 1] == '\\':
            slashes += 1
        said.append(value[at:start - slashes] + '\\' * (slashes // 2))
        if slashes % 2:  # plain text that looks like a link
            said.append('[')
            at = start + 1
            continue
        runs += rich_text(''.join(said)) + rich_text(_TEXT_ESCAPE.sub(r'\1', value[start + 1:close]), address_of(value[close + 2:end]))
        said, at = [], end + 1
    return runs + rich_text(''.join(said) + value[at:])


def fold(value):
    decomposed = unicodedata.normalize('NFKD', value or '')
    return ''.join(ch for ch in decomposed if not unicodedata.combining(ch)).casefold()


def nearest(word, names, count=3):
    by_case = {name.casefold(): name for name in names}
    close = difflib.get_close_matches(word.casefold(), list(by_case), n=count, cutoff=0.5)
    return [by_case[c] for c in close]


def read_file(path):
    try:
        return Path(path).read_text(encoding='utf-8')
    except OSError as error:
        raise Fail(USAGE, f'cannot read {path}: {error.strerror}')


def split_list(value):
    value = value.strip()
    if value.startswith('['):
        try:
            items = json.loads(value)
        except json.JSONDecodeError as error:
            raise Fail(USAGE, f'not a JSON array: {value} ({error})')
        return [str(item) for item in items]
    return [item.strip() for item in value.split(',') if item.strip()]


def number_of(text, what):
    try:
        number = float(text)
    except ValueError:
        raise Fail(USAGE, f'{what}: {text!r} is not a number')
    return int(number) if number.is_integer() else number


class Ref:
    """A parsed reference: kind is id, data_source, key or title."""

    def __init__(self, kind, value, prefix=None, number=None):
        self.kind, self.value, self.prefix, self.number = kind, value, prefix, number


def parse_ref(text):
    text = (text or '').strip()
    if not text:
        raise Fail(USAGE, 'empty reference')
    if text.startswith(COLLECTION):
        identifier = hyphenate(text[len(COLLECTION):])
        if not identifier:
            raise Fail(USAGE, f'no data source id in {text}')
        return Ref('data_source', identifier)
    if text.startswith('discussion://') or text.startswith('notion-file-block://'):
        found = UUID_RE.findall(text)
        if not found:
            raise Fail(USAGE, f'no id in {text}')
        index = -1 if text.startswith('discussion://') else 0
        return Ref('id', '-'.join(found[index]).lower())
    if re.match(r'https?://', text):
        parts = urllib.parse.urlsplit(text)
        peek = urllib.parse.parse_qs(parts.query).get('p', [''])[0]
        if hyphenate(peek):
            return Ref('id', hyphenate(peek))
        found = UUID_RE.findall(parts.path)
        if not found:
            raise Fail(USAGE, f'no Notion id in the url {text}')
        return Ref('id', '-'.join(found[-1]).lower())
    if UUID_RE.fullmatch(text):
        return Ref('id', hyphenate(text))
    match = KEY_RE.fullmatch(text)
    if match:
        return Ref('key', text, prefix=match.group(1).upper(), number=int(match.group(2)))
    return Ref('title', text)


# ---------------------------------------------------------------------------------------------
# The client
# ---------------------------------------------------------------------------------------------


class Notion:
    def __init__(self):
        self._token = None
        self.source = ''
        self.cache = Cache()
        self._bot = None
        self._people = None
        self._listed = None
        self._warned_unlisted = False
        self._list_stopped_at = 0  # the page of GET /v1/users that failed, 0 while none did
        self.me_unresolved = ''  # why `me` could not be resolved, once me() has tried
        self._settings = None
        self._schemas = {}
        self._fresh = set()  # data sources whose schema was read from the API in this command
        self._list_fresh = False  # the data source list was read from the API in this command
        self._sources = None  # that list, once read
        self.json = False  # the command was given --json: stdout holds one JSON document, emit()'s, and nothing else

    # -- secrets and output ---------------------------------------------------------------

    def redact(self, text):
        text = str(text)
        if self._token:
            text = text.replace(self._token, '[token]')
        return TOKEN_SHAPE.sub('[token]', text)

    def say(self, text=''):
        """A line for the reader; with --json it is a note beside the document, so it goes to stderr."""
        print(self.redact(text), file=sys.stderr if self.json else sys.stdout)

    def emit(self, value):
        """The one JSON document a --json command prints on stdout."""
        print(self.redact(json.dumps(value, ensure_ascii=False, indent=2)))

    def warn(self, text):
        print(self.redact(text), file=sys.stderr)

    def settings(self):
        if self._settings is None:
            self._settings = settings()
        return self._settings

    def token(self):
        if self._token is None:
            token, source = find_token()
            if not token:
                raise Fail(NO_TOKEN, NO_TOKEN_HELP)
            self._token, self.source = token, source
            if source == str(credentials_path()):
                self.check_credentials_mode(credentials_path())
        return self._token

    def check_credentials_mode(self, path):
        """One warning line when the token file is readable by anyone but its owner; the token still works."""
        try:
            mode = path.stat().st_mode & 0o777
        except OSError:
            return
        if mode & 0o077:
            self.warn(f'warning: {path} is readable by group or others (mode {mode:03o}); '
                      f'run `chmod 600 {path}`')

    # -- HTTP -----------------------------------------------------------------------------

    def write_failed(self, path, status=None, parsed=None, error=None, retries=None):
        """The failure of a write that did not come back with a success, in the case write_outcome gives it:
        never sent, refused (an ApiError for a 4xx) or in doubt (WriteInDoubt)."""
        outcome = write_outcome(status, error)
        if outcome == NOT_SENT:
            cause = f'could not connect to api.notion.com ({error})'
            return Fail(REFUSED, with_words(cause, outcome), outcome, cause)
        if error is not None:
            what = ('api.notion.com did not answer in time' if isinstance(error, TimeoutError)
                    else f'the connection failed after the request may have left ({said_by(error)})')
            return WriteInDoubt(what, path)
        if retries is not None:
            cause = f'Notion kept answering {status} (rate limited) on {path} after {retries} retries'
            if outcome == IN_DOUBT:
                return WriteInDoubt(f'Notion kept answering {status} after {retries} retries', path, parsed, status)
            return Fail(REFUSED, with_words(cause, outcome) + '; wait a minute and run it again', outcome, cause)
        if outcome == IN_DOUBT:
            unread = ' with a body that is not JSON' if 200 <= status < 300 else ''
            return WriteInDoubt(f'Notion answered {status}{unread}', path, parsed, status)
        return ApiError(status, parsed.get('code', ''), parsed.get('message', ''), parsed, path, outcome)

    def send(self, method, path, body=None, query=None, raw=None, content_type=None, write=None):
        """(status, json) after the retry rules. Raises Fail(3) on 401, and on a write whose answer is not a
        success and not a 4xx, the failure write_failed gives. The token only ever goes to api.notion.com/v1/."""
        if not path.startswith('/v1/'):
            raise Fail(USAGE, f'not an API path: {path}')
        url = API_ROOT + path
        if query:
            url += '?' + urllib.parse.urlencode(query, doseq=True)
        if urllib.parse.urlsplit(url).netloc != API_HOST:
            raise Fail(USAGE, f'refusing to send the token to {url}')
        headers = {'Authorization': f'Bearer {self.token()}', 'Notion-Version': NOTION_VERSION}
        data = raw
        if raw is None and body is not None:
            data = json.dumps(body).encode('utf-8')
            headers['Content-Type'] = 'application/json'
        elif raw is not None:
            headers['Content-Type'] = content_type or 'application/octet-stream'
        if write is None:
            write = is_write(method, path)
        limited = server = 0
        while True:
            try:
                status, answer_headers, payload = TRANSPORT(method, url, headers, data, 60)
            except TimeoutError as error:
                if write:
                    raise self.write_failed(path, error=error)
                if server < 2:
                    server += 1
                    SLEEP(server)
                    continue
                raise Fail(REFUSED, f'api.notion.com did not answer {method} {path} in time')
            except (OSError, http.client.HTTPException) as error:
                if write:
                    raise self.write_failed(path, error=error)
                raise Fail(REFUSED, f'could not reach api.notion.com: {said_by(error)}')
            except Exception as error:
                if write:  # whatever else the transport raised does not say that the request never left
                    raise self.write_failed(path, error=error)
                raise
            parsed = self.parse(payload)
            if status == 529 and write:  # "overloaded" is a 5xx: the write may have been applied, so never resend it
                raise self.write_failed(path, status, parsed)
            if status in (429, 529):
                reason = (parsed.get('additional_data') or {}).get('rate_limit_reason', '')
                if limited >= MAX_RETRIES or reason == 'public_api_request_blocked':
                    if write:
                        raise self.write_failed(path, status, parsed, retries=limited)
                    cause = f'Notion kept answering {status} (rate limited) on {path} after {limited} retries'
                    raise Fail(REFUSED, cause + '; wait a minute and run the command again', cause=cause)
                limited += 1
                SLEEP(self.retry_after(answer_headers, parsed, limited))
                continue
            if status in (500, 502, 503, 504) and not write and server < 2:
                server += 1
                SLEEP(server)
                continue
            if status == 401:
                raise Fail(NO_TOKEN, f'Notion rejected the token from {self.source} (401 unauthorized: revoked, '
                                     f'expired or mistyped): {LOGIN_HINT} again', write_outcome(401) if write else None)
            if write and not 200 <= status < 300 and write_outcome(status) == IN_DOUBT:
                raise self.write_failed(path, status, parsed)
            if 200 <= status < 300 and not self.is_answer(payload):
                # A proxy's page, or the API's answer cut short: it does not say whether the write was applied.
                if write:
                    raise self.write_failed(path, status, {})
                raise Fail(REFUSED, f'Notion answered {status} on {method} {path} with a body that is not JSON; '
                                    'a proxy or a sign-in page may stand between this machine and api.notion.com')
            return status, parsed

    @staticmethod
    def is_answer(payload):
        """Whether the body of a success is one the API sends: a JSON object, or a list of them."""
        try:
            return isinstance(json.loads(payload), (dict, list))
        except ValueError:
            return False

    @staticmethod
    def parse(payload):
        if not payload:
            return {}
        try:
            parsed = json.loads(payload)
        except ValueError:
            return {'message': payload.decode('utf-8', 'replace')[:500]}
        return parsed if isinstance(parsed, dict) else {'results': parsed}

    @staticmethod
    def retry_after(headers, parsed, attempt):
        for name, value in (headers or {}).items():
            if name.lower() == 'retry-after':
                try:
                    seconds = float(value)
                    return int(seconds) if seconds.is_integer() else seconds
                except ValueError:
                    break
        given = (parsed.get('additional_data') or {}).get('retry_after')
        if isinstance(given, (int, float)):
            return given
        return min(2 ** attempt, 60)

    def call(self, method, path, body=None, query=None, **extra):
        status, parsed = self.send(method, path, body, query, **extra)
        if 200 <= status < 300:
            return parsed
        write = extra.get('write')
        if write if write is not None else is_write(method, path):
            raise self.write_failed(path, status, parsed)
        raise ApiError(status, parsed.get('code', ''), parsed.get('message', ''), parsed, path)

    def pages_of(self, method, path, body=None, query=None, max_items=None, whole=False):
        """Every item of a paged list, following next_cursor. Returns (items, more_left): more_left when there are
        more than `max_items`. Paging stops once it has them; `whole` also returns what came past that number."""
        items, cursor = [], None
        while True:
            if method == 'GET':
                q = dict(query or {}, page_size=100)
                if cursor:
                    q['start_cursor'] = cursor
                answer = self.call('GET', path, query=q)
            else:
                b = dict(body or {}, page_size=100)
                if cursor:
                    b['start_cursor'] = cursor
                answer = self.call(method, path, b, query=query)
            items += answer.get('results', [])
            more = bool(answer.get('has_more') and answer.get('next_cursor'))
            if max_items is not None and len(items) >= max_items:
                return items if whole else items[:max_items], more or len(items) > max_items
            if not more:
                return items, False
            cursor = answer['next_cursor']

    def not_connected(self, identifier, error):
        return Fail(REFUSED, f'Notion answered {error.status} {error.api_code} for {identifier}: the integration is not '
                             'connected to that page or its parent, or it lacks the capability. Open the page in '
                             'Notion, menu > Connections, and add the integration (D8 keeps the access to the '
                             'data sources the team agreed on).')

    # -- the bot, settings, people --------------------------------------------------------

    def bot(self):
        if self._bot is None:
            self._bot = self.call('GET', '/v1/users/me')
        return self._bot

    def owner_kind(self):
        return ((self.bot().get('bot') or {}).get('owner') or {}).get('type', '')

    def people(self):
        if self._people is None:
            self._people = self.cache.get('people') or {}
        return self._people

    def remember(self, user):
        if not isinstance(user, dict) or not user.get('id') or not user.get('name'):
            return
        known, identifier = self.people(), user['id']
        before = known.get(identifier) or {}
        entry = {'name': user['name'], 'type': user.get('type', 'person')}
        email = (user.get('person') or {}).get('email')
        if email or before.get('email'):
            entry['email'] = email or before['email']
        if before == entry:
            return

        def merge(saved):
            # another session may have written since this one read the file: what it holds wins, for everyone but
            # the person just seen, whose e-mail it may know when this answer does not give it
            known.update(saved or {})
            kept = email or (known.get(identifier) or {}).get('email') or before.get('email')
            known[identifier] = dict(entry, email=kept) if kept else entry
            return known

        self.cache.update('people', merge)

    def list_users(self):
        """(people known after listing, None) or, when a page of the list fails, (the people of the pages read
        before it plus the people from rows read, the reason as the API gave it). Each page's people are kept as
        it arrives; the page that failed is in self._list_stopped_at."""
        cursor, number = None, 0
        while True:
            number += 1
            query = {'page_size': 100}
            if cursor:
                query['start_cursor'] = cursor
            try:
                answer = self.call('GET', '/v1/users', query=query)
            except Fail as failure:
                if failure.code == NO_TOKEN:
                    raise
                self._list_stopped_at = number
                if isinstance(failure, ApiError):
                    return self.people(), f'{failure.status} {failure.api_code}: {failure.api_message}'.strip()
                return self.people(), failure.cause
            for user in answer.get('results', []):
                self.remember(user)
            if not (answer.get('has_more') and answer.get('next_cursor')):
                return self.people(), None
            cursor = answer['next_cursor']

    def warn_unlisted(self, reason):
        """One line per run: a person found by name or e-mail was matched without the whole user list."""
        if not reason or self._warned_unlisted:
            return
        self._warned_unlisted = True
        stopped = self._list_stopped_at
        if stopped > 1:
            said = (f'the list of users is incomplete: page {stopped} of GET /v1/users failed ({reason}); a name or '
                    f'e-mail was matched over the people of the {stopped - 1} page(s) read before it and the people '
                    'seen in pages read on this machine')
        else:
            said = (f'the list of users could not be read (GET /v1/users failed: {reason}); a name or e-mail was '
                    'matched only over the people seen in pages read on this machine')
        self.warn(f'warning: {said}. Pass `user://<uuid>`, or turn on the integration\'s user information '
                  'capability, to remove the doubt')

    def user_name(self, identifier):
        known = self.people().get(identifier)
        if known:
            return known['name']
        if self._bot and self._bot.get('id') == identifier:
            return self._bot.get('name') or 'the integration'
        try:
            user = self.call('GET', f'/v1/users/{identifier}')
        except ApiError:
            return None
        self.remember(user)
        return user.get('name')

    def me(self, required=True):
        """The person this machine acts for: `me` in the settings, else git config user.email."""
        wanted = (self.settings().get('me') or git_email() or '').strip()
        how = (f'set "me" in {config_path()} to your Notion e-mail, for example {{"me": "you@example.com"}}')
        if not wanted:
            if required:
                raise Fail(REFUSED, f'no e-mail to look up: {how}')
            return None
        if wanted.startswith('user://'):
            identifier = hyphenate(wanted)
            return {'id': identifier, 'name': self.user_name(identifier) or wanted, 'email': ''}
        reason = None
        for pass_ in (0, 1):
            if pass_ == 0:
                people = self.people()
            else:
                people, reason = self.everyone()
            for identifier, person in people.items():
                if fold(person.get('email', '')) == fold(wanted):
                    return dict(person, id=identifier)
        if reason:  # the setting may be right: say why the person could not be looked up
            stopped = 'could not be read' if self._list_stopped_at <= 1 else 'is incomplete'
            self.me_unresolved = (f'the person with the e-mail {wanted} could not be found because the list of users '
                                  f'{stopped} (GET /v1/users failed: {reason}); "me" is set in {config_path()} '
                                  '(else `git config user.email`)')
        else:
            self.me_unresolved = f'nobody the integration can see has the e-mail {wanted}: {how}'
        if required:
            raise Fail(REFUSED, self.me_unresolved)
        return None

    def person_ref(self, user):
        self.remember(user)
        name = user.get('name') or self.people().get(user.get('id'), {}).get('name')
        ref = f"user://{user.get('id')}"
        return f'{ref} ({name})' if name else ref

    # -- data sources and schemas ---------------------------------------------------------

    def data_source(self, identifier, refresh=False):
        if not refresh and identifier in self._schemas:
            return self._schemas[identifier]
        cached = None if refresh else self.cache.get(f'schema-{identifier}')
        if cached is None:
            cached = self.call('GET', f'/v1/data_sources/{identifier}')
            self.store_schema(identifier, cached)
        self._schemas[identifier] = cached
        return cached

    def store_schema(self, identifier, schema):
        """Keep a schema the API just gave: for this command, in the cache, and in the cached list of data sources,
        whose title and key property come from it."""
        self._schemas[identifier] = schema
        self._fresh.add(identifier)
        self.cache.put(f'schema-{identifier}', schema)
        known = listed_entry(identifier, schema)

        def correct(listed):
            if any(entry.get('id') == identifier and entry != known for entry in listed or []):
                return [known if entry.get('id') == identifier else entry for entry in listed]
            return None

        self.cache.update('data_sources', correct)
        if self._sources is not None:
            self._sources = [known if entry['id'] == identifier else entry for entry in self._sources]

    # -- a cached schema that is out of date ------------------------------------------------
    # One rule, here and nowhere else: what an unknown property or option stops - the client's own lookup, the
    # API's 400, a row that does not hold a column - is done once more from the schema read again. The API is read
    # at most once per command for each data source.

    def refresh_schema(self, schema):
        """Bring `schema` (the caller's copy, which needs only its id) up to date in place with the schema as the
        API gave it in this command, read now unless it already was. True when that changed the copy."""
        identifier = schema.get('id')
        if not identifier:
            return False
        fresh = self.get_data_source(identifier, refresh=identifier not in self._fresh)
        if fresh == schema:
            return False
        schema.clear()
        schema.update(fresh)
        return True

    def look_up(self, schema, find):
        """The client's own lookup: find(schema) and, when it finds nothing, once more in the schema read again."""
        found = find(schema)
        if found is None and self.refresh_schema(schema):
            found = find(schema)
        return found

    def on_current_schema(self, schema, build, send, lacks=None, built=UNBUILT):
        """send(build()), a step built from `schema`, which may come from the cache. When Notion refuses it with a
        400 (a read changes nothing, and neither does a write answered 400), or lacks(step, result) finds that what
        came back does not hold a property the step reads, the schema is read again and the step built again; one
        that comes out different is run once more. A property that is still unknown then fails as any unknown
        property does, and a refusal that has another cause stands."""
        if built is UNBUILT:
            built = build()

        def rebuild():
            self.refresh_schema(schema)
            return build()

        try:
            result = send(built)
        except ApiError as refused:
            if refused.status != 400:
                raise
            try:
                again = rebuild()
            except ApiError:
                raise refused
            except Fail as failure:
                if failure.code != USAGE:
                    raise refused  # the schema could not be read again
                raise Unbuildable(failure)
            if again == built:
                raise refused
            return send(again)
        if lacks and lacks(built, result):
            again = rebuild()
            if again != built:
                return send(again)
        return result

    def refresh_data_sources(self):
        """The list of connected data sources re-read, at most once per command; None when it was already."""
        return None if self._list_fresh else self.data_sources(refresh=True)

    def disconnected(self, identifier):
        """Whether a data source that answered 403 or 404 is gone: the list of connected data sources, read from
        the API in this command, no longer holds it. One that is still listed refused, and that is never hidden."""
        self.refresh_data_sources()
        return not any(source['id'] == identifier for source in self.data_sources())

    def skip_note(self, identifier):
        self.warn(f'note: data source {identifier} is no longer connected (the list of data sources, read again, does '
                  'not hold it), so it was not searched')

    def data_sources(self, refresh=False):
        if not refresh and self._sources is not None:
            return self._sources
        listed = None if refresh else self.cache.get('data_sources')
        if listed is not None:
            return listed
        self._list_fresh = True
        found, _ = self.pages_of('POST', '/v1/search', {'filter': {'property': 'object', 'value': 'data_source'}})
        listed = []
        for source in found:
            if source.get('object') != 'data_source':
                continue
            if source.get('properties'):
                self.store_schema(source['id'], source)
                schema = source
            else:
                schema = self.data_source(source['id'], refresh=True)
            listed.append(listed_entry(source['id'], schema))
        self.cache.update('data_sources', lambda _: listed)  # not between another session's read and write of it
        self._sources = listed
        return listed

    def data_source_title(self, identifier):
        try:
            return plain(self.data_source(identifier).get('title')) or identifier
        except ApiError:
            return identifier

    def page_by_key(self, prefix, number):
        def prefixed(listed):
            return [s for s in listed or [] if (s.get('prefix') or '').upper() == prefix]

        queue = prefixed(self.data_sources()) or prefixed(self.refresh_data_sources())
        asked = set()
        while queue:
            source = queue.pop(0)
            asked.add(source['id'])
            try:
                rows = self.rows_by_key(source, number)
            except ApiError as failure:
                if failure.status not in (403, 404) or not self.disconnected(source['id']):
                    raise
                self.skip_note(source['id'])
                queue = [s for s in prefixed(self.data_sources()) if s['id'] not in asked]
                continue
            if rows:
                return rows[0]
        if not prefixed(self.data_sources()):
            known = sorted({s['prefix'] for s in self.data_sources() if s.get('prefix')})
            raise NoSuchKey(USAGE, f'no connected data source has the key prefix {prefix}; known prefixes: '
                                   f"{', '.join(known) or 'none'}")
        raise NoSuchKey(REFUSED, f'no page with key {prefix}-{number}')

    def rows_by_key(self, source, number):
        schema = {'id': source['id']}  # filled when the key property the cached list names no longer works

        def unique():
            return unique_of(schema['properties'])[1] if 'properties' in schema else source['unique']

        def ask(name):
            if name is None:  # the data source has no unique id any more
                return []
            return self.call('POST', f"/v1/data_sources/{source['id']}/query",
                             {'filter': {'property': name, 'unique_id': {'equals': number}}, 'page_size': 1}
                             ).get('results', [])

        return self.on_current_schema(schema, unique, ask)

    def resolve(self, text, want=None):
        """('page', page) or ('data_source', schema) for any reference form."""
        ref = parse_ref(text)
        if ref.kind == 'data_source':
            return 'data_source', self.get_data_source(ref.value)
        if ref.kind == 'key':
            try:
                return 'page', self.page_by_key(ref.prefix, ref.number)
            except Fail as failure:
                titled = self.data_source_titled(text)
                if titled and failure.code == USAGE:
                    return 'data_source', titled
                raise
        if ref.kind == 'title':
            titled = self.data_source_titled(text)
            if titled:
                return 'data_source', titled
            names = ', '.join(s['title'] for s in self.data_sources() if s['title'])
            raise Fail(USAGE, f'{text!r} is not a page id, a url, a key or the title of a connected data source '
                              f'({names or "none connected"}); to find a page by its words use `notion search`')
        identifier = ref.value
        kinds = self.cache.get('kinds') or {}
        order = ['page', 'data_source', 'database']
        if want == 'data_source' or kinds.get(identifier) in ('data_source', 'database'):
            order = ['data_source', 'database', 'page']
        last = None
        for kind in order:
            path = {'page': '/v1/pages/', 'data_source': '/v1/data_sources/', 'database': '/v1/databases/'}[kind] + identifier
            try:
                found = self.call('GET', path)
            except ApiError as error:
                if error.status == 403:
                    raise self.not_connected(identifier, error)
                if error.status in (400, 404):
                    last = error
                    continue
                raise
            if kinds.get(identifier) != kind:
                self.cache.update('kinds', lambda saved: dict(saved or {}, **{identifier: kind}))
            if kind == 'page':
                return 'page', found
            if kind == 'data_source':
                self.store_schema(identifier, found)
                return 'data_source', found
            sources = found.get('data_sources') or []
            if len(sources) == 1:
                return 'data_source', self.get_data_source(sources[0]['id'])
            listed = ', '.join(f"{s.get('name')} ({COLLECTION}{s['id']})" for s in sources) or 'none'
            raise Fail(USAGE, f'{identifier} is a database with {len(sources)} data sources; name one: {listed}')
        raise self.not_connected(identifier, last)

    def get_data_source(self, identifier, refresh=False):
        """A data source the command was pointed at: one that cannot be read says how to connect it."""
        try:
            return self.data_source(identifier, refresh=refresh)
        except ApiError as error:
            if error.status in (403, 404):
                raise self.not_connected(identifier, error)
            raise

    def of_data_source(self, schema, ask):
        """ask(), a request about a data source whose schema may come from the cache. When it is answered 403 or
        404 the schema is read from the API: a data source that is gone then fails as it does with nothing cached,
        and one that can be read keeps the API's own refusal."""
        try:
            return ask()
        except ApiError as refused:
            if refused.status in (403, 404):
                self.refresh_schema(schema)
            raise

    def data_source_titled(self, text):
        def find(listed):
            return next((s for s in listed if fold(s['title']) == fold(text)), None)

        found = find(self.data_sources())
        if found is None:  # a data source connected after the list was cached
            found = find(self.refresh_data_sources() or [])
        return self.get_data_source(found['id']) if found else None

    def page(self, text):
        kind, found = self.resolve(text)
        if kind != 'page':
            raise Fail(USAGE, f'{text} is a data source, not a page')
        return found

    def schema_for(self, page):
        source = page.get('parent', {}).get('data_source_id')
        if source:
            return self.get_data_source(source)
        return {'object': 'page_parent', 'title': [], 'properties': {'title': {'id': 'title', 'name': 'title', 'type': 'title'}}}

    # -- reading values -------------------------------------------------------------------

    def short_values(self, page, names=None):
        """The page's properties in the short format, in the page's order, links in text as [text](url)."""
        values = {}
        for name, prop in page.get('properties', {}).items():
            if names is not None and name not in names:
                continue
            for key, value in self.short(name, prop, page['id']):
                values[key] = value
        return values

    def short(self, name, prop, page_id):
        kind = prop.get('type')
        value = prop.get(kind)
        label = short_label(name)
        if kind in ('title', 'rich_text'):
            return [(label, linked(value))]
        if kind in ('select', 'status'):
            return [(label, value.get('name') if value else None)]
        if kind == 'multi_select':
            return [(label, [o.get('name') for o in value or []])]
        if kind == 'date':
            start = (value or {}).get('start')
            return [(f'date:{name}:start', start), (f'date:{name}:end', (value or {}).get('end')),
                    (f'date:{name}:is_datetime', 1 if start and 'T' in start else 0)]
        if kind == 'people':
            return [(label, [self.person_ref(u) for u in value or []])]
        if kind in ('created_by', 'last_edited_by'):
            return [(label, self.person_ref(value) if value else None)]
        if kind == 'relation':
            related = [r['id'] for r in value or []]
            if prop.get('has_more'):
                related = self.all_relations(page_id, prop['id'])
            return [(label, [page_link(r) for r in related])]
        if kind == 'checkbox':
            return [(label, '__YES__' if value else '__NO__')]
        if kind == 'unique_id':
            value = value or {}
            number = value.get('number')
            return [(label, f"{value['prefix']}-{number}" if value.get('prefix') and number is not None else number)]
        if kind == 'formula':
            result = (value or {}).get((value or {}).get('type'))
            return [(label, result.get('start') if isinstance(result, dict) else result)]
        if kind == 'rollup':
            rollup = value or {}
            inner = rollup.get(rollup.get('type'))
            if rollup.get('type') == 'array':
                inner = [self.short(name, item, page_id)[0][1] for item in inner or []]
            elif isinstance(inner, dict):
                inner = inner.get('start')
            return [(label, inner)]
        if kind == 'files':
            return [(label, [f.get('name') or (f.get(f.get('type')) or {}).get('url') for f in value or []])]
        if kind == 'verification':
            return [(label, (value or {}).get('state'))]
        if kind == 'button':
            return []
        return [(label, value)]

    def all_relations(self, page_id, prop_id):
        related, cursor = [], None
        while True:
            query = {'page_size': 100}
            if cursor:
                query['start_cursor'] = cursor
            answer = self.call('GET', f'/v1/pages/{page_id}/properties/{prop_id}', query=query)
            related += [item['relation']['id'] for item in answer.get('results', []) if item.get('relation')]
            if not answer.get('has_more') or not answer.get('next_cursor'):
                return related
            cursor = answer['next_cursor']

    def key_of(self, page):
        for prop in page.get('properties', {}).values():
            if prop.get('type') == 'unique_id':
                value = prop.get('unique_id') or {}
                if value.get('prefix') and value.get('number') is not None:
                    return f"{value['prefix']}-{value['number']}"
                return str(value.get('number', ''))
        return ''

    def title_of(self, page):
        for prop in page.get('properties', {}).values():
            if prop.get('type') == 'title':
                return plain(prop.get('title'))
        return ''

    def parent_label(self, page):
        parent = page.get('parent', {})
        if parent.get('type') == 'data_source_id':
            source = parent['data_source_id']
            return f'data source {self.data_source_title(source)} ({COLLECTION}{source})'
        if parent.get('type') == 'page_id':
            return f"page {page_link(parent['page_id'])}"
        if parent.get('type') == 'block_id':
            return f"block {parent['block_id']}"
        return parent.get('type', 'workspace')

    def markdown(self, page_id):
        return self.call('GET', f'/v1/pages/{page_id}/markdown', query={'markdown_version': MARKDOWN_VERSION})

    def discussions(self, page_id):
        comments, _ = self.pages_of('GET', '/v1/comments', query={'block_id': page_id})
        threads = {}
        for comment in comments:
            threads.setdefault(comment.get('discussion_id'), []).append(comment)
        return threads

    def author(self, comment):
        shown = comment.get('display_name') or {}
        if shown.get('resolved_name'):
            return shown['resolved_name']
        creator = (comment.get('created_by') or {}).get('id')
        return self.user_name(creator) or f'user://{creator}'

    # -- writing values -------------------------------------------------------------------

    def property_name(self, wanted, page_schema, quiet):
        """The schema's name for `wanted`; None (quiet) or a USAGE failure naming the nearest names."""
        properties = page_schema['properties']
        if wanted in properties:
            return wanted
        for name in properties:
            if name.casefold() == wanted.casefold():
                return name
        if wanted.casefold() in ('title', 'name'):
            for name, prop in properties.items():
                if prop.get('type') == 'title':
                    return name
        if quiet:
            return None
        close = nearest(wanted, list(properties))
        hint = f"did you mean {' or '.join(close)}?" if close else f"properties: {', '.join(properties)}"
        raise Fail(USAGE, f'no property {wanted!r} here; {hint}')

    def build_properties(self, assignments, page_schema, page=None):
        """Short-format `Prop=value` strings -> the API's typed property values. Sends nothing."""
        dates, out = {}, {}
        for raw in assignments:
            if '=' not in raw:
                raise Fail(USAGE, f'--set takes Prop=value, got {raw!r}')
            left, value = raw.split('=', 1)
            left = left.strip()
            field = None
            date_key = re.fullmatch(r'date:(.+):(start|end|is_datetime)', left)
            if date_key:
                left, field = date_key.group(1), date_key.group(2)
            if left.startswith('userDefined:'):
                left = left[len('userDefined:'):]
            name = self.look_up(page_schema, lambda schema: self.property_name(left, schema, quiet=True))
            name = name or self.property_name(left, page_schema, quiet=False)
            prop = page_schema['properties'][name]
            kind = prop.get('type')
            if kind == 'date':
                dates.setdefault(name, {})[field or 'start'] = value.strip()
                continue
            if field:
                raise Fail(USAGE, f'{name} is a {kind} property, not a date')
            out[name] = self.typed(name, prop, value, page_schema)
        for name, fields in dates.items():
            out[name] = self.typed_date(name, fields, page)
        return out

    def option(self, name, prop, value, page_schema):
        kind = prop['type']

        def options(schema):
            return [o['name'] for o in ((schema['properties'].get(name) or {}).get(kind) or {}).get('options', [])]

        found = self.look_up(page_schema, lambda schema: next(
            (o for o in options(schema) if o.casefold() == value.casefold()), None))
        if found is not None:
            return found
        self.property_name(name, page_schema, quiet=False)  # the schema read again may not hold the property at all
        raise Fail(USAGE, f"unknown option {value!r} for the {kind} property {name}; options: "
                          f"{', '.join(options(page_schema))}")

    def typed(self, name, prop, value, page_schema):
        kind = prop.get('type')
        empty = value.strip() in ('', 'null', 'none')
        if kind in ('title', 'rich_text'):
            return {kind: linked_text(value)}
        if kind == 'number':
            return {'number': None if empty else number_of(value.strip(), name)}
        if kind in ('select', 'status'):
            return {kind: None if empty else {'name': self.option(name, prop, value.strip(), page_schema)}}
        if kind == 'multi_select':
            return {kind: [] if empty else [{'name': self.option(name, prop, v, page_schema)} for v in split_list(value)]}
        if kind == 'checkbox':
            word = value.strip().casefold()
            if word in ('__yes__', 'true', 'yes', '1', 'checked', 'x'):
                return {'checkbox': True}
            if word in ('__no__', 'false', 'no', '0', 'unchecked', ''):
                return {'checkbox': False}
            raise Fail(USAGE, f'{name} is a checkbox: write __YES__ or __NO__, not {value!r}')
        if kind == 'people':
            return {'people': [] if empty else [{'id': self.person_id(v)} for v in split_list(value)]}
        if kind == 'relation':
            return {'relation': [] if empty else [{'id': self.page_id_of(v)} for v in split_list(value)]}
        if kind in ('url', 'email', 'phone_number'):
            return {kind: None if empty else value.strip()}
        if kind == 'files':
            files = []
            for item in ([] if empty else split_list(value)):
                if item.startswith('file-upload://'):
                    files.append({'type': 'file_upload', 'file_upload': {'id': hyphenate(item) or item[14:]}})
                else:
                    files.append({'type': 'external', 'name': item.rsplit('/', 1)[-1][:100] or 'file', 'external': {'url': item}})
            return {'files': files}
        if kind in ('formula', 'rollup', 'created_time', 'created_by', 'last_edited_time', 'last_edited_by', 'unique_id', 'button'):
            raise Fail(USAGE, f'{name} is a {kind} property: Notion computes it, it cannot be written')
        raise Fail(USAGE, f'{name} is a {kind} property; write it with `notion api PATCH /v1/pages/<id>` and the API shape')

    def typed_date(self, name, fields, page):
        start, end = (None if fields.get(field) is None else fields[field].strip() for field in ('start', 'end'))
        if start is not None and no_date(start):
            return {'date': None}
        current = ((page or {}).get('properties', {}).get(name) or {}).get('date') or {}
        start_kept, end_kept = start is None, end is None
        if start_kept and not end_kept:
            start = current.get('start')
            if not start:
                raise Fail(USAGE, f'date:{name}:end needs a start: the page has none, so pass date:{name}:start too')
        if start is None:
            raise Fail(USAGE, f'date:{name} needs :start')
        value = {'start': start}
        if end_kept:  # only :start given: move the start, keep the range and its time zone
            end = current.get('end')
            if current.get('time_zone') and 'T' in start:
                value['time_zone'] = current['time_zone']
        if end and not no_date(end):
            if ends_before_it_starts(start, end, current.get('time_zone') if start_kept or end_kept else None):
                said = (f'the new start {start} is after the end the property keeps, {end}' if end_kept and end
                        else f'the new end {end} is before the start the property keeps, {start}' if start_kept
                        else f'the start {start} is after the end {end}')
                raise Fail(USAGE, f'date:{name}: {said}; nothing was sent. Set the end with date:{name}:end=<date>, on or '
                                  f'after the start, or clear it with date:{name}:end= (an empty value)')
            value['end'] = end
        return {'date': value}

    def person_id(self, text):
        text = re.sub(r'\s*\([^)]*\)\s*$', '', text.strip())
        if text.casefold() == 'me':
            return self.me()['id']
        if text.startswith('user://') or UUID_RE.fullmatch(text):
            return hyphenate(text)
        matches = self.find_people(text)
        if len(matches) == 1:
            return matches[0][0]
        if not matches:
            raise Fail(USAGE, f'nobody matches {text!r} among the people the API lists and the people seen in rows '
                              'read; nothing was sent')
        names = '; '.join(', '.join(filter(None, [p.get('name'), p.get('email'), f'user://{i}'])) for i, p in matches)
        raise Fail(USAGE, f'{text!r} matches {len(matches)} people: {names}. Nothing was sent; pass the user:// id '
                          'of the one you mean')

    def page_id_of(self, text):
        ref = parse_ref(text)
        if ref.kind == 'id':
            return ref.value
        if ref.kind == 'key':
            return self.page_by_key(ref.prefix, ref.number)['id']
        raise Fail(USAGE, f'{text!r} is not a page reference')

    def everyone(self):
        """The people the API lists plus the people seen in rows read (the cache), listed once per run."""
        if self._listed is None:
            self._listed = self.list_users()
        return self._listed

    def find_people(self, text):
        """Every person whose name or e-mail contains `text`, over the listed users and the cache; an exact
        e-mail match is the one person meant, never an ambiguity."""
        needle = fold(text)
        people, reason = self.everyone()
        self.warn_unlisted(reason)
        exact = [(i, p) for i, p in people.items() if needle and fold(p.get('email')) == needle]
        if len(exact) == 1:
            return exact
        return [(i, p) for i, p in people.items() if needle in fold(p.get('name')) or needle in fold(p.get('email'))]


def no_date(value):
    """Whether what was written for a date stands for none. The documented form is the empty value; `null`, as an
    empty end is printed, and `none` are read as it and never sent as a date."""
    return value.strip().casefold() in ('', 'null', 'none')


def ends_before_it_starts(start, end, zone=None):
    """Whether a date range ends before it starts. A plain date is its whole day, so against one only the days
    are compared; a time with no offset is in the range's time zone, else UTC. False for what is not a date,
    which Notion judges."""
    try:
        first, last = (datetime.date.fromisoformat(v) if len(v) == 10
                       else datetime.datetime.fromisoformat(v.replace('Z', '+00:00')) for v in (start, end))
    except ValueError:
        return False
    if not (isinstance(first, datetime.datetime) and isinstance(last, datetime.datetime)):
        first, last = (m.date() if isinstance(m, datetime.datetime) else m for m in (first, last))
        return last < first
    try:
        local = zoneinfo.ZoneInfo(zone) if zone else datetime.timezone.utc
    except (ValueError, zoneinfo.ZoneInfoNotFoundError):
        local = datetime.timezone.utc
    first, last = (m if m.tzinfo else m.replace(tzinfo=local) for m in (first, last))
    return last < first


def unique_of(properties):
    for name, prop in properties.items():
        if prop.get('type') == 'unique_id':
            return (prop.get('unique_id') or {}).get('prefix'), name
    return None, None


def short_label(name):
    """The short format's key for a property: `id` and `url` are the page's own, so a property of one of those
    names (any case) is under userDefined:<name>."""
    return f'userDefined:{name}' if name.lower() in ('id', 'url') else name


def value_named(values, name):
    """The value of the property `name` among short_values(), whatever key the short format gives it; a date's
    is its start."""
    return next((values[key] for key in (short_label(name), f'date:{name}:start') if key in values), None)


def listed_entry(identifier, schema):
    """What the list of connected data sources keeps of one."""
    prefix, unique = unique_of(schema['properties'])
    return {'id': identifier, 'title': plain(schema.get('title')), 'prefix': prefix, 'unique': unique}


def icon_of(value):
    if value is None:
        return None
    if value.casefold() == 'none':
        return 'none'
    if re.match(r'https?://', value):
        return {'type': 'external', 'external': {'url': value}}
    return {'type': 'emoji', 'emoji': value}


# ---------------------------------------------------------------------------------------------
# fetch
# ---------------------------------------------------------------------------------------------


def schema_lines(client, schema, budget=SCHEMA_BUDGET):
    props = schema.get('properties', {})
    prefix, unique = unique_of(props)
    head = [f"data source: {plain(schema.get('title')) or UNTITLED}", f"ref: {COLLECTION}{schema['id']}"]
    database = (schema.get('parent') or {}).get('database_id')
    if database:
        head.append(f'database: {database}')
    if unique:
        head.append(f'key prefix: {prefix} ({unique})' if prefix else f'key: {unique} (no prefix)')
    head.append(f'properties ({len(props)}):')
    shown = {}
    for name, prop in props.items():
        kind = prop.get('type')
        options = [o['name'] for o in (prop.get(kind) or {}).get('options', [])] if kind in ('status', 'select', 'multi_select') else None
        shown[name] = [kind, options, None]
        if kind == 'relation':
            target = (prop.get('relation') or {}).get('data_source_id')
            shown[name][2] = f' -> {COLLECTION}{target}' if target else ''
        elif kind == 'unique_id':
            shown[name][2] = f" (prefix {(prop.get('unique_id') or {}).get('prefix') or 'none'}, read-only)"
        elif kind in ('formula', 'rollup', 'created_time', 'created_by', 'last_edited_time', 'last_edited_by', 'button'):
            shown[name][2] = ' (read-only)'

    def render():
        lines = list(head)
        for name, (kind, options, extra) in shown.items():
            line = f'- {name}: {kind}'
            if options is not None:
                line += ': ' + ' | '.join(options)
            lines.append(line + (extra or ''))
        return lines

    lines = render()
    trimmable = [n for n, (k, o, _) in shown.items() if k in ('select', 'multi_select') and o]
    while len('\n'.join(lines)) > budget and trimmable:
        name = max(trimmable, key=lambda n: len(' | '.join(shown[n][1])))
        kind, options, extra = shown[name]
        keep = max(3, len(options) // 2)
        hidden = len(options) - keep
        shown[name] = [kind, options[:keep], f' | +{hidden} more (notion fetch --json lists them)']
        trimmable.remove(name)
        lines = render()
    return lines


def cmd_fetch(client, args):
    kind, found = client.resolve(args.ref)
    if kind == 'data_source':
        client.refresh_schema(found)  # the schema a write is built from is read from the API, whatever the reference form
        if args.json:
            client.emit(found)
        else:
            client.say('\n'.join(schema_lines(client, found)))
        return DONE
    page = found
    body = None if args.props_only else client.markdown(page['id'])
    threads = client.discussions(page['id']) if args.discussions else None
    if args.json:
        client.emit({'page': page, 'markdown': body, 'discussions': threads})
        return DONE
    lines = [f'title: {client.title_of(page)}', f"url: {page.get('url')}", f"id: {page['id']}"]
    key = client.key_of(page)
    if key:
        lines.append(f'key: {key}')
    lines.append(f'parent: {client.parent_label(page)}')
    icon = page.get('icon') or {}
    if icon.get('type') == 'emoji':
        lines.append(f"icon: {icon['emoji']}")
    if page.get('in_trash'):
        lines.append('in trash: yes')
    lines.append('properties:')
    lines.append(json.dumps(client.short_values(page), ensure_ascii=False, indent=2))
    if body is not None:
        lines.append('body:')
        lines.append(body.get('markdown') or '(empty body)')
        if body.get('truncated'):
            lines.append(f"(truncated: {len(body.get('unknown_block_ids') or [])} blocks not loaded; "
                         'fetch each id in unknown_block_ids with `notion api GET /v1/pages/<id>/markdown`)')
    if threads is not None:
        lines.append('discussions:' if threads else 'discussions: none open')
        for discussion, comments in threads.items():
            lines.append(f'- discussion {discussion}')
            for comment in comments:
                said = linked(comment.get('rich_text')) or '(attachment only)'
                lines.append(f'  {client.author(comment)}: {said}')
    client.say('\n'.join(lines))
    return DONE


# ---------------------------------------------------------------------------------------------
# update, trash
# ---------------------------------------------------------------------------------------------

PLACEHOLDER = 'https://file-upload.invalid/'
MEDIA = ('image', 'file', 'pdf', 'audio', 'video')
_LINE_MARK = re.compile(r' *(>|(?:[-*+]|\d{1,9}[.)])(?= |$))')
_FENCE = re.compile(r'(`{3,})[^`]*$|(~{3,})')


def body_lines(markdown):
    """[line, fence] for each line of a body: fence is None for a line of text, and one dict for every line of a
    block of code (fenced by ``` or ~~~) or of a display equation ($$), its own marks included. A fence ends at its
    closing mark, where the quote or the list item it stands in ends, or at the end of the body (`closed` False)."""
    lines, fence, items = markdown.split('\n'), None, []  # items: the column of the text of each list item it is in
    out = []
    for number, line in enumerate(lines):
        text = line.rstrip('\r').expandtabs(4)
        if fence:
            state = within_fence(fence, text)
            fence['closed'] = state != 'code'
            if state != 'out':
                out.append([line, fence])
                fence = None if state == 'end' else fence
                continue
            fence = None
        at, quotes, marks, first, mark = 0, 0, [], None, _LINE_MARK.match(text)
        while mark:
            first = mark.start(1) if first is None else first
            if mark.group(1) == '>':
                quotes += 1
            else:
                marks.append(mark.end() + 1)
            at = mark.end()
            mark = _LINE_MARK.match(text, at)
        rest = text[at:].lstrip(' ')
        column = len(text) - len(rest)
        if text.strip():
            edge = column if first is None else first
            items = [item for item in items if item <= edge] + marks
        item = max((c for c in items if c <= column), default=0)
        opens = _FENCE.match(rest) if column - max(item, at) < 4 else None
        if opens:
            run = opens.group(1) or opens.group(2)
            fence = {'mark': run[0], 'size': len(run), 'column': column, 'quotes': quotes, 'item': item}
        elif rest.strip() == '$$' and any(later.strip(' \t\r>') == '$$' for later in lines[number + 1:]):
            fence = {'mark': '$', 'size': 2, 'column': column, 'quotes': quotes, 'item': item}
        if fence:
            fence.update(closed=False, line=number + 1)
        out.append([line, fence])
    return out


def within_fence(fence, text):
    """What a line is to the fence that is open: 'code', its 'end', or 'out' of the quote or item it stood in."""
    at = 0
    for _ in range(fence['quotes']):
        mark = re.compile(' *>').match(text, at)
        if not mark:
            return 'out'
        at = mark.end()
    said = text[at:].strip()
    column = len(text) - len(text[at:].lstrip(' '))
    if not said:
        return 'code'
    if column < fence['item']:
        return 'out'
    if set(said) == {fence['mark']} and len(said) >= fence['size'] and (fence['mark'] != '$' or said == '$$'):
        return 'end' if column <= fence['column'] + 3 else 'code'
    return 'code'


def code_spans(text):
    """(start, end) of each piece of inline code: between two runs of as many backticks, over lines too, as Notion
    reads them, and between <code> and </code>."""
    runs, by_size = [(m.start(), m.end()) for m in re.finditer('`+', text)], {}
    for start, end in runs:
        by_size.setdefault(end - start, []).append(start)
    spans, at = [], 0
    for start, end in runs:
        if start < at:
            continue
        slashes = 0
        while start - slashes > at and text[start - slashes - 1] == '\\':
            slashes += 1
        start += slashes % 2  # an escaped backtick is text
        size = end - start
        closing = by_size.get(size, [])
        place = bisect.bisect_left(closing, end)
        if size and place < len(closing):
            at = closing[place] + size
            spans.append((start, at))
    at = text.find('<code>')
    while at >= 0:
        end, line = text.find('</code>', at), text.find('\n', at)
        if end < 0:
            break
        if line < 0 or end < line:
            spans.append((at, end))
        at = text.find('<code>', end if line < 0 or end < line else line)
    return spans


# An uploaded file in a body, as `notion upload` prints it: ![name](file-upload://<id>) or <file source="file-upload://<id>">
# name</file>. The markdown endpoints do not know that address: they store an empty block. So it is sent as an address of
# the placeholder host that carries the upload's id, which Notion stores as it is, and each block that holds one is then
# given the uploaded file. Only a block of its own can hold a file, so a reference anywhere else is refused before
# anything is sent; code is text.
BodyFile = collections.namedtuple('BodyFile', 'id name stale line')  # stale: written as a placeholder, not as file-upload://
_FILE_ADDRESS = r'(?:(?i:file-upload://)|https://file-upload\.invalid/)' + UUID_RE.pattern
FILE_ADDRESS = re.compile(_FILE_ADDRESS)
_MARKS = r'(?:[ \t>]|[-*+][ \t]|\d{1,9}[.)][ \t])*'
IMAGE_LINE = re.compile(r'[ \t>]*!\[(?P<name>(?:\\.|[^\[\]\\]|\[(?:\\.|[^\[\]\\])*\])*)\]\(\s*<?(?P<address>' + _FILE_ADDRESS
                        + r')>?(?:\s+(?:"[^"]*"|\'[^\']*\'|\([^()]*\)))?\s*\)\s*')
TAG_LINE = re.compile(_MARKS + r'<(?P<tag>image|img|file|pdf|audio|video)\s(?:[^<>]*?\s)?(?:source|src)\s*=\s*'
                      r'(?P<address>"\s*' + _FILE_ADDRESS + r'\s*"|\'\s*' + _FILE_ADDRESS + r'\s*\')(?P<after>[^<>]*)>(?P<rest>.*?)\s*')
BAD_FILE_ADDRESS = re.compile(r'(?:\]\(\s*<?|\b(?:source|src)\s*=\s*["\']?\s*)(?P<address>(?i:file-upload)://)(?!' + UUID_RE.pattern + ')')
PLACE_EDIT = (re.compile(r'\s*' + re.escape('https://file-upload.invalid/') + UUID_RE.pattern + r'\s*'),
              re.compile(r'\s*(?i:file-upload://)' + UUID_RE.pattern + r'\s*'))


def file_line(line):
    """The match of a line that is one uploaded file and nothing else, in a form Notion makes a block of; else None."""
    found = IMAGE_LINE.fullmatch(line)
    if found:
        return found
    found = TAG_LINE.fullmatch(line)
    if not found:
        return None
    closing, rest = f"</{found.group('tag')}>", found.group('rest')
    if found.group('after').rstrip().endswith('/'):
        return found if not rest else None
    return found if closing not in rest or rest.index(closing) == len(rest) - len(closing) else None


def hold_files(markdown, where):
    """(the markdown with each uploaded file's address as its placeholder, the files in it). A reference that Notion
    would not make a block of, or one inside code that nothing closes, is refused: Fail(USAGE), nothing sent."""
    if 'file-upload' not in markdown.lower():
        return markdown, []

    def refuse(number, said, why):
        raise Fail(USAGE, f'{where}, line {number}: {said} {why}; nothing was sent')

    rows, files, table = body_lines(markdown), [], False
    for number, (line, fence) in enumerate(rows, 1):
        if fence and not fence['closed'] and FILE_ADDRESS.search(line):
            refuse(number, FILE_ADDRESS.search(line).group(), f"stands in the code that line {fence['line']} opens and nothing closes")
    first = 0
    while first < len(rows):
        last = first
        while last < len(rows) and rows[last][1] is None:
            last += 1
        text, base = '\n'.join(line for line, _ in rows[first:last]), 0
        spans = code_spans(text)

        def code_at(place):
            return next((span for span in spans if span[0] <= place < span[1]), None)

        for index in range(first, last):
            line, number, own = rows[index][0], index + 1, None
            found = file_line(line)
            if found:
                own = FILE_ADDRESS.search(line, found.start('address'))
                span = code_at(base + own.start())
                if span:
                    opened = first + 1 + text.count('\n', 0, span[0])
                    refuse(number, own.group(), f'is inside the inline code that a backtick on line {opened} opens, so Notion would '
                                                'keep it as text: close or escape (\\`) that backtick')
                if table:
                    refuse(number, own.group(), 'stands in a table: a cell holds only text, so Notion cannot show a file there')
            for other in FILE_ADDRESS.finditer(line):
                if (own is None or other.start() != own.start()) and not code_at(base + other.start()):
                    refuse(number, other.group(), 'is not on a line of its own. Notion makes a file only of a block: write '
                           '![name](file-upload://<id>) or <file source="file-upload://<id>">name</file> alone on its line, with a '
                           'blank line before and after (it refuses an image inside a sentence, a heading, a list item or a table cell, '
                           'and keeps a tag there as text), or write it as code, `file-upload://…`, when it is only text')
            for bad in BAD_FILE_ADDRESS.finditer(line):
                if not code_at(base + bad.start('address')):
                    refuse(number, line[bad.start('address'):][:60].split()[0], 'is not the address of an upload: it is file-upload:// and the '
                           'id `notion upload` printed')
            for tag in re.finditer(r'(?<!\\)<(/?)table\b', line):
                if not code_at(base + tag.start()):
                    table = not tag.group(1)
            base += len(line) + 1
            if found:
                upload = hyphenate(own.group())
                name = (found.groupdict().get('name') or (found.groupdict().get('rest') or '').split('</')[0]).strip()
                files.append(BodyFile(upload, name, own.group().startswith(PLACEHOLDER), number))
                quote = '"' if 'tag' in found.groupdict() else ''
                rows[index][0] = line[:found.start('address')] + quote + PLACEHOLDER + upload + quote + line[found.end('address'):]
        first = last + 1
    return '\n'.join(line for line, _ in rows), files


def refuse_placeholders(held):
    """Refuse a body that holds the placeholder of a file this command does not supply: it was read back after a
    file could not be placed, and written as it is it would stay an address that shows nothing."""
    given = {file.id for _, files in held for file in files if not file.stale}
    for where, files in held:
        for file in files:
            if file.stale and file.id not in given:
                raise Fail(USAGE, f'{where}, line {file.line}: {PLACEHOLDER}{file.id} is the address this client leaves where an '
                                  f'uploaded file was not placed, and nothing is there. Write file-upload://{file.id} in its place (upload '
                                  'the file again when that was over an hour ago, and write its new id), or take the line out; '
                                  'nothing was sent')


def placeholders(client, page_id, ids):
    """(the media blocks of a page that hold the placeholder of one of `ids`, the other blocks that hold one, the
    media blocks that hold another upload's), each as (block id, type, upload id)."""
    found, stuck, foreign, queue, seen = [], [], [], [page_id], set()
    while queue:
        for block in children_of(client, queue.pop(0)):
            kind = block.get('type')
            if block.get('id') in seen:
                continue  # a synced block shows the same blocks twice
            seen.add(block.get('id'))
            content = block.get(kind) or {}
            url = (content.get('external') or {}).get('url') or ''
            if kind in MEDIA and url.startswith(PLACEHOLDER) and hyphenate(url):
                (found if hyphenate(url) in ids else foreign).append((block['id'], kind, hyphenate(url)))
            elif PLACEHOLDER in json.dumps(content):
                held = {hyphenate(m.group()) for m in re.finditer(re.escape(PLACEHOLDER) + UUID_RE.pattern, json.dumps(content))}
                stuck += [(block['id'], kind, upload) for upload in ids if upload in held]
            if block.get('has_children') and kind not in ('child_page', 'child_database'):
                queue.append(block['id'])
    return found, stuck, foreign


def place_command(where, upload):
    return f"`notion update {where} --edit '{PLACEHOLDER}{upload}' 'file-upload://{upload}'`"


def files_left(where, files, uploads, sure=True):
    """The sentence that says which files are not on the page (`sure`), or may not be, and the command that places each."""
    names = {file.id: file.name for file in files}
    uploads = list(dict.fromkeys(uploads))
    return (f"The page {'still holds' if sure else 'may still hold'} the placeholder of "
            f"{', '.join(file_label(names.get(u, ''), u) for u in uploads)} and not the file; place it with "
            f"{', '.join(place_command(where, u) for u in uploads)} (it says that no edit matched when the file is already there; "
            'when the upload was over an hour ago, upload the file again and put its new id in the second part)')


def file_label(name, upload):
    return f'file {name!r} ({upload})' if name else f'file {upload}'


def place_files(client, page_id, files, landed, where, rest=(), then='', misses=()):
    """Give each block that holds a placeholder of these files its file, then read the page again: none may be left.
    Each block is one write; `landed` grows with each, and a failure is report_writes' (rest: the writes of the
    command still to come, then: what to do about them once the files are there)."""
    names = {file.id: file_label(file.name, file.id) for file in reversed(files)}
    every = list(dict.fromkeys(file.id for file in files))

    def report(label, failure, pending, uploads, more=()):
        advice = [files_left(where, files, uploads, sure=failure.outcome in (NOT_SENT, REFUSED_WRITE))] if uploads else []
        raise report_writes('update', landed, label, failure, [*pending, *rest], where=where, misses=misses,
                            finish='. '.join(advice + list(more) + ([then] if then else [])))

    try:
        found, _, _ = placeholders(client, page_id, every)
    except Fail as failure:
        report(', '.join(names[u] for u in every), Fail(failure.code, outcome=NOT_SENT, cause='the page could not be read to place '
               f'them: {failure.cause}'), [], every)
    for number, (block, kind, upload) in enumerate(found):
        try:
            client.call('PATCH', f'/v1/blocks/{block}', {kind: {'file_upload': {'id': upload}}})
        except Fail as failure:
            later = [f'{names[u]} in block {b}' for b, _, u in found[number + 1:]]
            lost = [u for u in every if u not in {u for _, _, u in found}]
            report(f'{names[upload]} in block {block}', failure, later + [names[u] for u in lost],
                   [upload, *(u for _, _, u in found[number + 1:]), *lost])
        landed.append(f'{names[upload]} placed in block {block}')
    try:
        left, stuck, foreign = placeholders(client, page_id, every)
    except Fail as failure:
        raise Fail(PARTIAL, f"done in part on {where}: written: {'; '.join(landed)}. Not confirmed: the page could not be read again to "
                            f'check that no placeholder is left ({failure.cause}). Fetch it: if {PLACEHOLDER} is in its body, run '
                            f"{', '.join(place_command(where, u) for u in every)}"
                            + (f"; not sent: {'; '.join(rest)}" if rest else '')
                            + (f"; edits that did not apply: {'; '.join(misses)}" if misses else '') + (f'. {then}' if then else ''))
    counts = {u: sum(1 for file in files if file.id == u) for u in every}
    missing = [u for u in every if sum(1 for _, _, f in [*found, *stuck] if f == u) < counts[u]]
    unplaced = list(dict.fromkeys([u for _, _, u in stuck] + missing))
    why = '; '.join([f'{names[u]} stands in a {kind} block ({block}), which cannot hold a file' for block, kind, u in stuck]
                    + [f'the body holds {names[u]} {counts[u]} times and fewer blocks of the page do' if counts[u] > 1
                       else f'no block of the page holds {names[u]}' for u in missing])
    add = [f'Add it on a line of its own: put `![{file.name}](file-upload://{file.id})` in a file F and run `notion update {where} '
           '--append-file F`, and take the placeholder out of the block above' for file in {f.id: f for f in files if f.id in unplaced}.values()]
    if left:
        report(', '.join(f'{names[u]} in block {b}' for b, _, u in left), Fail(REFUSED, outcome=IN_DOUBT, cause='Notion answered that '
               'the block took it, and the block read again still holds the placeholder'), [names[u] for u in unplaced],
               [u for _, _, u in left], add)
    if unplaced:
        report(', '.join(names[u] for u in unplaced), Fail(REFUSED, outcome=NOT_SENT, cause=why), [], [], add)
    client.say(f'uploaded files placed: {len(found)}')
    for block, _, upload in foreign:
        client.warn(f'warning: block {block} of {where} holds the placeholder of another upload ({upload}), which an earlier command did '
                    f"not place: upload that file again and run `notion update {where} --edit '{PLACEHOLDER}{upload}' 'file-upload://<new id>'`")


CHILD_TAG = re.compile(r'<(page|database)\s+url="([^"]+)"[^>]*>(.*?)</\1>', re.S)


def cmd_update(client, args):
    body_flags = [f for f in (args.replace_file, args.append_file, args.prepend_file) if f]
    if args.replace_file and (args.edit or args.append_file or args.prepend_file):
        raise Fail(USAGE, '--replace-file rewrites the whole body: do not combine it with --edit, --append-file or --prepend-file')
    if not (args.set or args.edit or body_flags or args.icon):
        raise Fail(USAGE, 'nothing to change: pass --set, --edit, --replace-file, --append-file, --prepend-file or --icon')
    page = client.page(args.ref)
    files = {flag: read_file(path) for flag, path in (('replace', args.replace_file), ('append', args.append_file),
                                                     ('prepend', args.prepend_file)) if path}
    schema = client.schema_for(page) if args.set else None

    def build():
        return client.build_properties(args.set, schema, page)

    properties = build() if args.set else {}
    held = {}  # the uploaded files of each part of the body
    for flag in files:
        files[flag], held[flag] = hold_files(files[flag], f"--{flag}-file {getattr(args, flag + '_file')}")
    edits = []
    for number, (old, new) in enumerate(args.edit or [], 1):
        if PLACE_EDIT[0].fullmatch(old) and PLACE_EDIT[1].fullmatch(new):  # the placeholder for a file: it is placed
            old, new = old.strip(), PLACEHOLDER + hyphenate(new)
            held[number] = [BodyFile(hyphenate(new), '', False, 1)]
        else:
            new, held[number] = hold_files(new, f'--edit {number}')
        edits.append((number, old, new))
    refuse_placeholders([(f'--{part}-file' if part in files else f'--edit {part}', found) for part, found in held.items()])
    current = None
    if args.edit or 'replace' in files:
        current = client.markdown(page['id']).get('markdown', '')
    plan = []
    if args.edit:
        for number, old, new in edits:
            count = current.count(old)
            one = count == 1 or (count and old == new and held[number])  # a file goes to every block that waits for it
            plan.append((number, old, new, 'matched' if one else ('no match' if count == 0 else f'matches {count} places')))
        if not any(state == 'matched' for *_, state in plan):
            for number, old, _, state in plan:
                client.say(f'edit {number}: {state}')
            missed = '; '.join(f'edit {n}: {old[:80]!r} ({state})' for n, old, _, state in plan)
            raise Fail(REFUSED, f'no edit matched the body, so nothing was changed: {missed}. '
                                'Fetch the page and copy OLD from its current text')
    if 'replace' in files:
        dropped = [(kind, title) for kind, url, title in CHILD_TAG.findall(current) if url not in files['replace']]
        if dropped and not args.allow_deleting_content:
            listed = ', '.join(f'{kind} "{title.strip()}"' for kind, title in dropped)
            raise Fail(USAGE, f'the new body leaves out {len(dropped)} child item(s) that Notion would delete: {listed}. '
                              'Keep their <page>/<database> tags in the file, or pass --allow-deleting-content')

    # Everything above only read. From here each request writes; a write that fails, the first one included,
    # is reported by report_writes with what landed, its own case and what was never sent (exit 4 once one
    # has landed), so a rerun repeats nothing.
    steps, landed, misses = [], [], []
    if properties or args.icon:
        what = []
        if properties:
            what.append('properties ' + ', '.join(properties))
        if args.icon:
            what.append('icon')
        def write_them():
            if not properties:
                return write_properties(client, page, {}, args.icon)
            return client.on_current_schema(schema, build, lambda built: write_properties(client, page, built, args.icon),
                                            built=properties)

        steps.append((' and '.join(what), write_them, []))
    if args.edit:
        matched = [(number, old, new) for number, old, new, state in plan if state == 'matched']
        sent = [edit for edit in matched if edit[1] != edit[2]]  # an edit that only places a file writes no text
        steps.append(('body edits ' + ', '.join(str(n) for n, *_ in sent) if sent else '',
                      lambda: write_edits(client, page, plan, sent, args.allow_deleting_content, misses),
                      [file for number, *_ in matched for file in held[number]]))
    for kind in ('replace', 'prepend', 'append'):
        if kind in files:
            label = {'replace': 'body replaced', 'prepend': 'body added at the start', 'append': 'body added at the end'}[kind]
            steps.append((label, lambda kind=kind: write_body(client, page, kind, files[kind], args.allow_deleting_content), held[kind]))
    where = page.get('url')
    for number, (label, write, placed) in enumerate(steps):
        later = [name for name, _, _ in steps[number + 1:]]
        then = f"Then run only what was not sent: {'; '.join(later)}" if later else ''
        try:
            write()
        except Fail as failure:
            if isinstance(failure, Unbuildable) and not landed:
                raise  # said as any unknown property is: nothing was written
            pending = list(dict.fromkeys(file_label(file.name, file.id) for file in placed))
            finish = None
            if placed and (failure.outcome or IN_DOUBT) == IN_DOUBT:
                finish = 'If it was applied: ' + files_left(where, placed, [file.id for file in placed]) + (f'. {then}' if then else '')
            raise report_writes('update', landed, label, failure, pending + later, where=where, misses=misses, finish=finish)
        if label and not landed and not (properties or args.icon):
            client.say(f'updated {where}')  # only once a write has landed (write_properties says it itself)
        if label:
            landed.append(label)
        if placed:
            place_files(client, page['id'], placed, landed, where, later, then, misses)
            if not label and len(steps) == 1:
                client.say(f'updated {where}')
    if misses:
        raise Fail(PARTIAL, 'done in part; not applied: ' + '; '.join(misses))
    return DONE


def report_writes(kind, done, label, failure, rest, total=None, where='', misses=(), finish=None):
    """The one report of a command with several writes - the steps of `update` and each file they place, the pages
    of `create`: what was written or created, the write that stopped the command in the case write_outcome gave it
    (refused, never sent, or in doubt), and what was never sent. Exit 4 once something was written, else the code of
    the failure itself. Once something landed, no line says that nothing changed. `finish` says how to go on in place
    of what to run again."""
    create = kind == 'create'
    outcome = failure.outcome or IN_DOUBT  # a failure that does not say what became of the write
    nothing = 'nothing was made' if create else 'nothing changed'
    if outcome == REFUSED_WRITE:
        failed = (f"Not {'created' if create else 'written'}: {label} ({failure.cause}): Notion refused it"
                  + ('' if done else f' and {nothing}'))
        again = ('Rerun with only the pages that were not created' if create
                 else 'Rerun only what was not written') + (' or not sent' if rest else '')
    elif outcome == NOT_SENT:
        failed = f'Not sent: {label} ({failure.cause})' + ('' if done else f': the request never left this machine, so {nothing}')
        again = 'Rerun with only the pages not sent' if create else 'Rerun only what was not sent'
    else:
        advice = (f'it may have been created and may still appear, so look for a page titled {label} in {where} '
                  'before creating it again' if create
                  else 'it may have been applied, so fetch the page and check it before running that part again')
        failed = f'In doubt: {label} ({failure.cause}): {advice}'
        again = ('Rerun with only the pages not sent' if create else 'Rerun only what was not sent') if rest else ''
    head = ''
    if done:
        head = (f"done in part: created {len(done)} of {total}: {', '.join(done)}. " if create
                else f"done in part on {where}: written: {'; '.join(done)}. ")
    elif not rest:
        again = ''
    if finish is not None:
        again = finish
    message = (head + failed + (f"; not sent: {(', ' if create else '; ').join(rest)}" if rest else '')
               + (f"; edits that did not apply: {'; '.join(misses)}" if misses else '')
               + (f'. {again}' if again else ''))
    return Fail(PARTIAL if done else failure.code, message, outcome, failure.cause)


def write_properties(client, page, properties, icon_text):
    payload = {}
    if properties:
        payload['properties'] = properties
    if icon_text:
        icon = icon_of(icon_text)
        payload['icon'] = None if icon == 'none' else icon
    stored = client.call('PATCH', f"/v1/pages/{page['id']}", payload)
    changed = client.short_values(stored, names=set(properties))
    client.say(f"updated {stored.get('url') or page.get('url')}")
    if changed:
        client.say(json.dumps(changed, ensure_ascii=False, indent=2))
    if icon_text:
        client.say(f'icon: {icon_text}')


def write_edits(client, page, plan, matched, allow_deleting, misses):
    command = {'content_updates': [{'old_str': old, 'new_str': new} for _, old, new in matched]}
    if allow_deleting:
        command['allow_deleting_content'] = True
    answer = client.call('PATCH', f"/v1/pages/{page['id']}/markdown",
                         {'markdown_version': MARKDOWN_VERSION, 'type': 'update_content', 'update_content': command}) if matched else {}
    notion_misses = [w for w in answer.get('warnings', []) if w.get('code') in ('no_match', 'indentation_mismatch')]
    for number, old, _, state in plan:
        client.say(f'edit {number}: {state}' + ('' if state == 'matched' else f': {old[:80]!r}'))
        if state != 'matched':
            misses.append(f'edit {number} ({old[:80]!r}): {state}')
    for warning in notion_misses:
        misses.append(f"Notion: {warning.get('message')}")
    for warning in answer.get('warnings', []):
        if warning not in notion_misses:
            client.warn(f"warning {warning.get('code')}: {warning.get('message')}")


def write_body(client, page, kind, content, allow_deleting):
    if kind == 'replace':
        command = {'new_str': content}
        if allow_deleting:
            command['allow_deleting_content'] = True
        body = {'markdown_version': MARKDOWN_VERSION, 'type': 'replace_content', 'replace_content': command}
    else:
        body = {'markdown_version': MARKDOWN_VERSION, 'type': 'insert_content',
                'insert_content': {'content': content, 'position': {'type': 'start' if kind == 'prepend' else 'end'}}}
    answer = client.call('PATCH', f"/v1/pages/{page['id']}/markdown", body)
    client.say({'replace': 'body replaced', 'prepend': 'body: added at the start', 'append': 'body: added at the end'}[kind])
    for warning in answer.get('warnings', []):
        client.warn(f"warning {warning.get('code')}: {warning.get('message')}")


def cmd_trash(client, args):
    if not args.confirm:
        raise Fail(USAGE, f'`notion trash` moves the page to the trash only with --confirm; nothing was sent')
    page = client.page(args.ref)
    stored = client.call('PATCH', f"/v1/pages/{page['id']}", {'in_trash': True})
    client.say(f"trashed {client.title_of(stored) or page['id']} {stored.get('url', '')}".strip())
    return DONE


# ---------------------------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------------------------


def assignment(key, value):
    if isinstance(value, bool):
        value = '__YES__' if value else '__NO__'
    elif isinstance(value, list):
        value = json.dumps(value, ensure_ascii=False)
    elif value is None:
        value = ''
    return f'{key}={value}'


def cmd_create(client, args):
    started = NOW().replace(second=0, microsecond=0)  # the minute the command started: Notion's created_time precision
    kind, parent = client.resolve(args.parent)
    if args.pages_file:
        try:
            entries = json.loads(read_file(args.pages_file))
        except json.JSONDecodeError as error:
            raise Fail(USAGE, f'{args.pages_file} is not JSON: {error}')
        if not isinstance(entries, list) or not entries:
            raise Fail(USAGE, f'{args.pages_file} must hold a non-empty JSON array of pages')
        for number, entry in enumerate(entries, 1):
            if not isinstance(entry, dict) or not isinstance(entry.get('properties') or {}, dict):
                raise Fail(USAGE, f'{args.pages_file}, page {number}: each page is an object with a "properties" '
                                  'object; nothing was sent')
            content = entry.get('content', entry.get('body'))
            if content is not None and not isinstance(content, str):
                raise Fail(USAGE, f'{args.pages_file}, page {number}: "content" is the body as a markdown string; '
                                  'nothing was sent')
        drafts = [([assignment(k, v) for k, v in (entry.get('properties') or {}).items()],
                   entry.get('content', entry.get('body')), entry.get('icon')) for entry in entries]
    else:
        drafts = [(args.set or [], read_file(args.body_file) if args.body_file else None, args.icon)]
    if kind == 'data_source':
        target, page_schema = {'data_source_id': parent['id']}, parent
        where = f"data source {plain(parent.get('title')) or parent['id']} ({COLLECTION}{parent['id']})"
    else:
        target, page_schema = {'page_id': parent['id']}, client.schema_for({'parent': {}})
        where = f"page {page_link(parent['id'])}"
    payloads, held = [], []
    for number, (assignments, content, icon) in enumerate(drafts, 1):
        try:
            built = client.build_properties(assignments, page_schema)
        except Fail as failure:
            if len(drafts) > 1 and failure.code == USAGE:
                raise Fail(USAGE, f'page {number} of {len(drafts)}: {failure.message}; nothing was sent')
            raise
        payload, files = {'parent': target, 'properties': built}, []
        if content:
            source = (f'--body-file {args.body_file}' if not args.pages_file else f'{args.pages_file}, page {number}')
            content, files = hold_files(content, source)
            held.append((source, files))
            payload['markdown'] = content
            payload['markdown_version'] = MARKDOWN_VERSION
        if icon:
            payload['icon'] = icon_of(icon) if icon_of(icon) != 'none' else None
        # read from what is sent, not from the schema: a later page may have made the client read that again
        title = next((''.join(part['text']['content'] for part in value['title'])
                      for value in payload['properties'].values() if 'title' in value), '')
        payloads.append((payload, title, files, assignments))
    refuse_placeholders(held)
    created, seen = [], set()  # urls reported, and the ids of the pages this run created or found
    for number, (payload, title, files, assignments) in enumerate(payloads):
        rest = [repr(t or '(untitled)') for _, t, *_ in payloads[number + 1:]]
        then = 'Then create only the pages not sent' if rest else ''
        def create(built):
            try:
                return create_one(client, kind, parent, dict(payload, properties=built), title, started, seen, where)
            except ApiError as refused:
                if kind == 'data_source' and refused.status in (403, 404):
                    try:
                        client.refresh_schema(parent)
                    except Fail as gone:  # the cached parent is gone: say how to connect it, as with nothing cached
                        raise Fail(gone.code, gone.message, refused.outcome)
                raise

        try:
            page = client.on_current_schema(
                page_schema, lambda: client.build_properties(assignments, page_schema), create, built=payload['properties'])
        except Fail as failure:
            if isinstance(failure, Unbuildable) and not created:  # said as any unknown property is: nothing was made
                if len(payloads) > 1:
                    raise Fail(USAGE, f'page {number + 1} of {len(payloads)}: {failure.message}; nothing was made')
                raise
            finish = None
            if files and (failure.outcome or IN_DOUBT) == IN_DOUBT:
                finish = ('If it was created: ' + files_left('<its url>', files, [file.id for file in files])
                          + (f'. {then}' if then else ''))
            raise report_writes('create', created, repr(title or '(untitled)'), failure, rest, total=len(payloads),
                                where=where, finish=finish)
        seen.add(page.get('id'))
        created.append(page.get('url') or page.get('id', ''))
        heading = dropped_heading(payload.get('markdown')) if title else ''
        if heading:
            client.warn(f'warning: Notion takes the only `#` heading of a body for a title when it is the first line, so '
                        f'{heading!r} was left out of {created[-1]}: start a body at `##`, or add the heading with '
                        '`notion update <page> --prepend-file F`')
        if files:
            place_files(client, page['id'], files, ['created ' + ', '.join(created)], created[-1],
                        [f'the create of {t}' for t in rest], then)
    return DONE


def create_one(client, kind, parent, payload, title, started, seen=(), where=''):
    try:
        page = client.call('POST', '/v1/pages', payload)
        note = ''
    except WriteInDoubt as doubt:
        try:
            page = find_created(client, kind, parent, title, started, doubt, seen)
        except Fail as lookup:  # any failure to look - an answer, a timeout, a lost connection, 429 - leaves it in doubt
            raise CreateInDoubt(doubt, title, where, lookup)
        if page is None:
            raise CreateInDoubt(doubt, title, where)
        note = (f' ({doubt.what}; not sent again: found by its title among the pages this '
                'integration made since the minute the command started; check it is the new page)')
    client.say(f"created {page.get('url')} {client.key_of(page)}".rstrip() + note)
    return page


def dropped_heading(markdown):
    """The heading a create leaves out, '' when none: the API takes a body's `#` heading for a title, and drops
    it, when it is the only one and the first line, even if the title was given."""
    rows = [(line, fence) for line, fence in body_lines(markdown or '') if line.strip()]
    headings = [row for row in rows if row[1] is None and re.match(r' {0,3}#\s+\S', row[0])]
    return headings[0][0].strip() if len(headings) == 1 and rows[0] is headings[0] else ''


def find_created(client, kind, parent, title, started, doubt, seen=()):
    """The page a create in doubt may have made: never one this run already created or found (`seen`)."""
    committed = (doubt.body.get('additional_data') or {}).get('committed_resource_id')
    if committed and committed not in seen:
        try:
            return client.call('GET', f'/v1/pages/{committed}')
        except ApiError:
            pass
    if not title:
        return None
    since = started.strftime('%Y-%m-%dT%H:%M:%S.000Z')
    bot = client.bot().get('id')
    if kind == 'data_source':
        def title_property():
            return next(n for n, p in parent['properties'].items() if p.get('type') == 'title')

        def same_title(title_prop):
            return client.call('POST', f"/v1/data_sources/{parent['id']}/query", {
                'filter': {'and': [{'property': title_prop, 'title': {'equals': title}},
                                   {'timestamp': 'created_time', 'created_time': {'on_or_after': since}}]},
                'page_size': 100}).get('results', [])

        candidates = client.on_current_schema(parent, title_property, same_title)
    else:
        candidates = [p for p in client.call('POST', '/v1/search', {
            'query': title, 'filter': {'property': 'object', 'value': 'page'}, 'page_size': 100}).get('results', [])
            if p.get('parent', {}).get('page_id') == parent['id']]
    # The filter is not trusted alone: each candidate is checked here too, its creator and its time.
    for candidate in candidates:
        if candidate.get('id') in seen:
            continue  # a page this run created or already took for another create in doubt
        if ((candidate.get('created_by') or {}).get('id') == bot and client.title_of(candidate) == title
                and created_at_or_after(candidate, started)):
            return candidate
    return None


def created_at_or_after(page, started):
    """Whether the page's created_time is at or after `started`. Notion stores created_time to the
    minute, so `started` is the command's start rounded down to its minute."""
    stamp = page.get('created_time') or ''
    try:
        created = datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00'))
    except ValueError:
        return False
    if created.tzinfo is None:
        created = created.replace(tzinfo=datetime.timezone.utc)
    return created >= started


# ---------------------------------------------------------------------------------------------
# query: the --where language
# ---------------------------------------------------------------------------------------------

TOKEN_RE = re.compile(r"""\s*(?:
    (?P<lparen>\() | (?P<rparen>\)) | (?P<comma>,) |
    (?P<op>>=|<=|!=|=|>|<) |
    '(?P<str>(?:[^'\\]|\\.)*)' |
    "(?P<qname>(?:[^"\\]|\\.)*)" |
    `(?P<bname>[^`]*)` |
    (?P<url>https?://[^\s,)]+) |
    (?P<word>[^\s(),=!<>'"`]+)
)""", re.X)

TEXT_TYPES = ('title', 'rich_text', 'url', 'email', 'phone_number')
EMPTY_TYPES = TEXT_TYPES + ('number', 'select', 'status', 'multi_select', 'date', 'people', 'created_by',
                            'last_edited_by', 'relation', 'files')  # the types the API filters by is_empty
DATE_OPS = {'=': 'equals', '>': 'after', '>=': 'on_or_after', '<': 'before', '<=': 'on_or_before'}
NUMBER_OPS = {'=': 'equals', '!=': 'does_not_equal', '>': 'greater_than', '>=': 'greater_than_or_equal_to',
              '<': 'less_than', '<=': 'less_than_or_equal_to'}


def tokenize(text, spans=None):
    tokens, position = [], 0
    text = text.rstrip()
    while position < len(text):
        match = TOKEN_RE.match(text, position)
        if not match or match.end() == position:
            raise Fail(USAGE, f'cannot read the condition at {text[position:position + 20]!r}')
        position = match.end()
        kind = match.lastgroup
        value = match.group(kind)
        if kind in ('str', 'qname'):
            value = re.sub(r'\\(.)', r'\1', value)
        if kind == 'bname':
            kind = 'qname'
        tokens.append((kind, value))
        if spans is not None:
            spans.append((match.start(kind), match.end()))
    return tokens


class WhereParser:
    """or_expr := and_expr (OR and_expr)* ; and_expr := atom (AND atom)* ; atom := '(' or_expr ')' | condition

    Each condition node carries its source text, so a refusal can name the part it refuses."""

    def __init__(self, text):
        self.text = text.rstrip()
        self.spans = []
        self.tokens = tokenize(text, self.spans)
        self.at = 0

    def source(self, first, last):
        start = self.spans[first][0]
        if self.tokens[first][0] in ('str', 'qname'):
            start -= 1  # the opening quote
        return self.text[start:self.spans[last][1]]

    def peek(self, offset=0):
        index = self.at + offset
        return self.tokens[index] if index < len(self.tokens) else (None, None)

    def take(self):
        token = self.peek()
        self.at += 1
        return token

    def keyword(self, word, offset=0):
        kind, value = self.peek(offset)
        return kind == 'word' and value.upper() == word

    def parse(self):
        if not self.tokens:
            raise Fail(USAGE, 'empty condition')
        tree = self.or_expr()
        if self.at < len(self.tokens):
            raise Fail(USAGE, f'unexpected {self.peek()[1]!r} in the condition')
        return tree

    def or_expr(self):
        parts = [self.and_expr()]
        while self.keyword('OR'):
            self.take()
            parts.append(self.and_expr())
        return parts[0] if len(parts) == 1 else ('or', parts)

    def and_expr(self):
        parts = [self.atom()]
        while self.keyword('AND'):
            self.take()
            parts.append(self.atom())
        return parts[0] if len(parts) == 1 else ('and', parts)

    def atom(self):
        first = self.at
        node = self.bare_atom()
        if first < len(self.tokens) and self.at > first:
            node = node + (self.source(first, min(self.at, len(self.tokens)) - 1),)
        return node

    def bare_atom(self):
        kind, value = self.peek()
        if kind == 'lparen':
            self.take()
            inner = self.or_expr()
            if self.take()[0] != 'rparen':
                raise Fail(USAGE, 'a "(" in the condition is never closed')
            return inner[:2] if inner[0] in ('and', 'or') else inner[:4]
        if kind not in ('word', 'qname'):
            raise Fail(USAGE, f'expected a property name, found {value!r}')
        name = self.take()[1]
        kind, value = self.peek()
        if kind == 'op':
            self.take()
            return ('cond', name, value, [self.value(name, value)])
        if self.keyword('HAS') or self.keyword('CONTAINS'):
            self.take()
            return ('cond', name, 'contains', [self.value(name, value)])
        if self.keyword('IS'):
            self.take()
            negated = self.keyword('NOT')
            if negated:
                self.take()
            if not self.keyword('EMPTY'):
                raise Fail(USAGE, f'after "{name} is" write "empty" or "not empty"')
            self.take()
            return ('cond', name, 'is not empty' if negated else 'is empty', [])
        if self.keyword('IN'):
            self.take()
            if self.take()[0] != 'lparen':
                raise Fail(USAGE, f'write {name} in (a, b, c)')
            values = [self.value(name, 'in')]
            while self.peek()[0] == 'comma':
                self.take()
                values.append(self.value(name, 'in'))
            if self.take()[0] != 'rparen':
                raise Fail(USAGE, f'the list after {name} in is never closed')
            return ('cond', name, 'in', values)
        raise Fail(USAGE, f'after the property {name!r} expected an operator (=, !=, has, contains, >, >=, <, <=, '
                          f'is empty, is not empty, in (...)); quote a name with spaces: "Done at"')

    def value(self, name, operator):
        kind, value = self.take()
        if kind in ('str', 'qname', 'word', 'url'):
            return value
        raise Fail(USAGE, f'expected a value after {name} {operator}')


MAX_NESTING = 2


def compile_where(client, text, schema):
    tree = WhereParser(text).parse()
    sources = {}
    compiled = compile_node(client, tree, schema, sources)
    depth = nesting(compiled)
    if depth > MAX_NESTING:
        part = too_deep(compiled, depth, sources)
        named = f'{part!r} is a group at level {depth}' if part else 'a group sits too deep'
        hint = (' (an `in (...)` list becomes an OR group of one condition per value)'
                if part and re.search(r'\bin\s*\(', part, re.I) else '')
        raise Fail(USAGE, f'the condition nests {depth} groups deep and the API allows {MAX_NESTING}: {named}{hint}; '
                          'nest at most one group inside another. Nothing was sent')
    return compiled


def nesting(node):
    for key in ('and', 'or'):
        if key in node:
            return 1 + max((nesting(child) for child in node[key]), default=0)
    return 0


def too_deep(node, depth, sources):
    """The source text of the innermost group on the deepest path, or of the nearest named group above it."""
    named = None
    level = 0
    while True:
        key = 'and' if 'and' in node else ('or' if 'or' in node else None)
        if key is None:
            return named
        level += 1
        if id(node) in sources and sources[id(node)][0] is node:
            named = sources[id(node)][1]
        if level == depth:
            return named
        node = max(node[key], key=nesting)


def compile_node(client, node, schema, sources):
    if node[0] in ('and', 'or'):
        children = []
        for child in node[1]:
            compiled = compile_node(client, child, schema, sources)
            children += compiled[node[0]] if node[0] in compiled and len(compiled) == 1 else [compiled]
        compiled = {node[0]: children}
    else:
        _, name, operator, values = node[:4]
        compiled = compile_condition(client, schema, name, operator, values)
    if len(node) > (2 if node[0] in ('and', 'or') else 4):
        sources[id(compiled)] = (compiled, node[-1])  # the object is kept, so its id is never reused
    return compiled


def where_property(schema, name, client=None):
    """(name, property) of what --where, --order, --select and --group-by call `name`: a property of that name
    (any case) first, else the built-in name - a page's own created or last edited time, of type `timestamp`, or the
    unique id and the title property under `id`/`key` and `title`/`name`."""
    def find(schema):
        properties = schema['properties']
        if name in properties:
            return name, properties[name]
        for candidate, prop in properties.items():
            if candidate.casefold() == name.casefold():
                return candidate, prop
        lowered = name.casefold()
        if lowered in ('created', 'created_time'):
            return 'created_time', {'type': 'timestamp'}
        if lowered in ('edited', 'last_edited', 'last_edited_time', 'updated'):
            return 'last_edited_time', {'type': 'timestamp'}
        for kind, aliases in (('unique_id', ('id', 'key')), ('title', ('title', 'name'))):
            if lowered in aliases:
                for candidate, prop in properties.items():
                    if prop.get('type') == kind:
                        return candidate, prop
        return None

    found = client.look_up(schema, find) if client else find(schema)
    if found:
        return found
    properties = schema['properties']
    close = nearest(name, list(properties))
    hint = f"did you mean {' or '.join(close)}?" if close else f"properties: {', '.join(properties)}"
    raise Fail(USAGE, f'unknown property {name!r} in the condition; {hint}')


def compile_condition(client, schema, name, operator, values):
    prop_name, prop = where_property(schema, name, client)
    kind = prop.get('type')
    head = {'timestamp': prop_name} if kind == 'timestamp' else {'property': prop_name}
    key = prop_name if kind == 'timestamp' else kind
    if kind in ('created_time', 'last_edited_time'):
        head, key = {'timestamp': kind}, kind

    def refuse():
        return Fail(USAGE, f'the operator {operator!r} does not apply to {prop_name} ({kind}) in the condition')

    if operator in ('is empty', 'is not empty'):
        if kind in ('checkbox', 'unique_id', 'timestamp', 'created_time', 'last_edited_time', 'formula', 'rollup'):
            raise refuse()
        if kind not in EMPTY_TYPES:
            raise Fail(USAGE, f'{prop_name} is a {kind} property, which the API cannot filter; nothing was sent')
        return dict(head, **{key: {'is_empty' if operator == 'is empty' else 'is_not_empty': True}})

    def leaf(op, value):
        return dict(head, **{key: {op: value}})

    def either(op, convert):
        """One leaf, or for `in (...)` an OR group of one single-value leaf per value: the API's
        equals and contains take one value, never a list."""
        if operator == 'in':
            leaves = [leaf(op, convert(v)) for v in values]
            return leaves[0] if len(leaves) == 1 else {'or': leaves}
        return leaf(op, convert(values[0]))

    if kind in TEXT_TYPES:
        ops = {'=': 'equals', '!=': 'does_not_equal', 'contains': 'contains', 'in': 'equals'}
        if operator not in ops:
            raise refuse()
        return either(ops[operator], str)
    if kind in ('number', 'unique_id'):
        def to_number(value):
            if kind == 'unique_id':
                match = KEY_RE.fullmatch(value)
                if match:
                    expected = (prop.get('unique_id') or {}).get('prefix')
                    if expected and match.group(1).upper() != expected.upper():
                        raise Fail(USAGE, f'{value} does not have the prefix {expected} of {prop_name}')
                    return int(match.group(2))
            return number_of(value, prop_name)
        if operator == 'in':
            return either('equals', to_number)
        if operator not in NUMBER_OPS:
            raise refuse()
        return leaf(NUMBER_OPS[operator], to_number(values[0]))
    if kind in ('select', 'status'):
        ops = {'=': 'equals', '!=': 'does_not_equal', 'in': 'equals'}
        if operator not in ops:
            raise refuse()
        return either(ops[operator], str)
    if kind == 'multi_select':
        ops = {'=': 'contains', 'contains': 'contains', '!=': 'does_not_contain', 'in': 'contains'}
        if operator not in ops:
            raise refuse()
        return either(ops[operator], str)
    if kind in ('date', 'timestamp', 'created_time', 'last_edited_time'):
        ops = dict(DATE_OPS, **{'in': 'equals'})
        if operator not in ops:
            raise refuse()

        def to_date(value):
            if no_date(value):
                raise Fail(USAGE, f'{prop_name}: {value!r} is not a date; to find no date write `{name} is empty` in the '
                                  'condition. Nothing was sent')
            return value
        return either(ops[operator], to_date)
    if kind in ('people', 'created_by', 'last_edited_by'):
        ops = {'=': 'contains', 'contains': 'contains', '!=': 'does_not_contain', 'in': 'contains'}
        if operator not in ops:
            raise refuse()
        return either(ops[operator], client.person_id)
    if kind == 'relation':
        ops = {'=': 'contains', 'contains': 'contains', '!=': 'does_not_contain', 'in': 'contains'}
        if operator not in ops:
            raise refuse()
        return either(ops[operator], client.page_id_of)
    if kind == 'checkbox':
        ops = {'=': 'equals', '!=': 'does_not_equal', 'in': 'equals'}
        if operator not in ops:
            raise refuse()

        def to_bool(value):
            word = value.casefold()
            if word not in ('__yes__', '__no__', 'true', 'false', 'yes', 'no'):
                raise Fail(USAGE, f'{prop_name} is a checkbox: compare it with __YES__ or __NO__')
            return word in ('__yes__', 'true', 'yes')
        return either(ops[operator], to_bool)
    if operator == 'in':
        raise Fail(USAGE, f'`{name} in (...)`: {prop_name} is a {kind} property, which has no single-value equality '
                          'filter, so the list cannot be compiled; nothing was sent')
    raise Fail(USAGE, f'{prop_name} is a {kind} property, which the condition cannot filter; '
                      'use `notion api POST /v1/data_sources/<id>/query --data <filter>`')


def parse_order(schema, text, client=None):
    sorts = []
    for part in [p.strip() for p in text.split(',') if p.strip()]:
        words = part.rsplit(None, 1)
        direction = 'ascending'
        if len(words) == 2 and words[1].lower() in ('asc', 'desc', 'ascending', 'descending'):
            part, direction = words[0], 'descending' if words[1].lower().startswith('desc') else 'ascending'
        name, prop = where_property(schema, part.strip().strip('"`'), client)
        if prop.get('type') in ('timestamp', 'created_time', 'last_edited_time'):
            sorts.append({'timestamp': name if prop.get('type') == 'timestamp' else prop['type'], 'direction': direction})
        else:
            sorts.append({'property': name, 'direction': direction})
    return sorts


def cell(value):
    if isinstance(value, list):
        return ', '.join(cell(v) for v in value)
    if value is None:
        return ''
    text = str(value)
    match = re.fullmatch(r'user://\S+ \((.*)\)', text)
    return match.group(1) if match else text.replace('\n', ' ').replace('|', '\\|')


Column = collections.namedtuple('Column', 'name fact')  # fact: the page's own (created, edited), not a property


def column_value(client, row, column):
    """What a row holds in a column of the table or of --group-by."""
    if column.fact:
        return row.get(column.name)
    return value_named(client.short_values(row, names={column.name}), column.name)


def row_values(client, row, columns):
    """A row's properties as --json prints them, under their short keys: all of them, or the selected columns,
    a built-in one with the page's own value."""
    if columns is None:
        return client.short_values(row)
    values = client.short_values(row, names={column.name for column in columns if not column.fact})
    values.update({column.name: row.get(column.name) for column in columns if column.fact})
    return values


def query_plan(client, args, schema):
    """What `query` asks of the data source and reads from its rows, from the schema as it stands: the request's
    body, the table's columns (None: --json without --select, the whole property set) and --group-by's column."""
    body, columns, group = {}, None, None
    if args.where:
        body['filter'] = compile_where(client, args.where, schema)
    if args.order:
        body['sorts'] = parse_order(schema, args.order, client)

    def column(wanted):
        name, prop = where_property(schema, wanted, client)
        return Column(name, prop.get('type') == 'timestamp')  # a built-in only when no property has the name

    if args.select:
        columns = [column(c.strip().strip('"`')) for c in args.select.split(',') if c.strip()]
    if args.group_by:
        group = column(args.group_by)
    if columns is None and not args.json:
        props = schema['properties']
        columns = [Column(name, False) for kind in ('unique_id', 'title', 'status')
                   for name in [n for n, p in props.items() if p.get('type') == kind][:1]]
    return {'body': body, 'columns': columns, 'group': group}


def cmd_query(client, args):
    kind, schema = client.resolve(args.ref, want='data_source')
    if kind != 'data_source':
        raise Fail(USAGE, f'{args.ref} is a page; `notion query` takes a data source')
    max_rows = args.max_rows or MAX_ROWS

    def ask(plan):
        return plan, client.of_data_source(schema, lambda: client.pages_of(
            'POST', f"/v1/data_sources/{schema['id']}/query", plan['body'], max_items=max_rows))

    def lacks(plan, answer):
        """Whether a row does not hold a property the output reads: the schema named it, so the schema is old."""
        read = [] if args.count else [plan['group']] if plan['group'] else plan['columns'] or []
        _, (rows, _) = answer
        return any(c.name not in row.get('properties', {}) for row in rows for c in read if not c.fact)

    plan, (rows, more) = client.on_current_schema(schema, lambda: query_plan(client, args, schema), ask, lacks)
    columns, group = plan['columns'], plan['group']
    stopped = f'stopped paging at {max_rows} rows; more rows match (--max-rows N raises the cap)' if more else ''
    if args.count:
        if args.json:
            client.emit(len(rows))
        else:
            client.say(str(len(rows)))
        if stopped:
            client.say(stopped)
        return DONE
    if group:
        counts = {}
        for row in rows:
            value = column_value(client, row, group)
            for item in (value if isinstance(value, list) else [value]) or [None]:
                label = cell(item) or '(empty)'
                counts[label] = counts.get(label, 0) + 1
        ordered = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
        if args.json:
            client.emit(dict(ordered))
        else:
            for label, count in ordered:
                client.say(f'{label} {count}')
        if stopped:
            client.say(stopped)
        return DONE
    limit = args.limit if args.limit is not None else DEFAULT_ROWS
    shown = rows[:limit]
    if args.json:
        client.emit([{'id': r['id'], 'url': r.get('url'), 'key': client.key_of(r) or None,
                      'properties': row_values(client, r, columns)} for r in shown])
    else:
        client.say(' | '.join([column.name for column in columns] + ['url']))
        for row in shown:
            cells = [cell(column_value(client, row, column)) for column in columns]
            client.say(' | '.join(cells + [row.get('url', '')]))
    if len(rows) > limit:
        client.say(f'… {len(rows) - limit} more rows matched (--limit N shows them, --count counts them)')
    if stopped:
        client.say(stopped)
    if not rows:
        client.say('no row matched')
    return DONE


# ---------------------------------------------------------------------------------------------
# search
# ---------------------------------------------------------------------------------------------


SIMILAR = 'similar title'  # the API's title search also returns titles that only resemble the words


def holding(page, needle, names):
    """The first of the page's properties `names` that is a title or a text holding `needle` (folded), else None.
    The text is read plain, as the filter matches it: a link's address is not a match and never splits one."""
    for name in names:
        prop = page.get('properties', {}).get(name) or {}
        if prop.get('type') in ('title', 'rich_text') and needle in fold(plain(prop.get(prop['type']))):
            return name
    return None


def search_rows(client, schema, words, limit):
    """(the rows of a data source whose title or a text holds the words, whether it has more, the properties asked)."""
    def text_properties():
        return {n: p['type'] for n, p in schema['properties'].items() if p.get('type') in ('title', 'rich_text')}

    def ask(asked):
        conditions = [{'property': name, kind: {'contains': words}} for name, kind in asked.items()]
        if not conditions:
            return [], False, []
        rows, more = client.pages_of('POST', f"/v1/data_sources/{schema['id']}/query",
                                     {'filter': {'or': conditions} if len(conditions) > 1 else conditions[0]},
                                     max_items=limit, whole=True)
        return rows, more, list(asked)

    return client.on_current_schema(schema, text_properties, ask)


def cmd_search(client, args):
    words = ' '.join(args.words).strip()
    if not words:
        raise Fail(USAGE, 'search for what? `notion search <words>`')
    limit = args.limit or 10
    # capped: a source had more rows than --limit, so the count of hits is a lower bound. Every row a source's
    # answer held is a hit, those past --limit too: they are counted, and only the first --limit are printed.
    hits, capped = {}, False

    def add(page, matched):
        kept = hits.get(page['id'])  # a real match replaces a likeness, whichever came first
        if (kept is None or kept[1] == SIMILAR != matched) and not page.get('in_trash'):
            hits[page['id']] = (page, matched)

    ref = parse_ref(words)
    if ref.kind == 'id' or ref.kind == 'data_source':
        kind, found = client.resolve(words)
        if kind == 'page':
            add(found, 'id')
        else:
            client.say(f"{plain(found.get('title')) or UNTITLED} | {COLLECTION}{found['id']} | data source | matched: id")
            return DONE
    else:
        if ref.kind == 'key':
            try:
                add(client.page_by_key(ref.prefix, ref.number), 'key')
            except NoSuchKey:  # the words only look like a key, or no page has it: any other failure is the search's
                pass
        if args.within:
            kind, scope = client.resolve(args.within, want='data_source')
            if kind != 'data_source':
                raise Fail(USAGE, f'--in takes a data source, and {args.within} is a page')
            queue = [scope['id']]
        else:
            found, more = client.pages_of('POST', '/v1/search', {'query': words, 'filter': {'property': 'object', 'value': 'page'}},
                                          max_items=limit, whole=True)
            capped = capped or more
            for page in found:
                if page.get('object') == 'page':  # a title that only resembles the words may still hold them in a text
                    add(page, 'title' if fold(words) in fold(client.title_of(page))
                        else holding(page, fold(words), page.get('properties', {})) or SIMILAR)
            queue = [s['id'] for s in client.data_sources()]
        needle = fold(words)
        searched = set()
        while queue:
            identifier = queue.pop(0)
            searched.add(identifier)
            try:
                schema = client.data_source(identifier)

                def ask():
                    return search_rows(client, schema, words, limit)

                rows, more, searchable = client.of_data_source(schema, ask) if args.within else ask()
                capped = capped or more
            except ApiError as failure:
                # only a data source of the cached list that is gone is skipped; the one named by --in never is
                if args.within or failure.status not in (403, 404) or not client.disconnected(identifier):
                    raise
                client.skip_note(identifier)
                queue = [s['id'] for s in client.data_sources() if s['id'] not in searched]
                continue
            for row in rows:
                matched = holding(row, needle, searchable)
                if matched:
                    add(row, matched)
    if not hits:
        client.say(f'no hit for {words!r}')
    for page, matched in sorted(hits.values(), key=lambda hit: hit[1] == SIMILAR)[:limit]:  # likenesses last
        parent = page.get('parent', {})
        if parent.get('type') == 'data_source_id':
            where = client.data_source_title(parent['data_source_id'])
        else:
            where = client.parent_label(page)
        key = client.key_of(page)
        title = client.title_of(page) or '(untitled)'
        client.say(' | '.join(filter(None, [key, title, page.get('url', ''), where, f'matched: {matched}'])))
    if len(hits) > limit:
        client.say(f"… {'at least ' if capped else ''}{len(hits) - limit} more hits (--limit N shows them)")
    elif capped:  # the rows not read may be hits already counted, or none: only "at least 0" is sure
        client.say('… at least 0 more hits: a source was cut short, so more may match (a higher --limit reads further)')
    return DONE


# ---------------------------------------------------------------------------------------------
# comments
# ---------------------------------------------------------------------------------------------


def comment_body(args):
    text = args.body if args.body is not None else read_file(args.body_file)
    if not text.strip():  # the API would post an empty comment
        raise Fail(USAGE, 'the comment is empty; nothing was sent')
    return text


def display_name(client):
    if str(client.settings().get('stamp_comments', 'on')).casefold() in ('off', 'false', 'no', '0'):
        return None
    if client.owner_kind() != 'workspace':
        return None
    person = client.me(required=False)
    if not person:
        why = client.me_unresolved or f'set "me" in {config_path()} to sign it with your name'
        client.warn(f'the comment is shown as the integration: {why}')
        return None
    return {'type': 'custom', 'custom': {'name': person['name']}}


def cmd_comments(client, args):
    if args.action == 'list':
        page = client.page(args.target)
        threads = client.discussions(page['id'])
        if not threads:
            client.say('no open discussion (the API does not return resolved ones)')
        for discussion, comments in threads.items():
            client.say(f'- discussion {discussion}')
            for comment in comments:
                client.say(f"  {client.author(comment)} [{comment['id']}]: {linked(comment.get('rich_text')) or '(attachment only)'}")
        return DONE
    if args.body is None and args.body_file is None:
        raise Fail(USAGE, f'`notion comments {args.action}` needs --body TEXT or --body-file F')
    text = comment_body(args)
    if args.action == 'edit':
        comment_id = hyphenate(args.target)
        if not comment_id:
            raise Fail(USAGE, f'{args.target} is not a comment id')
        own = ('the API lets a token edit only its own comments (the ones this integration wrote); '
               'reply in the discussion instead: `notion comments reply <discussion> --body ...`')
        try:
            existing = client.call('GET', f'/v1/comments/{comment_id}')
        except ApiError as error:
            if error.status == 404:
                raise Fail(REFUSED, f'comment {comment_id} cannot be edited: {own}')
            raise
        author = (existing.get('created_by') or {}).get('id')
        if author != client.bot().get('id'):
            raise Fail(REFUSED, f'comment {comment_id} was written by {client.user_name(author) or author}: {own}')
        try:
            stored = client.call('PATCH', f'/v1/comments/{comment_id}', {'markdown': text, 'markdown_version': MARKDOWN_VERSION})
        except ApiError as error:
            if error.status == 404:
                raise Fail(REFUSED, f'comment {comment_id} cannot be edited: {own}')
            raise
        client.say(f"edited comment {stored.get('id', comment_id)}")
        return DONE
    payload = {'markdown': text, 'markdown_version': MARKDOWN_VERSION}
    if args.action == 'add':
        payload['parent'] = {'page_id': client.page(args.target)['id']}
    else:
        discussion = parse_ref(args.target)
        if discussion.kind != 'id':
            raise Fail(USAGE, f'{args.target} is not a discussion id')
        payload['discussion_id'] = discussion.value
    signed = display_name(client)
    if signed:
        payload['display_name'] = signed
    stored = client.call('POST', '/v1/comments', payload)
    client.say(f"comment {stored.get('id')} in discussion {stored.get('discussion_id')}")
    return DONE


# ---------------------------------------------------------------------------------------------
# files
# ---------------------------------------------------------------------------------------------


def cmd_upload(client, args):
    path = Path(args.file)
    if not path.is_file():
        raise Fail(USAGE, f'no file {path}')
    size = path.stat().st_size
    if size > UPLOAD_LIMIT:
        raise Fail(REFUSED, f'{path.name} has {size} bytes; one upload takes at most 20 MB '
                            '(larger files need the multi-part upload through `notion api`)')
    mime = mimetypes.guess_type(path.name)[0] or 'application/octet-stream'
    boundary = uuid.uuid4().hex
    safe_name = path.name.replace('"', '')
    data = (f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{safe_name}"\r\n'
            f'Content-Type: {mime}\r\n\r\n').encode('utf-8') + path.read_bytes() + f'\r\n--{boundary}--\r\n'.encode('utf-8')
    try:
        created = client.call('POST', '/v1/file_uploads', {'filename': path.name, 'content_type': mime})
        sent = client.call('POST', f"/v1/file_uploads/{created['id']}/send", raw=data,
                           content_type=f'multipart/form-data; boundary={boundary}')
    except ApiError as error:
        if error.status == 400:
            error.code = REFUSED  # the plan's Surface: a file the API refuses exits 1
        raise
    reference = f"file-upload://{created['id']}"
    client.say(f"uploaded {path.name} ({sent.get('status', 'sent')}): within one hour, put this line in a body "
               '(`notion create` or `notion update`, which place the file)')
    name = re.sub(r'([\\\[\]`<>])', r'\\\1', path.name)  # a name is text, whatever it holds
    if mime.startswith('image/'):
        client.say(f'![{name}]({reference})')
    else:
        client.say(f'<file source="{reference}">{name}</file>')
    client.say(f"or as a files property: --set 'Files={reference}'")
    return DONE


def cmd_download(client, args):
    target = args.ref.strip()
    if re.match(r'https?://', target) and urllib.parse.urlsplit(target).netloc not in (API_HOST,) \
            and not re.search(r'notion\.(so|com)$', urllib.parse.urlsplit(target).netloc):
        url, name = target, None
    else:
        ref = parse_ref(target)
        if ref.kind != 'id':
            raise Fail(USAGE, f'{target} is not a file block or a file url')
        try:
            block = client.call('GET', f'/v1/blocks/{ref.value}')
        except ApiError as error:
            if error.status in (403, 404):
                raise client.not_connected(ref.value, error)
            raise
        content = block.get(block.get('type')) or {}
        hosted = content.get(content.get('type')) or {}
        url = hosted.get('url')
        name = content.get('name')
        if not url:
            raise Fail(USAGE, f"block {ref.value} is a {block.get('type')} block with no file")
    name = name or urllib.parse.unquote(urllib.parse.urlsplit(url).path.rsplit('/', 1)[-1]) or 'download'
    name = Path(name).name
    try:
        status, _, data = TRANSPORT('GET', url, {}, None, 120)
    except (TimeoutError, ConnectionError) as error:
        raise Fail(REFUSED, f'could not download {name}: {error}')
    if status != 200:
        raise Fail(REFUSED, f'the file host answered {status} for {name} (signed urls expire after an hour: fetch the page again)')
    folder = Path(args.output or '.')
    folder.mkdir(parents=True, exist_ok=True)
    path, number = folder / name, 0
    while True:  # never replace a file that is already there: 'xb' fails instead of clobbering, then the next name
        try:
            with open(path, 'xb') as saved:
                saved.write(data)
            break
        except FileExistsError:
            number += 1
            path = folder / f'{Path(name).stem} ({number}){Path(name).suffix}'
    client.say(str(path.resolve()))
    return DONE


# ---------------------------------------------------------------------------------------------
# people
# ---------------------------------------------------------------------------------------------


def cmd_users(client, args):
    needle = fold(' '.join(args.text))
    people, reason = client.list_users()
    client.warn_unlisted(reason)
    matches = [(i, p) for i, p in people.items() if needle in fold(p.get('name')) or needle in fold(p.get('email'))]
    if not matches:
        raise Fail(REFUSED, f"nobody matches {' '.join(args.text)!r}")
    for identifier, person in sorted(matches, key=lambda m: m[1].get('name', '')):
        client.say(' '.join(filter(None, [f'user://{identifier}', person.get('name'), person.get('email'),
                                          '(bot)' if person.get('type') == 'bot' else ''])))
    return DONE


def cmd_whoami(client, args):
    bot = client.bot()
    person = client.me()
    client.say(' '.join(filter(None, [f"user://{person['id']}", person.get('name'), person.get('email')])))
    client.say(f"token: {client.source}, integration {bot.get('name')} ({client.owner_kind() or 'unknown'} owned)")
    return DONE


# ---------------------------------------------------------------------------------------------
# auth, doctor, api
# ---------------------------------------------------------------------------------------------


def owner_text(client):
    bot = client.bot()
    owner = (bot.get('bot') or {}).get('owner') or {}
    if owner.get('type') == 'workspace':
        return f"integration {bot.get('name')!r}, owned by the workspace (shared token: comments are signed with `me`)"
    if owner.get('type') == 'user':
        user = owner.get('user') or {}
        return f"token {bot.get('name')!r}, owned by {user.get('name') or user.get('id') or 'a person'} (personal token)"
    return f"bot {bot.get('name')!r}"


def cmd_auth(client, args):
    if args.action == 'login':
        if not STDIN_IS_TTY():
            raise Fail(USAGE, 'run `notion auth login` in a terminal: it reads the token at a hidden prompt '
                              '(never paste a token in a chat)')
        token = GETPASS('Notion API token (input hidden): ').strip()
        if not token:
            raise Fail(USAGE, 'no token typed; nothing stored')
        client._token, client.source = well_formed(token, 'the prompt')
        client.bot()
        stored = secret_tool('store', '--label=Notion API token (cdv-notion)', *KEYRING, stdin=token)
        if stored is not None and stored.returncode == 0:
            client.say(f'logged in: {owner_text(client)}; token stored in the keyring')
            return DONE
        path = credentials_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, 'w') as handle:
            handle.write(token + '\n')
        os.chmod(path, 0o600)
        client.say(f'logged in: {owner_text(client)}; no keyring here, token stored in {path} (mode 600)')
        return DONE
    if args.action == 'status':
        client.token()
        client.say(f'token from {client.source}: {owner_text(client)}')
        return DONE
    cleared = secret_tool('clear', *KEYRING)
    client.say('token removed from the keyring' if cleared is not None and cleared.returncode == 0 else 'no keyring entry to remove')
    if credentials_path().is_file():
        client.say(f'{credentials_path()} still holds a token; delete it to log out completely')
    return DONE


WRITE_CHECK_BODY = """<callout icon="🧪" color="gray_bg">
Write check callout
</callout>

<table header-row="true">
<tr><td>Column</td><td>Value</td></tr>
<tr><td>a</td><td>1</td></tr>
</table>

<toggle>
Write check toggle

Hidden line
</toggle>"""


def children_of(client, identifier):
    """The blocks directly under a page or a block, every page of the list."""
    return client.pages_of('GET', f'/v1/blocks/{identifier}/children')[0]


def write_check_problems(client, page_id):
    """What the stored blocks of WRITE_CHECK_BODY are not, empty when every construct landed as its own block.
    The blocks are read, not the markdown: text that came back the same may still be a plain paragraph."""
    blocks = children_of(client, page_id)
    kinds = [b.get('type') for b in blocks]
    if kinds != ['callout', 'table', 'toggle']:
        return [f"stored as {', '.join(kinds) or 'nothing'}, not as a callout, a table and a toggle"]
    callout, table, toggle = blocks
    problems = []
    said = plain(callout['callout'].get('rich_text'))
    if said != 'Write check callout':
        problems.append(f'the callout holds {said!r}')
    shape = table['table']
    if shape.get('table_width') != 2 or not shape.get('has_column_header'):
        problems.append(f"the table has {shape.get('table_width')} columns and "
                        f"{'a' if shape.get('has_column_header') else 'no'} header row")
    cells = [[plain(cell) for cell in (row.get('table_row') or {}).get('cells', [])] for row in children_of(client, table['id'])]
    if cells != [['Column', 'Value'], ['a', '1']]:
        problems.append(f'the table holds {cells!r}')
    said = plain(toggle['toggle'].get('rich_text'))
    hidden = [plain((b.get(b.get('type')) or {}).get('rich_text')) for b in children_of(client, toggle['id'])]
    if said != 'Write check toggle' or hidden != ['Hidden line']:
        problems.append(f'the toggle {said!r} holds {hidden!r}')
    return problems


def cmd_doctor(client, args):
    failed = False
    client.token()
    client.say(f'token: {client.source}, {owner_text(client)}')
    sources = []
    try:
        sources = client.data_sources(refresh=True)
        client.say('read content: present')
    except ApiError as error:
        failed = True
        client.say(f'read content: missing ({error.status} {error.api_code})')
    sample = None
    for source in sources:
        rows = client.call('POST', f"/v1/data_sources/{source['id']}/query", {'page_size': 1}).get('results', [])
        if rows:
            sample = rows[0]['id']
            break
    if sample:
        try:
            client.call('GET', '/v1/comments', query={'block_id': sample, 'page_size': 1})
            client.say('read comments: present')
        except ApiError as error:
            failed = True
            client.say(f'read comments: missing ({error.status} {error.api_code})')
    else:
        client.say('read comments: not probed (no readable page in a connected data source)')
    try:
        users = client.call('GET', '/v1/users', query={'page_size': 100}).get('results', [])
        with_email = any((u.get('person') or {}).get('email') for u in users)
        client.say('user information: present, ' + ('with e-mail' if with_email else 'without e-mail (`me` cannot be matched)'))
        for user in users:
            client.remember(user)
    except ApiError as error:
        failed = True
        client.say(f'user information: missing ({error.status} {error.api_code}): `users find` only knows people seen in rows')
    writes = {'insert content': None, 'update content': None, 'insert comments': None}
    if args.write_check:
        results = write_check(client, args)
        writes = {'insert content': results.get('create'),
                  'update content': results.get('property') and results.get('body'),
                  'insert comments': results.get('comment')}
        failed = failed or not all(results.get(s) for s in ('create', 'property', 'body', 'comment', 'trash'))
    for capability in ('update content', 'insert content', 'insert comments'):
        state = writes[capability]
        if state is None:
            client.say(f'{capability}: not probed (`notion doctor --write-check <data source>` writes a marked test card)')
        else:
            client.say(f"{capability}: {'present' if state else 'missing or failed (see the write check)'}")
    if not sources:
        failed = True
        client.say('data source: none connected (connect the integration to the data sources in Notion)')
    for source in sources:
        client.say(f"data source: {source['title'] or UNTITLED}, prefix {source.get('prefix') or 'none'}, {COLLECTION}{source['id']}")
    return REFUSED if failed else DONE


def trash_check_card(client, page, title, step):
    """Trash the write check's card and read it back; when that fails, say which card to trash by hand."""
    by_hand = f"trash the card {title!r} by hand: {page.get('url')}"
    try:
        client.call('PATCH', f"/v1/pages/{page['id']}", {'in_trash': True})
        trashed = client.call('GET', f"/v1/pages/{page['id']}").get('in_trash')
        step('trash', bool(trashed), f'the page is not in the trash; {by_hand}')
    except Fail as failure:
        step('trash', False, f'{failure.message}; {by_hand}')


def trash_lost_check_card(client, schema, title, started, doubt, step):
    """The card of a write check whose create ended in doubt: looked for by its title, which holds the time to
    the second, and trashed; when it is not found, or cannot be looked for, its title is said."""
    found, why = None, 'no card with that title was found'
    for wait in (0, 2, 4):  # a query may not list a page at once
        if wait:
            SLEEP(wait)
        try:
            found = find_created(client, 'data_source', schema, title, started, doubt)
        except Fail as failure:
            why = f'it could not be looked for ({failure.cause})'
        if found is not None and client.title_of(found) == title:
            client.say(f"write check create: the card was made and was found by its title, {found.get('url')}")
            return trash_check_card(client, found, title, step)
    where = f"data source {plain(schema.get('title')) or schema['id']} ({COLLECTION}{schema['id']})"
    step('trash', False, f'{why}; it may still appear, so look for a card titled {title!r} in {where} and trash it by hand')


def write_check(client, args):
    marker = args.marker or client.settings().get('test_marker')
    if not marker:
        raise Fail(USAGE, 'no test marker: pass --marker "<title prefix>" or set "test_marker" in '
                          f'{config_path()}; the write check only writes cards whose title starts with it')
    kind, schema = client.resolve(args.write_check, want='data_source')
    if kind != 'data_source':
        raise Fail(USAGE, '--write-check takes the data source to write the test card in')
    client.refresh_schema(schema)  # a check reads the schema the workspace has now
    props = schema['properties']
    title_prop = next(n for n, p in props.items() if p.get('type') == 'title')
    started = NOW()
    title = f"{marker} doctor {started.strftime('%Y-%m-%d %H:%M:%S')}"
    results, page = {}, None

    def step(name, ok, detail='', where=''):
        results[name.split()[0]] = ok
        client.say(f'write check {name}: ' + (f'ok{" (" + where + ")" if where else ""}' if ok
                                              else f'FAILED{" (" + detail + ")" if detail else ""}'))
        return ok

    try:
        page = client.call('POST', '/v1/pages', {'parent': {'data_source_id': schema['id']},
                                                  'properties': {title_prop: {'title': rich_text(title)}}})
        step('create', client.title_of(page) == title, f"the title read back differs, {page.get('url')}", where=page.get('url'))
    except WriteInDoubt as doubt:
        step('create', False, doubt.message)
        trash_lost_check_card(client, schema, title, started.replace(second=0, microsecond=0), doubt, step)
        return results
    except Fail as failure:
        step('create', False, failure.message)
        return results
    try:
        candidates = [(n, p['type']) for n, p in props.items() if p.get('type') in ('checkbox', 'rich_text', 'number')]
        candidates.sort(key=lambda c: ('checkbox', 'rich_text', 'number').index(c[1]))
        if not candidates:
            step('property', False, 'no checkbox, text or number property to set')
        else:
            name, kind = candidates[0]
            value, expected = {'checkbox': ('__YES__', '__YES__'), 'rich_text': ('write check', 'write check'),
                               'number': ('1', 1)}[kind]
            client.call('PATCH', f"/v1/pages/{page['id']}", {'properties': client.build_properties([f'{name}={value}'], schema)})
            stored = value_named(client.short_values(client.call('GET', f"/v1/pages/{page['id']}"), names={name}), name)
            step(f'property ({name})', stored == expected, f'read back {stored!r}')
        client.call('PATCH', f"/v1/pages/{page['id']}/markdown",
                    {'markdown_version': MARKDOWN_VERSION, 'type': 'replace_content', 'replace_content': {'new_str': WRITE_CHECK_BODY}})
        problems = write_check_problems(client, page['id'])
        step('body (callout, table, toggle)', not problems, '; '.join(problems))
        said = f'{marker} write check comment with [a link](https://example.com/)'  # read back with its address
        client.call('POST', '/v1/comments', {'parent': {'page_id': page['id']}, 'markdown': said,
                                             'markdown_version': MARKDOWN_VERSION})
        threads = client.discussions(page['id'])
        step('comment', any(linked(c.get('rich_text')) == said for cs in threads.values() for c in cs),
             'the comment did not read back with its link')
    except Fail as failure:
        client.say(f'write check stopped: {client.redact(failure.message)}')
    finally:
        trash_check_card(client, page, title, step)
    return results


def cmd_api(client, args):
    path = args.path.strip()
    if re.match(r'https?://', path):
        parts = urllib.parse.urlsplit(path)
        if parts.scheme != 'https' or parts.netloc != API_HOST:
            raise Fail(USAGE, f'`notion api` only calls https://{API_HOST}/v1/...; refusing {parts.netloc}')
        path = parts.path + (f'?{parts.query}' if parts.query else '')
    if not path.startswith('/'):
        path = '/' + path
    bare = path.split('?', 1)[0]
    if not bare.startswith('/v1/') or '/../' in bare + '/' or '/./' in bare:
        raise Fail(USAGE, f'`notion api` takes a path under /v1/, not {args.path}')
    query = None
    if '?' in path:
        path, raw_query = path.split('?', 1)
        query = urllib.parse.parse_qs(raw_query)
    body = None
    if args.data is not None or args.data_file:
        text = args.data if args.data is not None else read_file(args.data_file)
        try:
            body = json.loads(text)
        except json.JSONDecodeError as error:
            raise Fail(USAGE, f'--data is not JSON: {error}')
    method = args.method.upper()
    try:
        if args.paginate:
            results, _ = client.pages_of(method, path, body, query)
            answer = {'object': 'list', 'results': results}
        else:
            status, answer = client.send(method, path, body, query)
            if not 200 <= status < 300:
                client.say(json.dumps(answer, ensure_ascii=False, indent=2))
                outcome = write_outcome(status) if is_write(method, path) else None
                cause = f'Notion answered {status} {answer.get("code", "")}'.strip()
                raise Fail(REFUSED, with_words(cause, outcome), outcome, cause)
    except ApiError as error:
        client.say(json.dumps(error.body, ensure_ascii=False, indent=2))
        cause = f'Notion answered {error.status} {error.api_code}'.strip()
        raise Fail(REFUSED, with_words(cause, error.outcome), error.outcome, cause)
    except WriteInDoubt as doubt:
        if doubt.body:
            client.say(json.dumps(doubt.body, ensure_ascii=False, indent=2))
        raise
    client.say(json.dumps(answer, ensure_ascii=False, indent=2))
    return DONE


# ---------------------------------------------------------------------------------------------
# command line
# ---------------------------------------------------------------------------------------------


def build_parser():
    parser = argparse.ArgumentParser(prog='notion', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='cmd', required=True)

    p = sub.add_parser('auth', help='store, check or remove the token')
    p.add_argument('action', choices=['login', 'status', 'logout'])
    p.set_defaults(func=cmd_auth)

    p = sub.add_parser('doctor', help='check the token, the capabilities and the connected data sources')
    p.add_argument('--write-check', metavar='DATA_SOURCE', help='also write, read back and trash a marked test card there')
    p.add_argument('--marker', help='title prefix of the test card (default: test_marker in the settings)')
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser('fetch', help='a page (properties + body) or a data source (short schema)')
    p.add_argument('ref')
    p.add_argument('--discussions', action='store_true', help='also print the open discussions')
    p.add_argument('--props-only', action='store_true', help='skip the body')
    p.add_argument('--json', action='store_true', help='the raw API objects')
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser('update', help='change properties, the body or the icon of a page')
    p.add_argument('ref')
    p.add_argument('--set', action='append', metavar="'Prop=value'")
    p.add_argument('--edit', nargs=2, action='append', metavar=('OLD', 'NEW'))
    p.add_argument('--replace-file', metavar='F')
    p.add_argument('--append-file', metavar='F')
    p.add_argument('--prepend-file', metavar='F')
    p.add_argument('--allow-deleting-content', action='store_true')
    p.add_argument('--icon')
    p.set_defaults(func=cmd_update)

    p = sub.add_parser('create', help='create a page in a data source or under a page')
    p.add_argument('--parent', required=True)
    p.add_argument('--set', action='append', metavar="'Prop=value'")
    p.add_argument('--body-file', metavar='F')
    p.add_argument('--icon')
    p.add_argument('--pages-file', metavar='F', help='JSON array of {"properties": {...}, "content": "...", "icon": "..."}')
    p.set_defaults(func=cmd_create)

    p = sub.add_parser('query', help='rows of a data source, filtered in Notion')
    p.add_argument('ref')
    p.add_argument('--where', metavar='EXPR')
    p.add_argument('--order', metavar="'Prop desc'")
    p.add_argument('--select', metavar="'a,b'")
    p.add_argument('--limit', type=int)
    p.add_argument('--max-rows', type=int)
    p.add_argument('--count', action='store_true')
    p.add_argument('--group-by', metavar='Prop')
    p.add_argument('--json', action='store_true')
    p.set_defaults(func=cmd_query)

    p = sub.add_parser('search', help='pages by title, and rows by title and text properties')
    p.add_argument('words', nargs='+')
    p.add_argument('--in', dest='within', metavar='REF')
    p.add_argument('--limit', type=int)
    p.set_defaults(func=cmd_search)

    p = sub.add_parser('comments', help='list, add, reply to or edit comments')
    p.add_argument('action', choices=['list', 'add', 'reply', 'edit'])
    p.add_argument('target', help='a page (list, add), a discussion (reply) or a comment (edit)')
    group = p.add_mutually_exclusive_group()
    group.add_argument('--body')
    group.add_argument('--body-file', metavar='F')
    p.set_defaults(func=cmd_comments)

    p = sub.add_parser('upload', help='upload a file and print the markdown that places it')
    p.add_argument('file')
    p.set_defaults(func=cmd_upload)

    p = sub.add_parser('download', help='save the file of a file block or a signed url')
    p.add_argument('ref')
    p.add_argument('-o', '--output', metavar='DIR')
    p.set_defaults(func=cmd_download)

    p = sub.add_parser('users', help='find a person by name or e-mail')
    p.add_argument('action', choices=['find'])
    p.add_argument('text', nargs='+')
    p.set_defaults(func=cmd_users)

    p = sub.add_parser('whoami', help='the person this machine acts for')
    p.set_defaults(func=cmd_whoami)

    p = sub.add_parser('trash', help='move a page to the trash')
    p.add_argument('ref')
    p.add_argument('--confirm', action='store_true')
    p.set_defaults(func=cmd_trash)

    p = sub.add_parser('api', help='any REST call under /v1/')
    p.add_argument('method')
    p.add_argument('path')
    p.add_argument('--data')
    p.add_argument('--data-file', metavar='F')
    p.add_argument('--paginate', action='store_true')
    p.set_defaults(func=cmd_api)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    client = Notion()
    client.json = getattr(args, 'json', False)
    try:
        return args.func(client, args) or DONE
    except Fail as failure:
        if failure.message:
            client.warn(failure.message)
        return failure.code
    except KeyboardInterrupt:
        return REFUSED
    except Exception as error:  # last resort: Python's own handler would print the text raw, token included
        client.warn(f'{type(error).__name__}: {error}')
        return REFUSED


if __name__ == '__main__':
    sys.exit(main())
