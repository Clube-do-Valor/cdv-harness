{
  "PreToolUse": [
    {
      "matcher": "^(Agent|Task|mcp__.+)$",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/require-model"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/prod-ssh"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/suite-lock"
        }
      ]
    }
  ]
}
