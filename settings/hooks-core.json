{
  "PreToolUse": [
    {
      "matcher": "^(Agent|Task|mcp__.+)$",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/require-model"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/prod-ssh"
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/suite-lock"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(Bash|mcp__.+__notion-(update-page|create-pages))$",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/card-check",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUseFailure": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/harness/hooks/card-check",
          "timeout": 30
        }
      ]
    }
  ]
}
