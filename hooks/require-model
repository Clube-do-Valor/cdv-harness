#!/usr/bin/env python3
"""PreToolUse hook: a child agent names its model.

Blocks (exit 2) a subagent call (`Agent`, formerly `Task`) with no `model`, and a call of the
profile's `delegate_tool` whose target names no model or the model `inherit`, and prints the role
table of the repository profile so the next call can name the role's model. A `fork` subagent
inherits the parent's context by design and passes.
"""

import sys

sys.dont_write_bytecode = True
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent))
import harness_hook as h  # noqa: E402

SUBAGENT_TOOLS = ("Agent", "Task")


def named(model):
    return isinstance(model, str) and model.strip() != "" and model.strip().lower() != "inherit"


def role_table(profile):
    lines = [f"{key}: {value}" for key, value in sorted(profile.items()) if key.startswith("role_") and isinstance(value, str)]
    if not lines:
        return "  (the profile declares no role_* lines: add them to .claude/harness/profile.yaml)"
    return "\n".join(f"  {line}" for line in lines)


def main(tool, tool_input, profile):
    if tool in SUBAGENT_TOOLS:
        if str(tool_input.get("subagent_type") or "").strip().lower() == "fork":
            return h.ALLOW, ""
        if named(tool_input.get("model")):
            return h.ALLOW, ""
        what = f"this {tool} call names no model"
    else:
        delegate = h.setting(profile, "delegate_tool")
        if not delegate or tool != delegate:
            return h.ALLOW, ""
        target = tool_input.get("target")
        model = target.get("model") if isinstance(target, dict) else None
        if model is None:
            model = tool_input.get("model")
        if named(model):
            return h.ALLOW, ""
        what = f"this {tool} call's target names no model (or `inherit`)"
    return h.BLOCK, (
        f"require-model: {what}. Every child names its model from the role table of the "
        "repository profile (role: account, model alias, effort); a child never inherits the "
        "parent's model, and Fable runs only when the user names it.\nRole table:\n" + role_table(profile)
    )


if __name__ == "__main__":
    h.entry(main)
