#!/usr/bin/env python3
"""PostToolUse and PostToolUseFailure hook: a Notion card written in this session is checked against
the card contract before the agent's next step.

It fires after every `Bash` call and every connector page write. When the call wrote a page - a
command that names the cdv-notion client and whose output holds the client's own write lines
(`updated <url>`, `created <url> <key>`), whatever the shell shape; with no such line, the client's
`update <ref>` in the command as far as it parses (a failed call checks the pages its output shows
as written, and on exit 4, done in part, also the page of the command); or the connector's
`notion-update-page` or `notion-create-pages` under any server prefix - it runs
`card_contract.py check <ref>` (with `--body-replaced` after a whole-body replace) and, on findings,
exits 2 with them on stderr, which the host shows the model beside the tool result. A client
`fetch`, when it is the command's one client call with nothing piped, redirected or run after it,
pins the request zone from its own output, with no call to Notion; an output that may be cut (the
client's truncation marker, a request zone that does not reach its end marker) pins nothing.

One check per tool call (the first entry to create the claim file named after `tool_use_id` wins),
three failed checks in a row on one page say so once and then stay silent for that page in the
session, and a machine with no token is told once per session. It fails open: anything unexpected
exits 0 with nothing printed. It needs no harness profile: the checker and the client are found
beside it, in `<.claude or config dir>/skills/`.
"""

import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent))
import harness_hook as h  # noqa: E402

SILENT, SAY = 0, 2
CONNECTOR = re.compile(r"^mcp__.+__notion-(update-page|create-pages)$")
UUID = re.compile(r"(?<![0-9a-fA-F])([0-9a-fA-F]{8})-?([0-9a-fA-F]{4})-?([0-9a-fA-F]{4})-?([0-9a-fA-F]{4})-?"
                  r"([0-9a-fA-F]{12})(?![0-9a-fA-F])")
URL = re.compile(r"https?://[^\s\"'<>),]+")
# update flags that take values; --edit takes two
VALUE_FLAGS = {"--set": 1, "--edit": 2, "--replace-file": 1, "--append-file": 1, "--prepend-file": 1, "--icon": 1}
CHECK_TIMEOUT = 25
LOOP_LIMIT = 3


def skills_dir():
    return h.harness_dir().parent / "skills"


def checker_path():
    return skills_dir() / "cdv-notion-ticket" / "scripts" / "card_contract.py"


def client_path():
    return skills_dir() / "cdv-notion" / "scripts" / "notion"


def load_checker():
    import importlib.machinery
    import importlib.util

    loader = importlib.machinery.SourceFileLoader("card_contract_for_hook", str(checker_path()))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def hyphenated(text):
    match = UUID.search(text or "")
    return "-".join(match.groups()).lower() if match else None


def page_key(ref):
    return hyphenated(ref) or ref.strip().upper()


def shown(ref):
    """The page as the developer reads it: a key or a url as given, a bare id as its url."""
    if UUID.fullmatch(ref.strip()):
        return "https://app.notion.com/p/" + hyphenated(ref).replace("-", "")
    return ref


# ---------------------------------------------------------------------------------------------
# What the call wrote
# ---------------------------------------------------------------------------------------------


# The command names the client: a word `notion`, or a path ending in `/notion` (`N=<path>/notion`).
NAMES_CLIENT = re.compile(r"(?:^|[\s/'\"=;&|(`])notion(?=$|[\s'\";&|)`])")
# The lines the client prints for a write, on stdout: `updated <url>` and `created <url> <key>`.
WRITE_LINE = re.compile(r"^\s*(updated|created) (https?://\S+)")
# A done-in-part update names its page: `done in part on <url>: written: ...`.
PARTIAL_ON = re.compile(r"done in part on (https?://\S+?):(?:\s|$)")
SHELLS = {"bash", "sh", "zsh", "dash"}
# Words before the program that only change how it runs.
WRAPPERS = {"do", "then", "else", "time", "exec", "command", "nohup", "!"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def simple_commands(command, depth=0):
    """The simple commands of a command line, quoted words kept whole (`--set 'Status=In progress'`),
    in order, the command string of a `bash -c` opened up after the command that runs it. A command
    the shell splitter cannot parse is split at whitespace and operators (harness_hook.lex)."""
    out, current = [], []
    for word in h.lex(command) + [";"]:
        if word in h.OPERATORS or (word and set(word) <= set(";&|()")):
            if current:
                out.append(current)
                words = h.command_words(current)
                if depth < 3 and words and os.path.basename(words[0]) in SHELLS:
                    for index in range(1, len(words) - 1):
                        if re.fullmatch(r"-[a-z]*c", words[index]):
                            out += simple_commands(words[index + 1], depth + 1)
                            break
            current = []
        else:
            current.append(word)
    return out


def program(words):
    """The words from the program on: `env` with its options and assignments, `timeout <n>`, `nice`
    and the other wrappers skipped, and `python3 <client>` read as the client."""
    index = 0
    while index < len(words):
        word, base = words[index], os.path.basename(words[index])
        if word in WRAPPERS or ASSIGNMENT.match(word):
            index += 1
        elif base in ("env", "nice", "timeout"):
            index += 1
            while index < len(words) and words[index].startswith("-"):  # env's VAR= words: the loop above
                takes_value = words[index] in ("-u", "-n", "-s", "-k", "--signal", "--kill-after", "--unset", "--adjustment")
                index += 2 if takes_value else 1
            if base == "timeout" and index < len(words):
                index += 1  # the duration
        else:
            break
    words = words[index:]
    if words and os.path.basename(words[0]).startswith("python") and len(words) > 1:
        words = words[1:]
    return words


def client_calls(command):
    """(verb, arguments) of each simple command that runs the cdv-notion client, in order. The client
    held in a variable assigned earlier in the same command (`N=<path>; $N update ...`) is the client."""
    found, assigned = [], {}
    for segment in simple_commands(command):
        if not h.command_words(segment):
            assigned.update(word.split("=", 1) for word in segment)
            continue
        words = program(segment)
        if words:
            variable = re.fullmatch(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?", words[0])
            if variable and variable.group(1) in assigned:
                words = [assigned[variable.group(1)]] + words[1:]
        if len(words) >= 2 and os.path.basename(words[0]) == "notion":
            found.append((words[1], words[2:]))
    return found


def update_ref(arguments):
    """The page an `update` names; None when it names none or only a variable (`$k`)."""
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word.startswith("--"):
            index += 1 + (0 if "=" in word else VALUE_FLAGS.get(word, 0))
            continue
        return None if word[:1] in "$<>&|" else word
    return None


def written_lines(output):
    """[(verb, url)] of the client's write lines in the call's output."""
    found = []
    for line in (output or "").splitlines():
        match = WRITE_LINE.match(line)
        if match:
            found.append((match.group(1), match.group(2).rstrip(".;:,")))
    return found


def bash_targets(command, output, code):
    """[(ref, body replaced)] of the pages the client wrote, and whether it fetched a page.

    The pages are the client's own write lines in the output, whatever the shell shape; when the
    output holds none, the client's `update` in the command, as far as it can be parsed. A call
    that exited 4 (done in part) also checks the page of the command. When the command's updates
    and the output's `updated` lines are as many, each page is named by the command's ref (its key)."""
    replaced = bool(re.search(r"--replace-file\b", command))
    calls = client_calls(command)
    refs = [ref for verb, arguments in calls if verb == "update" for ref in [update_ref(arguments)] if ref]
    lines = written_lines(output)
    updated = [url for verb, url in lines if verb == "updated"]
    if lines:
        named = iter(refs if len(refs) == len(updated) else updated)
        pages = [next(named) if verb == "updated" else url for verb, url in lines]
    else:
        pages = list(refs) if code == 0 else []
    if code == 4:
        partial = [m.group(1) for m in PARTIAL_ON.finditer(output or "")]
        pages += partial or ([] if updated else refs)
    return [(page, replaced) for page in pages], whole_fetch(command, calls)


def whole_fetch(command, calls):
    """True when the command's one client call is a `fetch` with nothing piped, redirected or run
    after it, so the call's output is the fetch's own output."""
    if [verb for verb, _ in calls] != ["fetch"]:
        return False
    words = h.lex(command)
    if "fetch" not in words:
        return False
    after = words[len(words) - words[::-1].index("fetch"):]
    return not any(word in h.OPERATORS or set(word) & set("<>|;&") for word in after)


def connector_targets(tool, tool_input, response):
    targets = []
    if tool.endswith("notion-update-page"):
        page = tool_input.get("page_id")
        if isinstance(page, str) and page.strip():
            targets.append((page.strip(), tool_input.get("command") == "replace_content"))
        return targets
    parent = json.dumps(tool_input.get("parent"))
    excluded = {hyphenated(m.group(0)) for m in UUID.finditer(parent)}
    seen = set()
    blob = response if isinstance(response, str) else json.dumps(response)
    for url in URL.findall(blob):
        identifier = hyphenated(url)
        if identifier and identifier not in excluded and identifier not in seen:
            seen.add(identifier)
            targets.append((url, False))
    for match in UUID.finditer(blob):
        identifier = hyphenated(match.group(0))
        if identifier not in excluded and identifier not in seen:
            seen.add(identifier)
            targets.append((identifier, False))
    return targets


def output_of(event):
    """(exit code or None, the text the call printed): on PostToolUse the call's stdout, after a
    failure the host's `error` text, which starts `Exit code <n>`."""
    if "error" in event and event.get("hook_event_name") != "PostToolUse":
        error = str(event.get("error") or "")
        match = re.match(r"\s*Exit code (\d+)", error)
        return (int(match.group(1)) if match else None), error
    response = event.get("tool_response")
    if isinstance(response, dict):
        return 0, str(response.get("stdout") or "")
    return 0, str(response or "")


# ---------------------------------------------------------------------------------------------
# Session state, under the client's cache directory
# ---------------------------------------------------------------------------------------------


class Session:
    def __init__(self, root, session_id):
        safe = re.sub(r"[^A-Za-z0-9._-]", "_", session_id or "no-session")[:120]
        self.path = root / "sessions" / f"{safe}.json"
        try:
            self.data = json.loads(self.path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            self.data = {}
        self.data.setdefault("fails", {})
        self.data.setdefault("silent", [])

    def save(self):
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            scratch = self.path.with_name(f".{self.path.name}.{os.getpid()}.tmp")
            scratch.write_text(json.dumps(self.data), encoding="utf-8")
            os.replace(scratch, self.path)
        except OSError:
            pass


def claim(root, tool_use_id):
    """True for the first entry of the hook that fires for this tool call."""
    if not tool_use_id:
        return True
    folder = root / "claims"
    try:
        folder.mkdir(parents=True, exist_ok=True, mode=0o700)
        handle = os.open(str(folder / re.sub(r"[^A-Za-z0-9._-]", "_", tool_use_id)[:120]),
                         os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(handle)
        return True
    except FileExistsError:
        return False
    except OSError:
        return True


def check(ref, replaced):
    argv = [sys.executable, str(checker_path()), "check", ref] + (["--body-replaced"] if replaced else [])
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=CHECK_TIMEOUT, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None, ""
    return proc.returncode, proc.stdout.strip()


NO_TOKEN = ("card-check: cards are not being checked on this machine: the cdv-notion client has no usable Notion "
            "token. Run `notion auth login` in a terminal (the cdv-notion skill, references/setup.md, says where "
            "the token comes from).")


def main():
    event = h.read_event()
    if not event:
        return SILENT, ""
    tool = str(event.get("tool_name") or "")
    tool_input = event.get("tool_input") if isinstance(event.get("tool_input"), dict) else {}
    code, output = output_of(event)
    fetched = False
    if tool == "Bash":
        command = tool_input.get("command")
        if not isinstance(command, str) or not NAMES_CLIENT.search(command):
            return SILENT, ""
        targets, fetched = bash_targets(command, output, code)
        fetched = fetched and code == 0
    elif CONNECTOR.match(tool):
        if code != 0:
            return SILENT, ""
        targets = connector_targets(tool, tool_input, event.get("tool_response"))
    else:
        return SILENT, ""
    if not targets and not fetched:
        return SILENT, ""
    if not checker_path().is_file() or not client_path().is_file():
        return SILENT, ""
    checker = load_checker()
    root = Path(checker.client().cache_dir()) / "card-check"
    if not claim(root, str(event.get("tool_use_id") or "")):
        return SILENT, ""
    if fetched:
        try:
            checker.pin_from_fetch_output(output)
        except Exception:
            pass
    session = Session(root, str(event.get("session_id") or ""))
    said, seen = [], set()
    for ref, replaced in targets:
        key = page_key(ref)
        if key in seen or key in session.data["silent"]:
            continue
        seen.add(key)
        if session.data.get("no_token"):
            break
        result, text = check(ref, replaced)
        if result == 3:
            session.data["no_token"] = True
            said.append(NO_TOKEN)
            break
        if result == 1 and text:
            fails = session.data["fails"].get(key, 0) + 1
            session.data["fails"][key] = fails
            message = f"card-check: {shown(ref)} is outside the card contract (card_contract.py check {ref}):\n{text}"
            if fails >= LOOP_LIMIT:
                session.data["silent"].append(key)
                message += (f"\ncard-check: {shown(ref)} failed {fails} checks in a row in this session; the card is "
                            "still outside the contract, and the developer decides what to do with it. card-check "
                            "says nothing more about this page in this session.")
            said.append(message)
        elif result == 0:
            session.data["fails"].pop(key, None)
    session.save()
    return (SAY, "\n".join(said)) if said else (SILENT, "")


def run():
    try:
        code, message = main()
    except Exception:  # a broken hook must never stop a session
        return SILENT
    if code == SAY and message:
        print(message, file=sys.stderr)
        return SAY
    return SILENT


if __name__ == "__main__":
    sys.exit(run())
