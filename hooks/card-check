#!/usr/bin/env python3
"""PostToolUse and PostToolUseFailure hook: a Notion card written in this session is checked against
the card contract before the agent's next step.

It fires after every `Bash` call and every connector page write. When the call wrote a page - a
command that names the cdv-notion client and whose output holds the client's own write lines
(`updated <url>`, `created <url> <key>`) wherever they sit, whatever the shell shape, and on a call that
ended well also the pages the client's `update <ref>` names in the command, as far as it can be read: a
write whose output is hidden inside a shape the reading does not open is not seen (a failed call checks
the pages its output shows as written, and on exit 4, done in part, also the pages of the command; a write the client reports as
in doubt is checked like one that landed, on the page its message names, and a write refused or
never sent is not); or the connector's `notion-update-page` or `notion-create-pages` under any server
prefix - it runs `card_contract.py check <ref>` (as a whole-body replace for the page that had one, and only for it)
and, on findings, exits 2 with them on stderr, which the host shows the model beside the tool result. A client
`fetch`, when it is the command's one client call with nothing piped, redirected or run after it and
nothing before it but `cd` and assignments, which print nothing, pins the request zone from its own output, with no call to Notion; an output that may be cut (the
client's truncation marker, a request zone that does not reach its end marker) pins nothing.

The hook ends inside its time budget (25 s, before the host's timeout of 30 s) whatever the number
of pages: the first pages are checked, and one line says how many were not.

One check per tool call (the first entry to create the claim file named after `tool_use_id` wins),
three failed checks in a row on one page say so once and then stay silent for that page in the
session, and a machine with no token is told once per session. It fails open: anything unexpected
exits 0 with nothing printed. It needs no harness profile: the checker and the client are found
beside it, in `<.claude or config dir>/skills/`.
"""

import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent))
import harness_hook as h  # noqa: E402

SILENT, SAY = 0, 2
CONNECTOR = re.compile(r"^mcp__.+__notion-(update-page|create-pages)$")
UUID = re.compile(r"(?<![0-9a-fA-F])([0-9a-fA-F]{8})-?([0-9a-fA-F]{4})-?([0-9a-fA-F]{4})-?([0-9a-fA-F]{4})-?"
                  r"([0-9a-fA-F]{12})(?![0-9a-fA-F])")
URL = re.compile(r"https?://[^\s\"'<>),]+")
# the flags of `update` and how many values each takes
UPDATE_FLAGS = {"--set": 1, "--edit": 2, "--replace-file": 1, "--append-file": 1, "--prepend-file": 1, "--icon": 1,
                "--allow-deleting-content": 0, "--help": 0}
CHECK_TIMEOUT = 25
# The whole hook ends inside this many seconds, before the host's timeout of 30 (door 3), whatever the
# number of pages a call wrote. CARD_CHECK_BUDGET can only lower it.
BUDGET_SECONDS = 25.0
MIN_CHECK_SECONDS = 1.0
STARTED = time.monotonic()
LOOP_LIMIT = 3


def skills_dir():
    return h.harness_dir().parent / "skills"


def checker_path():
    return skills_dir() / "cdv-notion-ticket" / "scripts" / "card_contract.py"


def client_path():
    return skills_dir() / "cdv-notion" / "scripts" / "notion"


def load_checker():
    import importlib.machinery
    import importlib.util

    loader = importlib.machinery.SourceFileLoader("card_contract_for_hook", str(checker_path()))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def hyphenated(text):
    match = UUID.search(text or "")
    return "-".join(match.groups()).lower() if match else None


def named_page(checker, ref):
    """The page id a reference holds, as the client reads it (a url's path, or the page its `?p=` opens);
    None for a key."""
    try:
        found = checker.client().parse_ref(ref)
        return found.value if found.kind == "id" else None
    except Exception:
        return hyphenated(ref)


def shown(ref):
    """The page as the developer reads it: a key or a url as given, a bare id as its url."""
    if UUID.fullmatch(ref.strip()):
        return "https://app.notion.com/p/" + hyphenated(ref).replace("-", "")
    return ref


# ---------------------------------------------------------------------------------------------
# What the call wrote
# ---------------------------------------------------------------------------------------------


# The command names the client: a word `notion`, or a path ending in `/notion` (`N=<path>/notion`,
# `${N:-<path>/notion}`, `${N:-notion}`).
NAMES_CLIENT = re.compile(r"(?:^|[\s/'\"=;&|(`]|:-)notion(?=$|[\s'\";&|)`}])")
# The lines the client prints for a write, on stdout: `updated <url>` and `created <url> <key>`, wherever
# they sit (a loop may print a label before them).
WRITE_LINE = re.compile(r"(updated|created) (https?://[^\s\"'<>),]+)")
NOTION_HOST = re.compile(r"(?:[a-z0-9-]+\.)*notion\.(?:so|com|site)", re.I)
# An update done in part, or done with something it could not read back, names its page: `done in part on
# <url>: written: ...`, `done on <url>: written: ...`. An update that only places uploaded files prints no other.
DONE_ON = re.compile(r"done (?:in part )?on (https?://[^\s\"'<>),]+?): written: ")
# A write in doubt (sent, with no answer the client can trust), alone or after a write that landed:
# `In doubt: <what> (<cause>): ...`. The cause names the page by the API path the request went to; a file
# placed goes to a block, and its page is in the command the line ends with. A refused (`Not written:`) or
# unsent (`Not sent:`) write names them too, and is not one.
IN_DOUBT = re.compile(r"(?m)^[^\S\n]*(?:done in part\b.*?\. )?In doubt: .*$")
PAGE_PATH = re.compile(r"/v1/pages/(" + UUID.pattern + ")")
PLACE_COMMAND = re.compile(r"`notion update (https?://[^\s\"'<>),]+) --edit ")
MAX_DEPTH = 3  # a command string inside a command string
OPERATOR = re.compile(r"&&|\|\||;;&|;;|;&|\|&|[;|&()]")
REDIRECTION = re.compile(r"&>>|&>|>>|>\||>&|<<<|<<-|<<|<&|<>|>|<")


class Unreadable(ValueError):
    """A command whose quotes or parentheses do not close."""


class Command:
    """One simple command: its words with the quotes taken off, whether a stream of it is redirected, the
    bodies of its heredocs, the commands its substitutions run, and the operators on its two sides."""

    def __init__(self, before=""):
        self.words, self.redirected, self.heredocs, self.inside = [], False, [], []
        self.before, self.after = before, ""


class Reader:
    """Reads a shell command line into its simple commands: quotes, escapes, comments, operators,
    redirections, heredocs and command substitutions, also inside double quotes."""

    def __init__(self, text):
        self.text, self.at = text, 0

    def commands(self, closer=""):
        """The simple commands up to `closer` (the parenthesis of a substitution) or the end."""
        text, out, current, depth = self.text, [], Command(), 0
        word, bare, wants, heredocs = None, True, None, []

        def end_word():
            nonlocal word, bare, wants
            if word is not None:
                if wants == "heredoc":
                    heredocs[-1][1] = word
                elif not wants:
                    current.words.append(word)
                wants = None
            word, bare = None, True

        def end_command(operator):
            nonlocal current
            end_word()
            if current.words or current.redirected or current.inside:
                current.after = operator
                out.append(current)
                current = Command(operator)
            elif operator != "\n":  # a blank line keeps the operator before it
                current.before = operator

        while self.at < len(text):
            char = text[self.at]
            if text.startswith("\\\n", self.at):
                self.at += 2
            elif char == "\n":
                self.at += 1
                end_command("\n")
                for owner, delimiter, dash in heredocs:
                    owner.heredocs.append(self.heredoc(delimiter, dash))
                heredocs = []
            elif char.isspace():
                self.at += 1
                end_word()
            elif char == "#" and word is None:
                while self.at < len(text) and text[self.at] != "\n":
                    self.at += 1
            elif char in "<>" and text[self.at + 1 : self.at + 2] == "(":
                start = self.at
                current.inside += self.substitution(self.at + 2)
                word, bare = (word or "") + text[start : self.at], False
            elif char in "<>" or text.startswith("&>", self.at):
                if word is not None and bare and word.isdigit():
                    word = None  # the number of the stream
                end_word()
                operator = REDIRECTION.match(text, self.at).group(0)
                self.at += len(operator)
                current.redirected, wants = True, "target"
                if operator in ("<<", "<<-"):
                    wants = "heredoc"
                    heredocs.append([current, "", operator == "<<-"])
            elif char == ")" and closer and not depth:
                self.at += 1
                end_command("")
                return out
            elif OPERATOR.match(text, self.at):
                operator = OPERATOR.match(text, self.at).group(0)
                self.at += len(operator)
                depth += {"(": 1, ")": -1}.get(operator, 0)
                end_command(operator)
            else:
                said, quoted, inside = self.piece()
                current.inside += inside
                word, bare = (word or "") + said, bare and not quoted
        if closer:
            raise Unreadable("a substitution is not closed")
        end_command("")
        return out

    def piece(self):
        """(text, quoted?, commands run) of the next piece of a word."""
        text, start, char = self.text, self.at, self.text[self.at]
        if char == "\\":
            self.at += 2
            return text[start + 1 : self.at], True, []
        if char == "'":
            self.at = self.find("'", start + 1) + 1
            return text[start + 1 : self.at - 1], True, []
        if text.startswith("$'", start):
            match = re.compile(r"\$'((?:[^'\\]|\\.)*)'", re.S).match(text, start)
            if not match:
                raise Unreadable("a quote is not closed")
            self.at = match.end()
            return re.sub(r"\\(.)", r"\1", match.group(1)), True, []
        if char == '"' or text.startswith('$"', start):
            self.at += 1 if char == '"' else 2
            said, inside = [], []
            while self.at < len(text) and text[self.at] != '"':
                if text[self.at] == "\\" and text[self.at + 1 : self.at + 2] in ("\\", '"', "$", "`", "\n"):
                    said.append(text[self.at + 1].strip("\n"))
                    self.at += 2
                elif text[self.at] in "$`":
                    piece, _, run = self.expansion()
                    said.append(piece)
                    inside += run
                else:
                    said.append(text[self.at])
                    self.at += 1
            self.at = self.find('"', self.at) + 1
            return "".join(said), True, inside
        if char in "$`":
            return self.expansion()
        self.at += 1
        return char, False, []

    def expansion(self):
        """A `$(...)`, backquotes or `${...}` as it is written, with the commands it runs."""
        text, start = self.text, self.at
        if text[start] == "`":
            end = start + 1
            while text[end : end + 1] != "`":
                end += 2 if text[end : end + 1] == "\\" else 1
                if end >= len(text):
                    raise Unreadable("a backquote is not closed")
            self.at = end + 1
            return text[start : self.at], False, Reader(re.sub(r"\\([`\\$])", r"\1", text[start + 1 : end])).commands()
        if text.startswith("$(", start):
            run = self.substitution(start + 2)
            return text[start : self.at], False, run
        if text.startswith("${", start):
            self.at = self.closing_brace(start + 1)
            return text[start : self.at], False, []
        self.at += 1
        return text[start], False, []

    def substitution(self, start):
        self.at = start
        return self.commands(closer=")")

    def find(self, char, start):
        end = self.text.find(char, start)
        if end < 0:
            raise Unreadable("a quote is not closed")
        return end

    def closing_brace(self, start):
        """The place after the brace that closes the one at `start`."""
        depth = 0
        for at in range(start, len(self.text)):
            depth += {"{": 1, "}": -1}.get(self.text[at], 0)
            if not depth:
                return at + 1
        raise Unreadable("a brace is not closed")

    def heredoc(self, delimiter, dash):
        """The heredoc's body, read up to its delimiter."""
        body = []
        while self.at < len(self.text):
            end = self.text.find("\n", self.at)
            end = len(self.text) if end < 0 else end
            line, self.at = self.text[self.at : end], end + 1
            if (line.lstrip("\t") if dash else line) == delimiter:
                break
            body.append(line)
        return "\n".join(body)


def read_commands(command):
    """(the simple commands, whether the reading is whole) of a command line. A command whose quotes do
    not close is split at whitespace and operators instead (harness_hook.lex)."""
    try:
        return Reader(command).commands(), True
    except Unreadable:
        out, current = [], Command()
        for word in h.lex(command) + [";"]:
            if word in h.OPERATORS or (word and set(word) <= set(";&|()")):
                if current.words:
                    out.append(current)
                current = Command(word)
            else:
                current.words.append(word)
        return out, False


def every_command(command, depth=0):
    """(simple command, whether its reading is whole) of each one a command line runs, in order: what its
    substitutions run before the command that holds them, and the command string (or the heredoc) a
    shell is given after the shell."""
    read, whole = read_commands(command)

    def walk(commands):
        for one in commands:
            yield from walk(one.inside)
            yield one, whole
            words = program(one.words)
            if depth < MAX_DEPTH and words and os.path.basename(words[0]) in SHELLS:
                index, letters = options(words, 1, *SHELL_OPTIONS)
                if "c" in letters:
                    yield from every_command(words[index], depth + 1) if index < len(words) else ()
                elif index >= len(words):
                    for body in one.heredocs:
                        yield from every_command(body, depth + 1)

    yield from walk(read)


# ---------------------------------------------------------------------------------------------
# The client in the command
# ---------------------------------------------------------------------------------------------

SHELLS = {"bash", "sh", "zsh", "dash"}
SHELL_OPTIONS = ("oO", ("--rcfile", "--init-file"))
PYTHON = re.compile(r"python[\d.]*")
PYTHON_OPTIONS = ("WXcm", ("--check-hash-based-pycs",))
# Words of the shell before a command, and programs that only change how the next one runs: their short
# and long options that take a value, and how many words of their own come before the program.
KEYWORDS = {"if", "then", "elif", "else", "while", "until", "do", "!", "{"}
WRAPPERS = {
    "env": ("uCS", ("--unset", "--chdir", "--split-string"), 0),
    "timeout": ("ks", ("--kill-after", "--signal"), 1),
    "nice": ("n", ("--adjustment",), 0),
    "nohup": ("", (), 0),
    "time": ("fo", ("--format", "--output"), 0),
    "exec": ("a", (), 0),
    "command": ("", (), 0),
    "sudo": ("ugpChrtTUDR", ("--user", "--group", "--prompt", "--chdir", "--host", "--role", "--type", "--chroot",
                             "--close-from", "--other-user", "--command-timeout"), 0),
}
DECLARES = {"export", "declare", "local", "readonly", "typeset"}
NAME = r"[A-Za-z_][A-Za-z0-9_]*"
ASSIGNMENT = re.compile(rf"({NAME})=(.*)", re.S)
VARIABLE = re.compile(rf"\$(?:({NAME})|\{{({NAME})(?::?[-=](.*))?\}})", re.S)


def options(words, index, short, long):
    """(index after the options, their short letters) of the options that start at `index`."""
    letters = set()
    while index < len(words) and words[index].startswith("-"):
        word = words[index]
        index += 1
        if word == "--":
            break
        if word.startswith("--"):
            index += word in long
            continue
        for place, letter in enumerate(word[1:], start=2):
            letters.add(letter)
            if letter in short:
                index += place == len(word)  # the value is the next word, unless it is glued
                break
    return index, letters


def program(words):
    """The words of a simple command from the program on: the shell's own words, assignments and the
    wrappers skipped. Nothing for `command -v`, which only says where the program is."""
    index = 0
    while index < len(words):
        base = os.path.basename(words[index])
        if words[index] in KEYWORDS or ASSIGNMENT.match(words[index]):
            index += 1
        elif base in WRAPPERS:
            short, long, own = WRAPPERS[base]
            index, letters = options(words, index + 1, short, long)
            if base == "command" and letters & {"v", "V"}:
                return []
            index += own
        else:
            break
    return words[index:]


class Variables:
    """The variables a command line assigns, each with the values it can hold (a `for` gives several)."""

    def __init__(self):
        self.held = {}

    def values(self, word):
        """The values a word can stand for; None for one the command does not tell (a variable of the
        session, a substitution)."""
        match = VARIABLE.fullmatch(word)
        if match:
            values = self.held.get(match.group(1) or match.group(2))
            if values is None and match.group(3):
                return self.values(match.group(3))
            return values or [None]
        return [None if "$" in word or "`" in word else word]

    def run(self, words):
        """Take what a simple command assigns; True when that is all it does."""
        while words and words[0] in KEYWORDS:
            words = words[1:]
        if not words:
            return True
        pairs = []
        for word in words[1:] if words[0] in DECLARES else words:
            match = ASSIGNMENT.fullmatch(word)
            if not match:
                break
            pairs.append(match.groups())
        else:
            for name, value in pairs:
                self.held[name] = self.values(value)
            return True
        if words[0] == "for" and words[2:3] == ["in"]:
            self.held[words[1]] = [value for word in words[3:] for value in self.values(word)]
        for word in words[words.index("read"):] if "read" in words else []:
            self.held.pop(word, None)
        return False


def client_words(words, variables):
    """The words of a simple command from the client on, or nothing: the client by its name or path,
    held in a variable, or behind an interpreter with its options."""
    words = program(words)
    for _ in range(2):
        if not words:
            return []
        base = os.path.basename(words[0])
        if base == "notion":
            return words
        known = variables.values(words[0])[0] if VARIABLE.fullmatch(words[0]) else None
        if known:
            words = program(known.split() + words[1:])
            base = os.path.basename(words[0]) if words else ""
        if base in SHELLS or PYTHON.fullmatch(base):
            index, letters = options(words, 1, *(SHELL_OPTIONS if base in SHELLS else PYTHON_OPTIONS))
            words = [] if letters & {"c", "m"} else words[index:]
    return words if words and os.path.basename(words[0]) == "notion" else []


class Call:
    """One call of the client: its verb, and for an `update` the pages it names (None: one it names by
    something the command does not tell) and whether it replaces their whole body."""

    def __init__(self, words, variables, whole):
        self.verb, self.refs, self.replaces, self.whole = words[1], [], False, whole
        if self.verb == "update":
            ref, flags = update_arguments(words[2:])
            values = variables.values(ref) if ref else [None]
            self.refs = [None if value is None or value.startswith("-") else value for value in values]
            self.replaces = "--replace-file" in flags


def client_calls(command):
    """The calls of the cdv-notion client in a command line, in order."""
    found, variables = [], Variables()
    for one, whole in every_command(command):
        if not one.words or variables.run(one.words):
            continue
        words = client_words(one.words, variables)
        if len(words) >= 2:
            found.append(Call(words, variables, whole))
    return found


def update_flag(word):
    """The flag of `update` a word is, also cut short as argparse accepts it; None when it is none."""
    name = word.partition("=")[0]
    found = [name] if name in UPDATE_FLAGS else [flag for flag in UPDATE_FLAGS if flag.startswith(name)]
    return found[0] if len(found) == 1 else None


def update_arguments(arguments):
    """(the word that is the page of an `update` or None, its flags); the value of a flag is neither."""
    ref, flags, index = None, set(), 0
    while index < len(arguments):
        word = arguments[index]
        index += 1
        if word.startswith("--"):
            flag = update_flag(word)
            flags.add(flag)
            index += 0 if "=" in word else UPDATE_FLAGS.get(flag, 0)
        else:
            ref = ref or word
    return ref, flags


def is_notion_page(url):
    host = re.sub(r"^https?://(?:[^/@]*@)?([^/:?#]*).*$", r"\1", url, flags=re.S)
    return bool(NOTION_HOST.fullmatch(host) and UUID.search(url))


def written_lines(output):
    """[(verb, url)] of the client's write lines in the call's output."""
    found = [(match.group(1), match.group(2).rstrip(".;:,")) for match in WRITE_LINE.finditer(output or "")]
    return [(verb, url) for verb, url in found if is_notion_page(url)]


def pages_in_doubt(text):
    """The pages of the writes the client reports as in doubt."""
    found = []
    for line in IN_DOUBT.findall(text or ""):
        found += [match.group(1) for match in PAGE_PATH.finditer(line)]
        found += [url for url in PLACE_COMMAND.findall(line) if is_notion_page(url)]
    return found


def bash_targets(command, output, code, errors=""):
    """[(ref, the checker's flags)] of the pages the client wrote, and whether it fetched a page.

    The pages are those of the client's own write lines, wherever they sit in the output, and, on a call
    that ended well or exited 4 (done in part), those the client's `update` calls name, as far as the
    command can be read. The page a message names as written (`done in part on <url>`) is one too, whatever
    the call's exit code. Messages are said on stderr (`errors` when the call succeeded). One page may come
    under several names: main() checks it once."""
    try:
        calls = client_calls(command)
    except (IndexError, RecursionError):  # a command nested past reading: the output still names its pages
        calls = []
    lines = written_lines(output)
    said = f"{output}\n{errors}"
    pages = [url for _, url in lines] + pages_in_doubt(said) + [url for url in DONE_ON.findall(said) if is_notion_page(url)]
    created = {hyphenated(url) for verb, url in lines if verb == "created"}
    flags = replaced_flags(calls, {hyphenated(page) for page in pages}, created)
    # a loop that failed does not tell which of its pages it reached: the output does
    for call in calls if code == 0 else [call for call in calls if code == 4 and len(call.refs) == 1]:
        pages += [ref for ref in call.refs if ref]
    return [(page, flags) for page in pages], whole_fetch(command, calls)


def replaced_flags(calls, shown_pages, created):
    """What tells the checker which page had its whole body replaced, and that page only.

    A call that names its page is paired with it by the page itself: the checker compares the page it
    read with the one named. A replace whose page the command does not tell (or a command whose reading
    is not whole) can be paired with no call: the page takes it when the command holds one write of the
    client and it is the only page shown as written; with more than one write (the page shown may be the
    other one's) or several pages, none takes it. A card left unmarked by mistake costs one judgement; a
    card marked by mistake gets someone else's card rewritten."""
    flags = [word for call in calls if call.replaces and call.whole for ref in call.refs if ref
             for word in ("--body-replaced-of", ref)]
    unpaired = [call for call in calls if call.replaces and (not call.whole or None in call.refs)]
    writes = [call for call in calls if call.verb in ("update", "create")]
    if unpaired and len(shown_pages) <= 1 and not shown_pages & created and len(writes) == 1:
        flags.append("--body-replaced")
    return flags


def whole_fetch(command, calls):
    """True when the call's output is the output of one `fetch` and nothing else: the fetch is the last
    command, with nothing piped or redirected, and each command before it is a `cd` or an assignment."""
    if [call.verb for call in calls] != ["fetch"] or not calls[0].whole:
        return False
    *before, last = read_commands(command)[0]
    variables = Variables()
    for one in before:
        variables.run(one.words)
        silent = one.words[:1] == ["cd"] and "-" not in one.words or all(map(ASSIGNMENT.fullmatch, one.words))
        if not (silent and one.words and one.after in (";", "\n", "&&")):
            return False
    return not last.redirected and last.after in ("", ";", "\n") and last.words[0] not in KEYWORDS \
        and bool(client_words(last.words, variables))


def connector_targets(tool, tool_input, response):
    targets = []
    if tool.endswith("notion-update-page"):
        page = tool_input.get("page_id")
        if isinstance(page, str) and page.strip():
            replaced = tool_input.get("command") == "replace_content"
            targets.append((page.strip(), ["--body-replaced"] if replaced else []))
        return targets
    parent = json.dumps(tool_input.get("parent"))
    excluded = {hyphenated(m.group(0)) for m in UUID.finditer(parent)}
    seen = set()
    blob = response if isinstance(response, str) else json.dumps(response)
    for url in URL.findall(blob):
        identifier = hyphenated(url)
        if identifier and identifier not in excluded and identifier not in seen:
            seen.add(identifier)
            targets.append((url, []))
    for match in UUID.finditer(blob):
        identifier = hyphenated(match.group(0))
        if identifier not in excluded and identifier not in seen:
            seen.add(identifier)
            targets.append((identifier, []))
    return targets


def output_of(event):
    """(exit code or None, the text the call printed, its stderr): on PostToolUse the call's stdout and
    stderr, after a failure the host's `error` text, which starts `Exit code <n>` and holds both."""
    if "error" in event and event.get("hook_event_name") != "PostToolUse":
        error = str(event.get("error") or "")
        match = re.match(r"\s*Exit code (\d+)", error)
        return (int(match.group(1)) if match else None), error, ""
    response = event.get("tool_response")
    if isinstance(response, dict):
        return 0, str(response.get("stdout") or ""), str(response.get("stderr") or "")
    return 0, str(response or ""), ""


# ---------------------------------------------------------------------------------------------
# Session state, under the client's cache directory
# ---------------------------------------------------------------------------------------------


class Session:
    def __init__(self, root, session_id):
        safe = re.sub(r"[^A-Za-z0-9._-]", "_", session_id or "no-session")[:120]
        self.path = root / "sessions" / f"{safe}.json"
        try:
            self.data = json.loads(self.path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            self.data = {}
        self.data.setdefault("fails", {})   # page id (the reference while it is not known) -> failed checks in a row
        self.data.setdefault("silent", [])  # page ids
        self.data.setdefault("pages", {})   # key -> page id, as the checker read it

    def save(self):
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            scratch = self.path.with_name(f".{self.path.name}.{os.getpid()}.tmp")
            scratch.write_text(json.dumps(self.data), encoding="utf-8")
            os.replace(scratch, self.path)
        except OSError:
            pass


def claim(root, tool_use_id):
    """True for the first entry of the hook that fires for this tool call."""
    if not tool_use_id:
        return True
    folder = root / "claims"
    try:
        folder.mkdir(parents=True, exist_ok=True, mode=0o700)
        handle = os.open(str(folder / re.sub(r"[^A-Za-z0-9._-]", "_", tool_use_id)[:120]),
                         os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(handle)
        return True
    except FileExistsError:
        return False
    except OSError:
        return True


def budget():
    try:
        wanted = float(os.environ.get("CARD_CHECK_BUDGET") or BUDGET_SECONDS)
    except ValueError:
        wanted = BUDGET_SECONDS
    return max(0.0, min(wanted, BUDGET_SECONDS))


TIMED_OUT = "timed out"
PAGE_READ = re.compile(r"page: (\S+)(?: (\S+))?(?:\n|$)")


def check(ref, flags, timeout=CHECK_TIMEOUT):
    """(exit code, the findings, the id of the page read, its key) of `card_contract.py check`."""
    argv = [sys.executable, str(checker_path()), "check", "--page-id", ref, *flags]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return TIMED_OUT, "", None, None
    except OSError:
        return None, "", None, None
    read = PAGE_READ.match(proc.stdout)
    text = proc.stdout[read.end():] if read else proc.stdout
    return proc.returncode, text.strip(), read and read.group(1), read and read.group(2)


NO_TOKEN = ("card-check: cards are not being checked on this machine: the cdv-notion client has no usable Notion "
            "token. Run `notion auth login` in a terminal (the cdv-notion skill, references/setup.md, says where "
            "the token comes from).")


def main():
    event = h.read_event()
    if not event:
        return SILENT, ""
    tool = str(event.get("tool_name") or "")
    tool_input = event.get("tool_input") if isinstance(event.get("tool_input"), dict) else {}
    code, output, errors = output_of(event)
    fetched = False
    if tool == "Bash":
        command = tool_input.get("command")
        if not isinstance(command, str) or not NAMES_CLIENT.search(command):
            return SILENT, ""
        targets, fetched = bash_targets(command, output, code, errors)
        fetched = fetched and code == 0
    elif CONNECTOR.match(tool):
        if code != 0:
            return SILENT, ""
        targets = connector_targets(tool, tool_input, event.get("tool_response"))
    else:
        return SILENT, ""
    if not targets and not fetched:
        return SILENT, ""
    if not checker_path().is_file() or not client_path().is_file():
        return SILENT, ""
    checker = load_checker()
    root = Path(checker.client().cache_dir()) / "card-check"
    if not claim(root, str(event.get("tool_use_id") or "")):
        return SILENT, ""
    if fetched:
        try:
            checker.pin_from_fetch_output(output)
        except Exception:
            pass
    session = Session(root, str(event.get("session_id") or ""))
    said, seen, limit = [], set(), budget()
    silent, pages = session.data["silent"], session.data["pages"]
    late = {"id": 0, "key": 0}  # pages not checked, by what names them
    for ref, flags in targets:
        # One page is one page whatever names it: its id, which a url holds, the session knows for a key
        # it has seen, and the checker says once it has read the page.
        named = named_page(checker, ref)
        key = named or pages.get(ref.strip().upper()) or ref.strip().upper()
        if key in seen or key in silent:
            continue
        seen.add(key)
        if session.data.get("no_token"):
            break
        left = limit - (time.monotonic() - STARTED)
        result = TIMED_OUT
        if left >= MIN_CHECK_SECONDS:
            result, text, read, read_key = check(ref, flags, min(CHECK_TIMEOUT, left))
        if result == TIMED_OUT:
            late["id" if named else "key"] += 1
            continue
        if read:
            if read_key:
                pages[read_key.upper()] = read
            if read != key and (read in seen or read in silent):
                continue
            seen.add(read)
            key = read
        if result == 3:
            session.data["no_token"] = True
            said.append(NO_TOKEN)
            break
        if result == 1 and text:
            fails = session.data["fails"].get(key, 0) + 1
            session.data["fails"][key] = fails
            message = f"card-check: {shown(ref)} is outside the card contract (card_contract.py check {ref}):\n{text}"
            if fails >= LOOP_LIMIT:
                session.data["silent"].append(key)
                message += (f"\ncard-check: {shown(ref)} failed {fails} checks in a row in this session; the card is "
                            "still outside the contract, and the developer decides what to do with it. card-check "
                            "says nothing more about this page in this session.")
            said.append(message)
        elif result == 0:
            session.data["fails"].pop(key, None)
    unchecked = max(late.values())  # a page the output names by its url is the command's by its key
    if unchecked:
        said.append(f"card-check: {unchecked} more {'page' if unchecked == 1 else 'pages'} this call wrote "
                    f"{'was' if unchecked == 1 else 'were'} not checked inside the hook's time budget of "
                    f"{limit:g}s; run `card_contract.py check <ref>` on each.")
    session.save()
    return (SAY, "\n".join(said)) if said else (SILENT, "")


def run():
    try:
        code, message = main()
    except Exception:  # a broken hook must never stop a session
        return SILENT
    if code == SAY and message:
        print(message, file=sys.stderr)
        return SAY
    return SILENT


if __name__ == "__main__":
    sys.exit(run())
